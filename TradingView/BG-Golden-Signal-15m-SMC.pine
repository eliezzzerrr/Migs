// =====================================================================
//  BG Golden Signal 15m (SMC visuals) — TradingView Pine Script v6 (INDICATOR)
//  DUPLICATE of BG-Golden-Signal-15m.pine. The original is preserved
//  unchanged; this copy is where the LuxAlgo-style structure-line / OB-box
//  visuals get added. Computation stays 100% BG — only the drawing look is
//  borrowed (CC BY-NC-SA 4.0, © LuxAlgo; attribution retained).
//  XAUUSD-tuned variant of the BG Signals family.
//  15m-tuned variant. Validated 2026-05-26: London Tue-Fri 1400-1700 PHT, 18 trades, 72.2% WR, +21R. For 5m, use BG-Golden-Signal-5m.pine.
//  2026-06-10: input DEFAULTS synced to user's live chart — Asia OFF by default
//    (session 08:00-13:00, all DoW unticked); London 13:30-17:00 Mon-Fri.
//    NY AM/Lunch/PM, timezone (GMT+8), and box-display defaults unchanged.
//  Signal-only display. Buy/Sell labels + SL/TP lines + fill markers.
//
//  Strategy:
//    1. M5 BOS (close beyond recent fractal swing)
//    2. OB = last opposite-color candle before BOS impulse
//    3. HTF (1H) bias agreement required
//    4. Chop filter: strict H1 + ADX + BOS conflict + ATR squeeze
//    5. Entry near OB (≤ ATR proximity)
//    6. SL beyond OB ± buffer → defines 1R
//    7. TP1/TP2/TP3 = entry ± 1R/2R/3R. TP2 and TP3 are optional via inputs;
//       the highest enabled TP becomes the final exit (or rides past TP3 if
//       i_move_tp2 is enabled).
//    8. Optional SL trail chain: TP1→BE, TP2→TP1, TP3→TP2 (each independent).
//
//  Multi-position:
//    `i_max_positions` controls how many concurrent sim trades the script
//    will hold open. When > 1, each fresh setup that passes filters opens
//    its own trade; aggregate stats (count, R, WR) accumulate across all.
//    2nd+ positions require a distinct OB and must stack in the same
//    direction (no simultaneous long+short).
//    Visualization follows the MOST RECENTLY OPENED active trade only —
//    older trades remain on the chart as their entry labels but their live
//    SL/TP lines aren't tracked.
// =====================================================================
//@version=6

indicator("BG Golden Signal 15m SMC",
     overlay              = true,
     max_lines_count      = 500,
     max_labels_count     = 500,
     max_boxes_count      = 500)

// =====================================================================
// INPUTS
// =====================================================================
g_struct    = "Structure Detection"
i_swing_len = input.int(1,    "Swing pivot strength (bars L/R)", minval=1, group=g_struct,
     tooltip="Bars needed on each side of a pivot to confirm it. Suggested by TF: 1m=3, 5m=2, 15m=2, 30m=2, 1H=2. Higher = fewer / cleaner swings. Lower = more sensitive (noisy on fast TFs).")
i_bos_age   = input.int(20,   "Max BOS age (bars)",              minval=1, group=g_struct,
     tooltip="How long a BOS stays \"active\" for setup hunting. Suggested by TF: 1m=150, 5m=30, 15m=20, 30m=15, 1H=10.")
i_ob_age    = input.int(40,   "Max OB lookback (bars)",          minval=1, group=g_struct,
     tooltip="How far back to scan for the OB candle. Suggested by TF: 1m=300, 5m=60, 15m=40, 30m=30, 1H=25.")
i_entry_atr = input.float(0.4, "Entry proximity (× ATR)",        minval=0.1, step=0.1, group=g_struct,
     tooltip="How close price must retrace to the OB edge to fire. Suggested by TF: 1m=0.3, 5m=0.5, 15m=0.7, 30m=0.7, 1H=0.7. minval=0.1: 0 makes entries impossible (price can never be within 0 ATR), silently wiping every sim trade on recalc.")
i_atr_per   = input.int(14,   "ATR period",                      minval=2, group=g_struct,
     tooltip="Volatility smoothing for SL buffer and entry proximity. Suggested by TF: 1m=50, 5m=14, 15m=14, 30m=14, 1H=14.")
i_sl_buf    = input.float(0.45, "SL buffer (× ATR beyond OB)",   minval=0.0, step=0.05, group=g_struct,
     tooltip="Pads SL past the OB extreme to avoid wick stops. Suggested by TF: 1m=0.1, 5m=0.1, 15m=0.15, 30m=0.15, 1H=0.2.")
i_min_sl    = input.float(11.5, "Min SL distance ($) — clamp",   minval=0.0, step=0.5, group=g_struct,
     tooltip="CLAMP: if OB-derived SL would be tighter than this, push it out to meet the floor (trade still fires with the wider stop). 0 = disabled. Suggested for XAUUSD by TF: 1m=$5, 5m=$7, 15m=$10, 30m=$15, 1H=$25.")
i_min_sl_flt = input.float(4.0, "Min SL filter ($) — reject",     minval=0.0, step=0.5, group=g_struct,
     tooltip="FILTER: reject the trade entirely if the OB-derived SL distance is below this threshold (BEFORE the clamp is applied). 0 = disabled. Use this to skip setups whose natural OB is so small the trade would be all-spread. Different from the clamp above: filter SKIPS, clamp WIDENS. Suggested for XAUUSD by TF: 1m=$3, 5m=$5, 15m=$7, 30m=$10, 1H=$15.")

g_htf       = "HTF Bias"
i_req_h1    = input.bool(true,  "Require HTF Bias Agreement",    group=g_htf)
i_strict_bias = input.bool(false, "Strict bias (block ranging)", group=g_htf, tooltip="When Require HTF Bias Agreement is ON: OFF (default) allows a trade when HTF bias agrees OR is ranging/neutral. ON requires STRICT agreement — only longs when HTF is bullish, only shorts when HTF is bearish; ranging is blocked. Targets setups that die at the bias change. Has no effect when Require HTF Bias Agreement is OFF.")
i_h1_tf     = input.timeframe("60", "HTF timeframe",             group=g_htf)
i_h1_fast   = input.int(12, "HTF fast EMA",                       minval=1, group=g_htf)
i_h1_slow   = input.int(80, "HTF slow EMA",                       minval=1, group=g_htf)

g_sim       = "Simulated Trades"
i_sim_on    = input.bool(true,  "Track simulated trades",         group=g_sim)
i_max_pos   = input.int(1, "Max simultaneous trades",             minval=1, maxval=10, group=g_sim,
     tooltip="How many sim trades can be open concurrently. 1 = single-position (default, identical to old behavior). >1 lets fresh setups fire even while older trades are still running. Visualization follows the most recently opened active trade only. Suggested by TF: 1m=2-3, 5m=2, 15m=1-2, 30m=1, 1H=1.")
i_use_tp2   = input.bool(true,  "Enable TP2 (2R)",                group=g_sim,
     tooltip="Sets a +2R target. When TP2 is the highest enabled TP, the trade closes there for full +2R. When TP3 is also on, TP2 hit just acts as a trail trigger (no partial taken — full position rides to TP3).")
i_use_tp3   = input.bool(false, "Enable TP3 (3R)",                group=g_sim,
     tooltip="Sets a +3R target. When enabled, the trade rides to TP3 for full +3R win. Intermediate TPs (TP1, TP2) become trail triggers if their move-SL toggles are on.")
i_move_be   = input.bool(false, "Move SL → BE after TP1",         group=g_sim,
     tooltip="When TP1 fills, move SL to entry price.")
i_move_tp1  = input.bool(false, "Move SL → TP1 after TP2",        group=g_sim,
     tooltip="When TP2 fills, trail SL up to TP1 price (locks +1R). Requires TP2 enabled. Has no effect if TP2 is the final target.")
i_move_be2  = input.bool(false, "Move SL → BE after TP2",         group=g_sim,
     tooltip="When TP2 fills, move SL to entry price (break-even). Useful when you want TP2 to lock in BE instead of +1R — more room than the TP1 trail. Precedence: 'Move SL → TP1 after TP2' wins if both are checked (TP1 trail is the higher lock).")
i_move_tp2  = input.bool(false, "Move SL → TP2 after TP3",        group=g_sim,
     tooltip="When TP3 fills, trail SL up to TP2 price (locks +2R) instead of closing — lets the trade ride past TP3 until SL is hit. Requires TP3 enabled.")
i_cooldown  = input.int(2, "Cooldown bars after sim close",       minval=0, group=g_sim,
     tooltip="Bars to wait after the LAST sim trade fully closes before opening a new one. Only applies when no trades are active. Suggested by TF: 1m=30, 5m=6, 15m=4, 30m=3, 1H=2.")

g_sess         = "Killzones / Session Filter"
i_use_sessions = input.bool(true,  "Limit simulation to selected sessions", group=g_sess,
     tooltip="When ON, the sim only OPENS new trades during ticked killzones. Existing trades resolve naturally. Untick all killzones (or untick this master) to allow all hours.")
i_show_kz      = input.bool(false, "Show Killzone Boxes", inline="KZ_SHOW", group=g_sess)
i_show_kz_txt  = input.bool(true,  "Display Text",        inline="KZ_SHOW", group=g_sess)
i_kz_tz        = input.string("GMT+8", "Timezone",
     options=['America/New_York','GMT-12','GMT-11','GMT-10','GMT-9','GMT-8','GMT-7','GMT-6','GMT-5','GMT-4','GMT-3','GMT-2','GMT-1','GMT+0','GMT+1','GMT+2','GMT+3','GMT+4','GMT+5','GMT+6','GMT+7','GMT+8','GMT+9','GMT+10','GMT+11','GMT+12','GMT+13','GMT+14'],
     group=g_sess,
     tooltip="All killzone times below are interpreted in this timezone. Default GMT+8 = PHT (Philippine Time, no DST). Switch to America/New_York if you want session times entered as NY local with DST auto-handled. NOTE: the default session times below are aligned to PHT during NY summer (EDT, Mar-Nov). During NY winter (EST, Nov-Mar) the actual NY sessions land 1 hour later in PHT — adjust the times by +1 hour, or switch the timezone to America/New_York for hands-off DST.")

i_use_asia       = input.bool(true,  "", inline="ASIA",   group=g_sess)
i_asia_txt       = input.string("Asia",      "", inline="ASIA",   group=g_sess)
i_asia_sess      = input.session("0800-1300", "", inline="ASIA",  group=g_sess)
i_asia_color     = input.color(color.blue,   "", inline="ASIA",   group=g_sess)
i_asia_dow_mon   = input.bool(false, "Mon", inline="ASIA_DOW", group=g_sess,
     tooltip="Per-session day-of-week filter for the Asia killzone. Tick days when Asia is ALLOWED to open new trades; untick days when Asia should be SKIPPED. Defaults: all 7 days ticked (no restriction). Existing trades that opened on an allowed day resolve naturally even if the next bar lands on a blocked day. Weekday timezone: Asia/Manila.")
i_asia_dow_tue   = input.bool(false, "Tue", inline="ASIA_DOW", group=g_sess)
i_asia_dow_wed   = input.bool(false, "Wed", inline="ASIA_DOW", group=g_sess)
i_asia_dow_thu   = input.bool(false, "Thu", inline="ASIA_DOW", group=g_sess)
i_asia_dow_fri   = input.bool(false, "Fri", inline="ASIA_DOW", group=g_sess)
i_asia_dow_sat   = input.bool(false, "Sat", inline="ASIA_DOW", group=g_sess)
i_asia_dow_sun   = input.bool(false, "Sun", inline="ASIA_DOW", group=g_sess)

i_use_london     = input.bool(true,  "", inline="LONDON", group=g_sess)
i_london_txt     = input.string("London",    "", inline="LONDON", group=g_sess)
i_london_sess    = input.session("1330-1800", "", inline="LONDON", group=g_sess)
i_london_color   = input.color(color.red,    "", inline="LONDON", group=g_sess)
i_london_dow_mon = input.bool(false, "Mon", inline="LONDON_DOW", group=g_sess,
     tooltip="Per-session day-of-week filter for the London killzone. Tick days when London is ALLOWED to open new trades; untick days when London should be SKIPPED. Use this to block the 2 losing London weekdays while keeping the 3 profitable ones. Defaults: all 7 days ticked (no restriction). Weekday timezone: Asia/Manila.")
i_london_dow_tue = input.bool(true,  "Tue", inline="LONDON_DOW", group=g_sess)
i_london_dow_wed = input.bool(true,  "Wed", inline="LONDON_DOW", group=g_sess)
i_london_dow_thu = input.bool(true,  "Thu", inline="LONDON_DOW", group=g_sess)
i_london_dow_fri = input.bool(true,  "Fri", inline="LONDON_DOW", group=g_sess)
i_london_dow_sat = input.bool(false, "Sat", inline="LONDON_DOW", group=g_sess)
i_london_dow_sun = input.bool(false, "Sun", inline="LONDON_DOW", group=g_sess)

i_use_nyam       = input.bool(true,  "", inline="NYAM",   group=g_sess)
i_nyam_txt       = input.string("NY AM",     "", inline="NYAM",   group=g_sess)
i_nyam_sess      = input.session("2130-2300", "", inline="NYAM",  group=g_sess)
i_nyam_color     = input.color(#089981,      "", inline="NYAM",   group=g_sess)
i_nyam_dow_mon   = input.bool(false, "Mon", inline="NYAM_DOW", group=g_sess,
     tooltip="Per-session day-of-week filter for the NY AM killzone. Same semantics as the Asia/London filters: tick days when NY AM is ALLOWED to open new trades. Defaults: all 7 days ticked. Weekday timezone: Asia/Manila.")
i_nyam_dow_tue   = input.bool(false, "Tue", inline="NYAM_DOW", group=g_sess)
i_nyam_dow_wed   = input.bool(false, "Wed", inline="NYAM_DOW", group=g_sess)
i_nyam_dow_thu   = input.bool(false, "Thu", inline="NYAM_DOW", group=g_sess)
i_nyam_dow_fri   = input.bool(false, "Fri", inline="NYAM_DOW", group=g_sess)
i_nyam_dow_sat   = input.bool(false, "Sat", inline="NYAM_DOW", group=g_sess)
i_nyam_dow_sun   = input.bool(false, "Sun", inline="NYAM_DOW", group=g_sess)

i_use_nylu       = input.bool(true,  "", inline="NYLU",   group=g_sess)
i_nylu_txt       = input.string("NY Lunch",  "", inline="NYLU",   group=g_sess)
i_nylu_sess      = input.session("0000-0100", "", inline="NYLU",  group=g_sess)
i_nylu_color     = input.color(color.yellow, "", inline="NYLU",   group=g_sess)
i_nylu_dow_mon   = input.bool(false, "Mon", inline="NYLU_DOW", group=g_sess,
     tooltip="Per-session day-of-week filter for the NY Lunch killzone. Same semantics as the Asia/London filters. Defaults: all 7 days ticked. Weekday timezone: Asia/Manila.")
i_nylu_dow_tue   = input.bool(false, "Tue", inline="NYLU_DOW", group=g_sess)
i_nylu_dow_wed   = input.bool(false, "Wed", inline="NYLU_DOW", group=g_sess)
i_nylu_dow_thu   = input.bool(false, "Thu", inline="NYLU_DOW", group=g_sess)
i_nylu_dow_fri   = input.bool(false, "Fri", inline="NYLU_DOW", group=g_sess)
i_nylu_dow_sat   = input.bool(false, "Sat", inline="NYLU_DOW", group=g_sess)
i_nylu_dow_sun   = input.bool(false, "Sun", inline="NYLU_DOW", group=g_sess)

i_use_nypm       = input.bool(true,  "", inline="NYPM",   group=g_sess)
i_nypm_txt       = input.string("NY PM",     "", inline="NYPM",   group=g_sess)
i_nypm_sess      = input.session("0130-0400", "", inline="NYPM",  group=g_sess)
i_nypm_color     = input.color(color.purple, "", inline="NYPM",   group=g_sess)
i_nypm_dow_mon   = input.bool(false, "Mon", inline="NYPM_DOW", group=g_sess,
     tooltip="Per-session day-of-week filter for the NY PM killzone. Same semantics as the Asia/London filters. Defaults: all 7 days ticked. Weekday timezone: Asia/Manila.")
i_nypm_dow_tue   = input.bool(false, "Tue", inline="NYPM_DOW", group=g_sess)
i_nypm_dow_wed   = input.bool(false, "Wed", inline="NYPM_DOW", group=g_sess)
i_nypm_dow_thu   = input.bool(false, "Thu", inline="NYPM_DOW", group=g_sess)
i_nypm_dow_fri   = input.bool(false, "Fri", inline="NYPM_DOW", group=g_sess)
i_nypm_dow_sat   = input.bool(false, "Sat", inline="NYPM_DOW", group=g_sess)
i_nypm_dow_sun   = input.bool(false, "Sun", inline="NYPM_DOW", group=g_sess)

i_box_trans    = input.int(80, "Box Transparency",  minval=0, maxval=100, group=g_sess)
i_text_trans   = input.int(50, "Text Transparency", minval=0, maxval=100, group=g_sess)
i_kz_max_days  = input.int(100, "Killzone history (sessions kept)", minval=1, group=g_sess,
     tooltip="How many of the most recent killzone boxes to keep on the chart, per session. Older boxes are auto-pruned.")

g_dates        = "Backtest Date Range"
i_use_curweek  = input.bool(false, "Use current week (Mon 00:00 → next Mon 00:00 PHT)", group=g_dates,
     tooltip="Tick to filter the sim to bars in the current ISO week (Asia/Manila). Self-activating — no need to tick anything else. Recomputed live, rolls every Monday midnight. Highest priority — overrides Month and custom.")
i_use_curmonth = input.bool(false, "Use current month (1st 00:00 → next 1st 00:00 PHT)", group=g_dates,
     tooltip="Tick to filter the sim to bars in the current calendar month (Asia/Manila). Self-activating. Recomputed live, rolls every 1st of the month. Overridden by 'Use current week' if that's also on.")
i_use_last7    = input.bool(false, "Last 7 days",  group=g_dates,
     tooltip="Rolling 7-day window ending now. Priority order across all filters: Week > Month > Last 7 > Last 14 > Last 30 > Last 60 > Custom. Shorter window wins when multiple are ticked.")
i_use_last14   = input.bool(false, "Last 14 days", group=g_dates,
     tooltip="Rolling 14-day window ending now.")
i_use_last30   = input.bool(true,  "Last 30 days", group=g_dates,
     tooltip="Rolling 30-day window ending now.")
i_use_last60   = input.bool(false, "Last 60 days", group=g_dates,
     tooltip="Rolling 60-day window ending now.")
i_use_dates    = input.bool(false, "Use custom Start/End range", group=g_dates,
     tooltip="Tick to activate the custom Start/End below. Ignored when Week, Month, or any Last-N-Days filter is on. Untick all to disable date filtering entirely.")
i_date_from    = input.time(timestamp("2026-05-01 00:00 +0800"), "Start (custom)", group=g_dates,
     tooltip="Effective only when 'Use custom Start/End range' is ON and all higher-priority filters (Week, Month, Last 7/14/30/60) are OFF. Default = 1st of last month (PHT). Static literal — does NOT auto-roll each month; use 'Use current month' for an auto-rolling window.")
i_date_to      = input.time(timestamp("2026-05-31 23:59 +0800"), "End (custom)",   group=g_dates,
     tooltip="Effective only when 'Use custom Start/End range' is ON and all higher-priority filters (Week, Month, Last 7/14/30/60) are OFF. Inclusive — bars at this exact timestamp qualify.")

g_cost      = "Costs / Spread"
i_spread    = input.float(0.0, "Spread ($/trade, round-trip)", step=0.1, minval=0.0, group=g_cost,
     tooltip="Deducted from each closed trade. Default 0 = current spread-blind numbers. XAUUSD typical ~2-4. Feeds the Net R / Net $ / expectancy metrics; the structural Win/Loss COUNT is unchanged.")

g_disp      = "Display"
i_show_tbl  = input.bool(true,  "Show status table",              group=g_disp)
i_tbl_pos   = input.string("top_right", "Table position",
                           options=["top_left","top_right","middle_left","middle_right","bottom_left","bottom_right"], group=g_disp)
i_lbl_off   = input.int(15, "Label offset (bars right)",          minval=1, group=g_disp)
i_show_watch = input.bool(true, "Show potential entry (WATCH state)", group=g_disp,
     tooltip="When the State is WATCH·BUY / WATCH·SELL, draw a dashed line + price label at the level the engine is waiting for (OB edge ± Entry-proximity×ATR). The setup fires when price reaches this level. Note: the trade still has to pass the Min-SL filter when it triggers.")
i_show_setup_note = input.bool(true, "Show GET READY note (SETUP state)", group=g_disp,
     tooltip="When the State reaches SETUP·BUY / SETUP·SELL — price is within Entry-proximity of the OB and every gate (session, date, cooldown, day limits, HTF bias) is green — draw ONE bold 'GET READY' label at the right edge of the chart, beside current price. This marks a signal as IMMINENT (the sim fires the moment the confirmed bar triggers). Shows the projected entry / SL / TP2 from the same watch_* levels the WATCH line uses. Live-only (tracks the last bar); never paints historical SETUP bars.")
i_ready_release = input.float(0.8, "GET READY release (× ATR)", minval=0.4, step=0.1, group=g_disp,
     tooltip="DISPLAY-ONLY hysteresis (does NOT touch the 0.4-ATR firing engine). The GET READY label SHOWS the instant price enters Entry-proximity of the OB (the real SETUP/ADD-ready condition). Once shown, it does NOT vanish the moment price ticks back outside that band — instead it HOLDS (dimmed, '(near)' appended) until price drifts farther than this multiple of ATR from the OB edge, OR the setup hard-dies (OB aged/replaced, killzone closed, slot taken, trade fired, BOS gone). Must be ≥ the Entry-proximity (0.4). Larger = stickier label / fewer flickers; the imminent-approach alert still fires only once per genuine approach and re-arms only after a full HIDE.")
i_preopen_mins = input.int(15, "GET READY pre-open lookahead (min)", minval=0, maxval=60, group=g_disp,
     tooltip="DISPLAY-ONLY look-ahead for the GET READY label. When the candidate setup is fully formed (BOS active, OB anchored, price in proximity, HTF ok, date/cooldown/day gates green) and the ONLY failing gate is the killzone — because the next ENABLED killzone with a passing day-of-week filter opens within this many minutes — the GET READY label appears early, suffixed e.g. '(London opens in 3m)'. The minute count updates live and the label transitions to the normal live SETUP state the instant the session actually opens. 0 disables the pre-open look-ahead (label only shows once price is genuinely in a killzone, as before). Computed chart-side from the killzone session strings + DoW filters + Timezone — the firing engine is untouched.")
i_show_breakdown = input.bool(true, "Show session/weekday R breakdown", group=g_disp,
     tooltip="Optional panel attributing realized R and trade count to the session and the weekday each trade OPENED in (data-driven from the sim itself, no priors). Σ(session R)=Σ(weekday R)=gross Total R. Default OFF.")
i_bd_pos    = input.string("bottom_left", "Breakdown panel position",
                           options=["top_left","top_right","middle_left","middle_right","bottom_left","bottom_right"], group=g_disp)
i_near_tp2  = input.float(1.8, "Near-miss threshold (R)", minval=1.0, maxval=2.0, step=0.05, group=g_disp,
     tooltip="DISPLAY-ONLY (does NOT affect the trade engine). In the PERFORMANCE band's outcome-anatomy rows, a losing trade whose per-trade MFE reached at least this many R is classified as a 'near TP2' loss (came within a hair of the +2R target, then reversed to SL). Losses with MFE between 1.0R and this threshold are 'after TP1'; below 1.0R are 'straight to SL'. Raise toward 2.0 to count only the closest misses; lower toward 1.0 to be more generous.")
i_show_sess = input.bool(true, "Show session stats", group=g_disp,
     tooltip="DISPLAY-ONLY. Adds the SESSIONS band to the status table (between PERFORMANCE and STREAKS): entry-quality WR per killzone (Asia/London/NY, NY*=AM|Lunch|PM merged), resolution-path breakdown (where Asia/London/NY entries CLOSE — same PHT day vs later/off), avg hold split by win/loss, same-session-close rate, and overnight-carry rate. When OFF the whole band is hidden and occupies no table rows.")
i_show_dow  = input.bool(false, "Show day-of-week stats", group=g_disp,
     tooltip="DISPLAY-ONLY. Adds 5 Mon–Fri rows (by ENTRY day, PHT) to the SESSIONS band showing W/L and win-rate. Requires 'Show session stats' ON. When OFF the rows are hidden and occupy no table space.")

g_sug       = "Tuning Suggestions"
i_show_sug  = input.bool(false,  "Show tuning suggestions panel",  group=g_sug,
     tooltip="Shows a live comparison of your current settings vs. suggested values for the chosen Signal TF. Cells turn orange when your value differs from the suggestion, green when they match. Updates whenever you change Signal timeframe.")
i_sug_pos   = input.string("bottom_right", "Suggestions panel position",
                           options=["top_left","top_right","middle_left","middle_right","bottom_left","bottom_right"], group=g_sug)

g_colors    = "Colors"
i_col_buy   = input.color(color.new(#26a69a, 0),  "Buy / TP accent",  group=g_colors)
i_col_sell  = input.color(color.new(#ef5350, 0),  "Sell / SL accent", group=g_colors)
i_col_be    = input.color(color.new(#26c6da, 0),  "SL → BE color",    group=g_colors)
i_col_text  = input.color(color.white, "Label text",                 group=g_colors)

g_alert     = "Alerts"
i_alerts_on   = input.bool(true,  "Enable alerts", group=g_alert,
     tooltip="Fires via the alert() function. In TradingView, create ONE alert on this indicator with condition 'Any alert() function call' — it will deliver all the event types ticked below. Works on the free tier (1 alert).")
i_alert_entry = input.bool(true,  "Alert on SETUP entry", group=g_alert,
     tooltip="Fires the moment a trade opens (confirmed bar = the system's actual entry). This is the 'enter now, don't be late' alert.")
i_alert_watch = input.bool(false, "Alert on WATCH (approaching)", group=g_alert,
     tooltip="Heads-up when a setup is forming and price is nearing the trigger level. May not lead to an entry.")
i_alert_setup = input.bool(false, "Alert on SETUP (signal imminent)", group=g_alert,
     tooltip="Fires ONCE when the State transitions into SETUP·BUY / SETUP·SELL — price has reached Entry-proximity of the OB with all gates green and the sim is about to trigger. One bar later than WATCH, one bar earlier than the entry fill. Transition-gated (not every bar it holds).")
i_alert_exit  = input.bool(false, "Alert on TP / SL hit", group=g_alert,
     tooltip="Notifies when an open trade hits a take-profit or stop.")

g_acct      = "Account / Lot Sizing"
i_lot       = input.float(0.01, "Lot size", step=0.01, minval=0.0, group=g_acct,
     tooltip="Position size in lots. XAUUSD standard contract = 100 oz/lot, so 0.01 lot = $1 per 1.0 price-point move. Total $ / Day $ / Max DD scale with this.")
i_contract  = input.float(100.0, "Contract size ($ per 1.0 point per 1.0 lot)", step=1.0, minval=0.0, group=g_acct,
     tooltip="Dollar value of a 1.0 price move for a 1.0 lot. XAUUSD = 100 (100 oz/lot). Change only if your broker's gold contract differs.")

// =====================================================================
// SMC VISUALS (LuxAlgo-style, BG-driven)
// Drawing STYLE only is adapted from "Smart Money Concepts [LuxAlgo]"
// (© LuxAlgo, CC BY-NC-SA 4.0 — https://creativecommons.org/licenses/by-nc-sa/4.0/).
// NONE of LuxAlgo's detection logic is used: every line / label / box
// below is driven entirely by levels BG already computes on the chart
// timeframe (last_sh / last_sl swing pivots, BOS events, and the BG OB).
// All toggles default OFF so the +58R config looks unchanged out of box.
// =====================================================================
g_smc          = "SMC Visuals (LuxAlgo-style, BG-driven)"
i_smc_on       = input.bool(false, "Enable SMC visuals (master)", group=g_smc,
     tooltip="Master switch. When OFF (default) nothing in this group draws — the chart is identical to the original +58R config. Tick to enable structure lines and/or OB boxes below.")
i_smc_struct   = input.bool(false, "Show structure lines + BOS/CHoCH labels", group=g_smc,
     tooltip="On every BG BOS event, draws a LuxAlgo-style horizontal structure line at the broken swing (from the swing's bar to the break bar) plus a BOS / CHoCH label at the line midpoint. CHoCH = the break flips the prior structural bias. Requires the master toggle.")
i_smc_obbox    = input.bool(false, "Show order-block boxes", group=g_smc,
     tooltip="Draws a LuxAlgo-style colored zone box from BG's order block (formed on a BOS), extending right until price mitigates it. Tinted bull/bear per the OB type. Requires the master toggle.")
i_smc_keep_ln  = input.int(20, "Structure lines kept (prune oldest)", minval=1, maxval=400, group=g_smc,
     tooltip="Most-recent structure lines (and their labels) to keep. Older ones are deleted FIFO so the script never approaches the 500 line/label caps shared with the SL/TP lines and signal chips.")
i_smc_keep_lbl = input.int(20, "Structure labels kept (prune oldest)", minval=1, maxval=400, group=g_smc,
     tooltip="Most-recent BOS/CHoCH labels to keep. Usually equal to the line keep-count.")
i_smc_keep_box = input.int(6, "OB boxes kept (prune oldest)", minval=1, maxval=200, group=g_smc,
     tooltip="Most-recent OB boxes to keep. Pruned FIFO. Keep this modest: killzone boxes also draw from the shared 500-box budget. Default lowered to 6 so the chart is less busy out of the box; raise if you want more history.")
i_smc_ob_dir   = input.string("Both", "OB direction filter", options=["Both","Demand only","Supply only"], group=g_smc,
     tooltip="NOISE FILTER. Restrict which OB boxes draw by bias. 'Demand only' keeps bullish (demand) OBs and skips supply; 'Supply only' does the reverse; 'Both' (default) draws everything. Only affects OB boxes, never the signal/sim math.")
i_smc_ob_bias_only = input.bool(false, "OB: HTF-bias-aligned only", group=g_smc,
     tooltip="NOISE FILTER. When ON, only draw an OB box whose bias agrees with the CURRENT HTF (1H) bias at formation: demand OB only while H1 is bullish, supply OB only while H1 is bearish. Drops counter-trend OBs. Reuses the same h1_bull/h1_bear the engine already computes. Off by default.")
i_smc_ob_min_atr = input.float(0.0, "OB: min size (× ATR)", minval=0.0, step=0.1, group=g_smc,
     tooltip="NOISE FILTER. When > 0, skip drawing an OB box whose height (high − low) is smaller than this multiple of ATR at formation. Drops tiny/noisy boxes. 0 (default) = no size filter. Reuses the engine ATR; no extra series added.")
i_smc_ob_extend_bars = input.int(0, "OB: cap right-extension (bars, 0=full)", minval=0, group=g_smc,
     tooltip="When 0 (default) each OB box extends right across the chart until mitigated (current behavior). When > 0, cap the box's right edge to this many bars from its origin so old boxes don't span the whole screen. Mitigation still deletes the box early if price trades back through it.")
i_smc_ob_active_only = input.bool(false, "OB: active-BOS only (prune aged)", group=g_smc,
     tooltip="NOISE FILTER. When ON, an OB box is deleted once its originating BOS ages out (older than 'Max BOS age' bars), so only OBs from still-active structure remain. Off by default (boxes persist until mitigated or FIFO-pruned).")
i_smc_ob_trans = input.int(80, "OB box transparency", minval=0, maxval=100, group=g_smc,
     tooltip="Transparency of the OB box fill (LuxAlgo default ~80). 0 = opaque, 100 = invisible. An OB that has produced a trade is recolored BLUE (same transparency) for the rest of its life — see the SAME-OB rule.")
i_smc_col_bull = input.color(color.new(#26a69a, 0), "Structure/OB bull color (override)", group=g_smc,
     tooltip="Color for bullish structure lines/labels and demand OB boxes. Defaults to the Buy accent; change to override independently of the signal colors.")
i_smc_col_bear = input.color(color.new(#ef5350, 0), "Structure/OB bear color (override)", group=g_smc,
     tooltip="Color for bearish structure lines/labels and supply OB boxes. Defaults to the Sell accent.")

// =====================================================================
// RISK CONTROLS & STRATEGY EXPERIMENTS
// Four independent controls, each defaulting to OFF/0 so the sim output is
// byte-identical to the +58R baseline until a control is explicitly enabled.
//   1) Max trades/day      — caps NEW opens per PHT day.
//   2) Daily loss stop (R) — halts NEW opens once today's realized R sinks.
//   3) Bias-flip exit      — react when 1H bias turns against an open trade.
//   4) Size-gated BOS      — require breakouts to clear the swing by ×ATR.
// =====================================================================
g_risk = "Risk Controls & Strategy Experiments"
i_max_day_trades = input.int(0, "Max trades per day (0 = off)", minval=0, group=g_risk,
     tooltip="Stop OPENING new trades once this many have opened today (PHT). Existing trades resolve normally. 0 = disabled.")
i_max_day_loss_r = input.float(0.0, "Daily loss stop (R, 0 = off)", step=0.5, minval=0.0, group=g_risk,
     tooltip="Stop OPENING new trades once today's realized R ≤ −this value (PHT). Open trades still resolve. 0 = disabled.")
i_exit_on_flip = input.bool(false, "Exit on HTF bias flip", group=g_risk,
     tooltip="When the 1H bias flips OPPOSITE an open trade, act on it instead of riding to the full stop. Targets the 'stopped at the bias change' loss. Off = current behavior.")
i_flip_action = input.string("Move to BE", "…on flip, action", options=["Move to BE","Close at market"], group=g_risk,
     tooltip="Move to BE: pull the stop to entry (only if that tightens it) and let the engine close it normally. Close at market: exit now at the current price.")
i_bos_min_atr = input.float(0.0, "Min BOS size (×ATR, 0 = off)", step=0.1, minval=0.0, group=g_risk,
     tooltip="Require the breakout close to clear the swing by at least this ×ATR before it counts as a BOS. Stops tiny wick-breaks from flipping structure and cancelling setups. 0 = disabled.")

// =====================================================================
// TRADE UDT — per-position state. Held in array<Trade> inside the sig-TF
// function so multiple trades can run concurrently. Reference-typed:
// modifying a Trade fetched via array.get mutates the stored instance.
// =====================================================================
type Trade
    bool   is_long       = false
    float  entry         = na
    float  sl            = na
    float  tp1           = na
    float  tp2           = na
    float  tp3           = na
    float  eff_sl        = na
    float  eff_sl_r      = na
    bool   tp1_done      = false
    bool   tp2_done      = false
    bool   tp3_done      = false
    // Outcome-anatomy flag (display-only): set when, AFTER TP1 filled, the
    // bar's H/L retraced all the way back to entry (BE) before the trade
    // went on to a TP2 win. Booked into n_win_tp1_be_tp2 at close.
    bool   be_dip_after_tp1 = false
    int    open_bar      = 0
    int    open_time     = na
    int    open_day      = 0
    int    open_month    = 0
    // OB origin bar this position opened from. Used by the one-position-per-OB
    // gate so a 2nd/3rd concurrent trade can't re-enter the same order block.
    int    ob_bar        = na
    string bias_at_open  = "ranging"
    float  mfe_r         = 0.0
    float  mae_r         = 0.0
    // Session/weekday attribution captured AT OPEN (for the R-breakdown panel).
    // open_sess_idx: 0=Asia,1=London,2=NYAM,3=NYLU,4=NYPM, -1=other/none.
    // open_dow: raw Pine dayofweek (1=Sun..7=Sat) at the open bar, Asia/Manila.
    int    open_sess_idx = -1
    int    open_dow      = 0
    // SESSIONS-band attribution captured AT OPEN (display-only).
    // open_sess_bucket: which killzone permitted the entry, NY* merged:
    //   0=Asia, 1=London, 2=NY (NYAM|NYLU|NYPM), -1=off (sessions disabled).
    //   Derived from open_sess_idx (the engine's in-session idx at entry) —
    //   NOT recomputed from session membership.
    // open_pht_date: PHT calendar-date key (y*10000+m*100+d, Asia/Manila) at
    //   the open bar, for same-day close detection in the resolution paths.
    int    open_sess_bucket = -1
    int    open_pht_date    = na

// =====================================================================
// SIGNAL-STATE UDT — bundles everything compute_sig_state() returns
// across the request.security boundary. Includes:
//   • Setup flags (bull_setup / bear_setup / forming)
//   • Displayed trade fields (most recently opened active trade)
//   • Aggregate sim stats
//   • Per-bar EVENT flags (open/TP/close) — used by chart-side drawings
//     instead of bar-transition detection, which doesn't work when N>1
//     trades can be active simultaneously.
// =====================================================================
type SigState
    // Setup detection
    bool   bull_setup    = false
    bool   bear_setup    = false
    bool   bull_forming  = false
    bool   bear_forming  = false
    // Potential-entry level the engine is WAITING for while in WATCH state
    // (OB edge ± Entry-proximity×ATR). watch_dir: +1 buy, -1 sell, 0 none.
    float  watch_entry_px = na
    int    watch_dir      = 0
    float  watch_sl_px   = na
    float  watch_tp1_px  = na
    float  watch_tp2_px  = na
    // Projected entry/SL/TP2 for the SETUP state (price already in proximity,
    // so watch_* are na). Entry = current close (engine books at bar close);
    // SL/TP2 mirror the real entry block's clamp math. Display-only, na
    // outside SETUP. setup_dir: +1 buy, -1 sell, 0 none.
    float  setup_entry_px = na
    int    setup_dir      = 0
    float  setup_sl_px   = na
    float  setup_tp1_px  = na
    float  setup_tp2_px  = na
    // Displayed (latest opened active) trade
    bool   sim_long      = false
    bool   sim_short     = false
    float  sim_entry     = na
    float  sim_sl        = na
    float  sim_tp1       = na
    float  sim_tp2       = na
    float  sim_tp3       = na
    float  sim_eff_sl    = na
    float  sim_eff_sl_r  = na
    bool   sim_tp1_done  = false
    bool   sim_tp2_done  = false
    bool   sim_tp3_done  = false
    int    active_count  = 0
    // Per-slot live entries for the LIVE TRADE band's "Entry #N" rows
    // (display-only). Slot 0 = oldest open order (#1) … up to 3 shown.
    // entry price + open_time (ms) per slot; na in unused slots.
    float  slot1_entry   = na
    float  slot2_entry   = na
    float  slot3_entry   = na
    int    slot1_opentm  = na
    int    slot2_opentm  = na
    int    slot3_opentm  = na
    // Sim aggregates
    int    sim_count     = 0
    int    sim_wins      = 0
    int    sim_losses    = 0
    float  sim_total_r   = 0.0
    float  sim_total_usd = 0.0
    float  max_dd_pts    = 0.0
    // Edge / cost metrics (gross buckets + spread accrual + excursions)
    float  gross_win_r    = 0.0
    float  gross_loss_r   = 0.0
    int    max_loss_streak = 0
    int    max_win_streak  = 0
    int    cur_win_streak  = 0
    int    cur_loss_streak = 0
    float  sum_spread_r   = 0.0
    float  sum_mfe_r      = 0.0
    float  sum_mae_r      = 0.0
    // Outcome-anatomy counters (display-only). Each CLOSED trade is binned
    // into exactly one of 4 mutually-exclusive buckets at close time using
    // the existing win/loss attribution + per-trade MFE (in R). Their sum ==
    // closed_count. sum_hold_ms accrues (close bar time − open_time) per
    // closed trade for the average-hold display.
    int    n_win_tp2      = 0   // booked a WIN (TP2 final / trailed-SL win)
    int    n_loss_near    = 0   // loss, MFE_R >= i_near_tp2 (hairline miss)
    int    n_loss_aftertp1 = 0  // loss, 1.0 <= MFE_R < i_near_tp2
    int    n_loss_straight = 0  // loss, MFE_R < 1.0
    // Sub-slice of n_win_tp2: TP2 wins that dipped back to BE after TP1 first.
    int    n_win_tp1_be_tp2 = 0
    int    sum_hold_ms    = 0
    // Day aggregates (PHT open-day attribution)
    float  day_r_today      = 0.0
    float  day_usd_today    = 0.0
    int    day_wins_today   = 0
    int    day_losses_today = 0
    int    day_opens_today  = 0
    // Sim date-range coverage (first/last in-range bar time)
    int    sim_first_time   = na
    int    sim_last_time    = na
    // Distinct Manila weekdays with ≥1 in-range bar (Avg Trades/Day denom)
    int    num_trading_days = 0
    // Diagnostic
    bool   h1_bull              = false
    bool   h1_bear              = false
    string h1_bias_s            = "ranging"
    string disp_bias_at_open    = ""
    string session_now          = "off"
    // Gating flags
    bool   in_date_range = true
    bool   in_session    = true
    bool   cooldown_ok   = true
    // Diagnostic: 2nd/3rd-position skip reasons (read-only).
    string add_reason_s    = ""
    string last_add_skip_s = "—"
    // Add-ready surface (display-only): +1/-1 when add_reason == "READY (will
    // fire)" with that setup's direction, else 0. Drives the GET READY label's
    // in-trade ADD case. Bound to the SAME condition as the panel "Add #N" row.
    int    add_ready_dir   = 0
    // -- PRE-ENTRY CHECKLIST (display-only). Surfaces the engine's OWN gate
    //    evaluations on the last CONFIRMED bar, for the CANDIDATE direction
    //    (active BOS dir: bull BOS→BUY, bear BOS→SELL; 0 = no active BOS).
    //    All read-only — no engine behavior depends on them. Used by the
    //    flat LIVE-TRADE checklist to show what's missing before a fire.
    //    PACKED into a single array<float> to stay under the UDT external-
    //    element limit (each scalar field costs 2 elements; one array costs 1).
    //    Bools are stored 0.0/1.0; na-able numerics keep na. Index constants
    //    (CHK_*) below; semantics IDENTICAL to the former scalar fields. --
    //      0 cand_dir        +1 BUY, -1 SELL, 0 none (no active BOS)
    //      1 chk_killzone    in_session result (session window + DoW)
    //      2 chk_htf_ok      candidate-direction HTF agreement
    //      3 chk_bos_active  candidate-direction BOS still active
    //      4 chk_bos_age     bars since the active BOS (cand dir); na none
    //      5 chk_ob          OB anchored for the candidate dir
    //      6 chk_ob_edge     the OB edge price the engine watches; na none
    //      7 chk_price_at_ob price within Entry×ATR of the OB edge
    //      8 chk_dist_atr    distance from OB edge in ATR (>=0); na none
    //      9 chk_cooldown    cooldown elapsed (mirrors cooldown_ok)
    //     10 chk_cool_left   bars of cooldown remaining
    //     11 chk_minsl_ok    natural OB SL distance >= min-SL filter
    //     12 chk_minsl_dist  natural OB-derived SL distance ($); na none
    //     13 chk_slot_free   a position slot is available
    //     14 chk_fresh_ob    candidate OB not already held by a trade
    //     15 chk_day_trades_ok under per-day open cap (g_risk)
    //     16 chk_day_loss_ok   today's R hasn't breached loss stop
    //     17 chk_day_opens     opens today (for "Day cap 1/3")
    array<float> chk_pack = na
    // Per-bar event flags (reset each sig-TF bar; latched true if event fired)
    bool   evt_open_long      = false
    bool   evt_open_short     = false
    // OB origin bar of the trade that opened this bar (display-only; lets the
    // chart side recolor the matching OB box BLUE to mark it "used").
    int    evt_open_ob_bar    = na
    bool   evt_tp1            = false
    bool   evt_tp2            = false
    bool   evt_tp3            = false
    bool   evt_close_long_tp  = false
    bool   evt_close_long_sl  = false
    bool   evt_close_short_tp = false
    bool   evt_close_short_sl = false
    // Latest event's trail step (for SL label retext): 0=none, 1=BE, 2=TP1, 3=TP2
    int    evt_trail_step     = 0
    // -- SMC visuals (LuxAlgo-style, BG-driven). Surfaced so the chart side
    //    can draw structure lines / labels / OB boxes from BG levels. --
    bool   smc_bos_bull   = false   // a bull BOS fired this bar
    bool   smc_bos_bear   = false   // a bear BOS fired this bar
    bool   smc_choch      = false   // the BOS this bar flipped prior bias (CHoCH)
    float  smc_bos_level  = na      // broken swing level (last_sh on bull, last_sl on bear)
    int    smc_bos_from   = na      // bar index of the broken swing pivot
    bool   smc_ob_new     = false   // a new BG OB formed this bar
    bool   smc_ob_demand  = false   // OB is demand (bull) vs supply (bear)
    float  smc_ob_high    = na      // OB upper bound
    float  smc_ob_low     = na      // OB lower bound
    int    smc_ob_from    = na      // OB origin bar index
    float  smc_ob_atr     = na      // ATR at OB formation (for min-size filter)
    // -- Session / weekday R-breakdown buckets (data-driven from sim closes).
    //    Index-aligned: sess 0..4 = Asia/London/NYAM/NYLU/NYPM; dow 0..6 =
    //    Mon..Sun. Accrued in the SAME close branches as sim_total_r so
    //    Σ(r_by_sess[in-session closes]) + Σ(off-session closes) and
    //    Σ(r_by_dow) each reconcile to the gross total R. --
    array<float> r_by_sess = na
    array<int>   n_by_sess = na
    array<float> r_by_dow  = na
    array<int>   n_by_dow  = na
    // -- SESSIONS band (display-only). All accrued in the SAME close branches
    //    as wins/losses (trailed-SL eff R>=0 = WIN attribution preserved). --
    // Entry quality, indexed 0=Asia,1=London,2=NY (NY*=AM|Lunch|PM merged):
    //   entries = closed trades opened in that bucket; wins = WINs among them.
    array<int>   ent_by_bucket = na   // [3]
    array<int>   ent_wins_by_bucket = na   // [3]
    // Resolution paths, 8 buckets (every closed trade lands in exactly one):
    //   0 Asia→inAsia   1 Asia→inLondon   2 Asia→later/off
    //   3 London→inLondon 4 London→inNY    5 London→later/off
    //   6 NY→inNY        7 NY→later/off
    //   path_n = trades on the path; path_w = WINs on the path.
    array<int>   path_n = na   // [8]
    array<int>   path_w = na   // [8]
    // Hold-time split (ms + count) for wins vs losses (WIN attribution = same
    // as sim_wins, i.e. trailed-SL eff R>=0 counts as a win).
    int    hold_ms_wins   = 0
    int    hold_ms_losses = 0
    int    n_hold_wins    = 0
    int    n_hold_losses  = 0
    // Same-session-AND-same-day closes, and overnight-carry closes.
    int    n_same_sess_close = 0
    int    n_overnight       = 0
    // Day-of-week (ENTRY day, PHT) W/L, slot 0..4 = Mon..Fri.
    array<int>   dow_w = na   // [5]
    array<int>   dow_l = na   // [5]
    // -- SESSION BIAS (display-only). Per-session [Asia,London,NY] tally of the
    //    H1 bias STATE (the SAME variable the engine gates entries with) over
    //    every confirmed in-range bar whose time falls inside that session's
    //    TIME window (DoW gating ignored). Full-range running totals: --
    array<int>   sb_bull  = na   // [3]
    array<int>   sb_bear  = na   // [3]
    array<int>   sb_range = na   // [3]
    // Rolling last-10 PHT-trading-day numbers (already summed across the queue
    // at render time → surfaced as plain ints here). Per session [3].
    array<int>   sb10_bull  = na   // [3]
    array<int>   sb10_bear  = na   // [3]
    array<int>   sb10_range = na   // [3]
    int          sb10_days  = 0    // distinct PHT weekdays queued (0..10)
    // -- ENTRY BIAS SPLIT (display-only). Per-session [Asia,London,NY] closed-
    //    trade entries classified by the bias STATE at entry vs trade direction:
    //    MATCHED (long&bull|short&bear), RANGE (bias ranging), COUNTER (gate
    //    off → wrong-way). _w = WINs among them (same WIN attribution). --
    array<int>   ebs_match    = na   // [3]
    array<int>   ebs_match_w  = na   // [3]
    array<int>   ebs_range    = na   // [3]
    array<int>   ebs_range_w  = na   // [3]
    array<int>   ebs_counter  = na   // [3]
    array<int>   ebs_counter_w = na  // [3]

// Index constants for SigState.chk_pack (PRE-ENTRY CHECKLIST). Bools packed
// as 0.0/1.0; na-able numerics keep na. Order matches the doc block above.
CHK_CAND_DIR        = 0
CHK_KILLZONE        = 1
CHK_HTF_OK          = 2
CHK_BOS_ACTIVE      = 3
CHK_BOS_AGE         = 4
CHK_OB              = 5
CHK_OB_EDGE         = 6
CHK_PRICE_AT_OB     = 7
CHK_DIST_ATR        = 8
CHK_COOLDOWN        = 9
CHK_COOL_LEFT       = 10
CHK_MINSL_OK        = 11
CHK_MINSL_DIST      = 12
CHK_SLOT_FREE       = 13
CHK_FRESH_OB        = 14
CHK_DAY_TRADES_OK   = 15
CHK_DAY_LOSS_OK     = 16
CHK_DAY_OPENS       = 17

// =====================================================================
// SUGGESTIONS UDT + lookup function. Holds the per-TF starting-point
// values displayed in the tuning suggestions panel. Reading these on
// every barstate.islast tick means the panel updates live whenever the
// user changes the Signal TF input — Pine inputs can't carry dynamic
// labels themselves, so we render the comparison on-chart instead.
// =====================================================================
type Suggestions
    // Structure Detection
    int    swing_len    = 2
    int    bos_age      = 30
    int    ob_age       = 60
    float  entry_atr    = 0.5
    int    atr_per      = 14
    float  sl_buf       = 0.1
    float  min_sl       = 7.0
    float  min_sl_flt   = 5.0
    // HTF Bias
    string htf_tf       = "60"
    int    h1_fast      = 12
    int    h1_slow      = 80
    // Simulated Trades
    int    cooldown     = 6
    int    max_pos      = 2

get_suggestions(string tf) =>
    Suggestions s = Suggestions.new()
    // Defaults above match the 5m baseline. Only overrides per TF below.
    if tf == "1"
        s.swing_len  := 3
        s.bos_age    := 150
        s.ob_age     := 300
        s.entry_atr  := 0.3
        s.atr_per    := 50
        s.sl_buf     := 0.1
        s.min_sl     := 5.0
        s.min_sl_flt := 3.0
        s.htf_tf     := "15"
        s.cooldown   := 30
        s.max_pos    := 3
    else if tf == "15"
        // Tuned for XAUUSD 15m, HTF(1H) bias gate ON.
        // Restored from user's deleted +58R chart (2026-06-04):
        // Asia 0800-1200 (Mon/Tue/Fri) + London 1400-1700 (Tue-Fri).
        // 98 trades, 52W/46L, 53.1% WR, +58R on the TV sim — which is
        // SPREAD-BLIND. Confirm in the EA backtest with spread modeled
        // before trusting the +58R live.
        s.swing_len  := 1
        s.bos_age    := 20
        s.ob_age     := 40
        s.entry_atr  := 0.4
        s.sl_buf     := 0.45
        s.min_sl     := 9.0
        s.min_sl_flt := 4.0
        s.htf_tf     := "60"
        s.cooldown   := 2
        s.max_pos    := 1
    else if tf == "30"
        s.entry_atr  := 0.7
        s.bos_age    := 15
        s.ob_age     := 30
        s.sl_buf     := 0.15
        s.min_sl     := 15.0
        s.min_sl_flt := 10.0
        s.htf_tf     := "240"
        s.cooldown   := 3
        s.max_pos    := 1
    else if tf == "60"
        s.entry_atr  := 0.7
        s.bos_age    := 10
        s.ob_age     := 25
        s.sl_buf     := 0.2
        s.min_sl     := 25.0
        s.min_sl_flt := 15.0
        s.htf_tf     := "D"
        s.cooldown   := 2
        s.max_pos    := 1
    s

// =====================================================================
// KILLZONE UDT + helpers — per-session visual boxes on the chart. Each
// enabled killzone holds an array of boxes (one per past session, up to
// i_kz_max_days). The active session's box extends right and updates
// top/bottom to match the high/low seen since session start. The
// was_in_sess field tracks the previous bar's session membership so
// transitions (new session start) are detected without history refs.
// =====================================================================
type KZ
    string title       = ""
    color  base_color  = color.gray
    string session_str = ""
    array<box> boxes   = na
    bool   was_in_sess = false

initKZ() =>
    array<KZ> res = array.new<KZ>()
    if i_use_asia
        res.push(KZ.new(i_asia_txt,   i_asia_color,   i_asia_sess,   array.new<box>(), false))
    if i_use_london
        res.push(KZ.new(i_london_txt, i_london_color, i_london_sess, array.new<box>(), false))
    if i_use_nyam
        res.push(KZ.new(i_nyam_txt,   i_nyam_color,   i_nyam_sess,   array.new<box>(), false))
    if i_use_nylu
        res.push(KZ.new(i_nylu_txt,   i_nylu_color,   i_nylu_sess,   array.new<box>(), false))
    if i_use_nypm
        res.push(KZ.new(i_nypm_txt,   i_nypm_color,   i_nypm_sess,   array.new<box>(), false))
    res

var array<KZ> killzones = initKZ()

method update_kz(KZ this) =>
    in_sess = not na(time(timeframe.period, this.session_str, i_kz_tz))
    if in_sess and not this.was_in_sess
        box_c  = color.new(this.base_color, i_box_trans)
        text_c = color.new(this.base_color, i_text_trans)
        new_box = box.new(time, high, time, low,
                          xloc         = xloc.bar_time,
                          border_color = i_show_kz ? box_c : na,
                          bgcolor      = i_show_kz ? box_c : na,
                          text         = i_show_kz and i_show_kz_txt ? this.title : "",
                          text_color   = text_c,
                          text_halign  = text.align_center,
                          text_valign  = text.align_center,
                          text_size    = size.normal)
        array.unshift(this.boxes, new_box)
        if array.size(this.boxes) > i_kz_max_days
            box.delete(array.pop(this.boxes))
    if in_sess and array.size(this.boxes) > 0
        b = array.get(this.boxes, 0)
        box.set_right(b, time)
        box.set_top(b,    math.max(box.get_top(b),    high))
        box.set_bottom(b, math.min(box.get_bottom(b), low))
        // -- Text scales with box width. Pine has no size.auto for box text
        //    (that's table-cell only), so step text_size off the live bar
        //    span of the session box each bar as it extends. --
        kz_bars = (box.get_right(b) - box.get_left(b)) / (time - time[1])
        box.set_text_size(b, kz_bars < 3 ? size.normal :
                             kz_bars < 6 ? size.large : size.huge)
    this.was_in_sess := in_sess

// =====================================================================
// preopen_mins_for() — minutes until a killzone's NEXT START opens, in its
// own timezone, respecting that session's per-day DoW filter (the SAME 7
// booleans the engine ANDs into in_session). DISPLAY-ONLY (drives the GET
// READY pre-open look-ahead); the firing engine never reads it.
//
// How it works (chart-side, from inputs only — no engine/SigState state):
//   • Parse the START "HHMM" from the session string's first 4 chars
//     (input.session is always "HHMM-HHMM"). hh = chars 0-1, mm = chars 2-3.
//   • For day_offset in {0 today, 1 tomorrow}: build that open's epoch via
//     timestamp(tz, Y, M, D+offset, hh, mm, 0). timestamp() normalizes the
//     day overflow, so D+1 rolls months/years correctly.
//   • Δmin = (open_ts − timenow) / 60000. timenow makes the count tick live.
//     Keep the open only if 0 ≤ Δmin ≤ cap (future, within the window) AND
//     the DoW gate passes for the WEEKDAY the open actually lands on
//     (dayofweek(open_ts, tz)).
//   • Today is tried first; tomorrow is the fallback that also catches the
//     midnight-crossing sessions (NY Lunch 0000-, NY PM 0130-) once today's
//     open has already passed. Returns the soonest qualifying Δmin, else na.
//   • A session with ALL DoW unticked never qualifies (every open's DoW gate
//     is false) → it's inert here, matching the engine.
// =====================================================================
preopen_mins_for(bool en, string sess_str, string tz, int cap,
   bool d_mon, bool d_tue, bool d_wed, bool d_thu, bool d_fri, bool d_sat, bool d_sun) =>
    float best = na
    if en and cap > 0 and str.length(sess_str) >= 4
        hh = str.tonumber(str.substring(sess_str, 0, 2))
        mm = str.tonumber(str.substring(sess_str, 2, 4))
        if not na(hh) and not na(mm)
            base_y = year(timenow, tz)
            base_m = month(timenow, tz)
            base_d = dayofmonth(timenow, tz)
            for off = 0 to 1
                open_ts = timestamp(tz, base_y, base_m, base_d + off, int(hh), int(mm), 0)
                dmin    = (open_ts - timenow) / 60000.0
                if dmin >= 0 and dmin <= cap
                    odow = dayofweek(open_ts, tz)
                    dow_ok = (odow == dayofweek.monday    and d_mon) or
                       (odow == dayofweek.tuesday   and d_tue) or
                       (odow == dayofweek.wednesday and d_wed) or
                       (odow == dayofweek.thursday  and d_thu) or
                       (odow == dayofweek.friday    and d_fri) or
                       (odow == dayofweek.saturday  and d_sat) or
                       (odow == dayofweek.sunday    and d_sun)
                    if dow_ok and (na(best) or dmin < best)
                        best := dmin
    best

// =====================================================================
// compute_sig_state() — full signal + sim pipeline. See header for the
// signal-TF lift rationale. Multi-position update: trades are stored in
// a var array<Trade> inside this function; entry pushes a new Trade,
// TP/SL processing iterates the array (newest-first for safe removal).
// =====================================================================
compute_sig_state() =>
    // -- Volatility (ATR is still needed for SL buffer + entry proximity) --
    atr_val = ta.atr(i_atr_per)

    // -- 1H bias (nested HTF request from sig-TF context) --
    // Non-repaint pattern: [1] + lookahead_on ensures we read the
    // PREVIOUS closed HTF bar's value (not the forming bar), so realtime
    // signals and historical replays produce identical entries. Trade-off:
    // bias is 1 closed HTF bar stale (~ tf duration behind). Do NOT
    // "fix" this back to close + lookahead_off — that reintroduces repaint.
    h1_close = request.security(syminfo.tickerid, i_h1_tf, close[1], barmerge.gaps_off, barmerge.lookahead_on)
    h1_fast  = request.security(syminfo.tickerid, i_h1_tf, ta.ema(close, i_h1_fast)[1], barmerge.gaps_off, barmerge.lookahead_on)
    h1_slow  = request.security(syminfo.tickerid, i_h1_tf, ta.ema(close, i_h1_slow)[1], barmerge.gaps_off, barmerge.lookahead_on)
    h1_bull  = h1_fast > h1_slow and h1_close > h1_fast
    h1_bear  = h1_fast < h1_slow and h1_close < h1_fast
    h1_bias_s = h1_bull ? "bullish" : h1_bear ? "bearish" : "ranging"

    // -- Swings / BOS / OB --
    ph = ta.pivothigh(i_swing_len, i_swing_len)
    pl = ta.pivotlow (i_swing_len, i_swing_len)

    var float last_sh    = na
    var int   last_sh_bi = na
    var float last_sl    = na
    var int   last_sl_bi = na

    if not na(ph)
        last_sh    := ph
        last_sh_bi := bar_index - i_swing_len
    if not na(pl)
        last_sl    := pl
        last_sl_bi := bar_index - i_swing_len

    bull_bos = not na(last_sh) and close > last_sh and close[1] <= last_sh
    bear_bos = not na(last_sl) and close < last_sl and close[1] >= last_sl

    // -- Size-gated BOS (Risk Controls). When i_bos_min_atr > 0, the close
    //    must clear the broken swing by at least i_bos_min_atr × ATR for the
    //    break to count. Applied to the raw bos flags BEFORE they drive
    //    active-structure flips and OB recompute, so everything downstream
    //    (structure, OB, setups, SMC visuals) stays consistent. At default 0
    //    both clauses are unconditionally true → true no-op.
    bull_bos := bull_bos and (i_bos_min_atr <= 0 or (close - last_sh) >= i_bos_min_atr * atr_val)
    bear_bos := bear_bos and (i_bos_min_atr <= 0 or (last_sl - close) >= i_bos_min_atr * atr_val)

    var bool  active_bull_bos = false
    var bool  active_bear_bos = false
    var int   bos_bar         = na
    var int   last_bull_bos_b = na
    var int   last_bear_bos_b = na

    if bull_bos
        active_bull_bos := true
        active_bear_bos := false
        bos_bar         := bar_index
        last_bull_bos_b := bar_index
    if bear_bos
        active_bear_bos := true
        active_bull_bos := false
        bos_bar         := bar_index
        last_bear_bos_b := bar_index

    if active_bull_bos and (bar_index - bos_bar) > i_bos_age
        active_bull_bos := false
    if active_bear_bos and (bar_index - bos_bar) > i_bos_age
        active_bear_bos := false

    var float ob_high   = na
    var float ob_low    = na
    var int   ob_bar    = na
    var bool  ob_demand = false

    if bull_bos
        ob_high := na
        ob_low  := na
        ob_bar  := na
        for i = 1 to math.min(i_ob_age, bar_index - 1)
            if close[i] < open[i]
                ob_high   := high[i]
                ob_low    := low[i]
                ob_bar    := bar_index - i
                ob_demand := true
                break

    if bear_bos
        ob_high := na
        ob_low  := na
        ob_bar  := na
        for i = 1 to math.min(i_ob_age, bar_index - 1)
            if close[i] > open[i]
                ob_high   := high[i]
                ob_low    := low[i]
                ob_bar    := bar_index - i
                ob_demand := false
                break

    // -- SMC structure-event classification (BG-driven; visuals only) --
    // last_bos_dir tracks the prior structural bias from BG BOS events only
    // (+1 = last break was bullish, -1 = bearish). A break in the opposite
    // direction to the stored bias is a CHoCH; a same-direction break is a
    // plain BOS. No separate LuxAlgo trend engine — derived purely from BG.
    var int last_bos_dir = 0
    // Latch the MOST-RECENT break's CHoCH classification (var, function-local,
    // not surfaced to SigState). Lets the Add-row diagnostic name the break
    // correctly as "CHoCH" vs "BOS" at a later bar — smc_choch itself is a
    // per-bar bool that's false on every non-break bar.
    var bool last_break_choch = false

    bool  smc_bos_bull  = bull_bos
    bool  smc_bos_bear  = bear_bos
    bool  smc_choch     = false
    float smc_bos_level = na
    int   smc_bos_from  = na

    if bull_bos
        smc_choch        := last_bos_dir == -1
        smc_bos_level    := last_sh
        smc_bos_from     := last_sh_bi
        last_bos_dir     := 1
        last_break_choch := smc_choch
    else if bear_bos
        smc_choch        := last_bos_dir == 1
        smc_bos_level    := last_sl
        smc_bos_from     := last_sl_bi
        last_bos_dir     := -1
        last_break_choch := smc_choch

    // A new OB is formed on the same bar a BOS fires (BG sets ob_* there).
    bool  smc_ob_new    = (bull_bos or bear_bos) and not na(ob_bar)
    bool  smc_ob_demand = ob_demand
    float smc_ob_high   = ob_high
    float smc_ob_low    = ob_low
    int   smc_ob_from   = ob_bar

    // -- Setup detection --
    have_ob_bull = active_bull_bos and not na(ob_high) and ob_demand
    have_ob_bear = active_bear_bos and not na(ob_low)  and not ob_demand

    dist_bull = have_ob_bull ? (close > ob_high ? close - ob_high : 0.0) : na
    dist_bear = have_ob_bear ? (close < ob_low  ? ob_low  - close : 0.0) : na

    near_bull = have_ob_bull and not na(dist_bull) and dist_bull <= i_entry_atr * atr_val
    near_bear = have_ob_bear and not na(dist_bear) and dist_bear <= i_entry_atr * atr_val

    // HTF agreement: when required, the bias must match the trade
    // direction OR be neutral (not actively opposed).
    h1_ok_bull = not i_req_h1 or h1_bull or (not i_strict_bias and not h1_bear)
    h1_ok_bear = not i_req_h1 or h1_bear or (not i_strict_bias and not h1_bull)

    bull_setup = have_ob_bull and near_bull and h1_ok_bull
    bear_setup = have_ob_bear and near_bear and h1_ok_bear

    bull_forming = have_ob_bull and h1_ok_bull and not near_bull
    bear_forming = have_ob_bear and h1_ok_bear and not near_bear

    // -- Potential-entry (WATCH) level the engine is waiting for. Mirrors the
    //    near_bull / near_bear proximity trigger: near_bull fires when
    //    close <= ob_high + i_entry_atr*atr_val, near_bear when
    //    close >= ob_low - i_entry_atr*atr_val. So the awaited price is the
    //    OB edge offset by the proximity band. Purely informational — no
    //    effect on signal/sim math. --
    float watch_entry_px = na
    int   watch_dir      = 0
    if bull_forming
        watch_entry_px := ob_high + i_entry_atr * atr_val
        watch_dir      := 1
    else if bear_forming
        watch_entry_px := ob_low - i_entry_atr * atr_val
        watch_dir      := -1

    // -- Projected SL / TP1 / TP2 for the WATCHED setup. Mirrors the REAL
    //    entry's SL math (raw_sl = OB edge ± i_sl_buf*atr, then Min-SL CLAMP
    //    widening) but projects from watch_entry_px. Purely visual — the
    //    Min-SL *reject* filter is intentionally NOT applied here; that only
    //    matters at real fire time. --
    float watch_sl_px  = na
    float watch_tp1_px = na
    float watch_tp2_px = na
    if bull_forming
        raw_sl_w = ob_low - i_sl_buf * atr_val
        sl_w = (i_min_sl > 0 and (watch_entry_px - raw_sl_w) < i_min_sl) ? watch_entry_px - i_min_sl : raw_sl_w
        risk_w = watch_entry_px - sl_w
        watch_sl_px  := sl_w
        watch_tp1_px := watch_entry_px + 1.0 * risk_w
        watch_tp2_px := watch_entry_px + 2.0 * risk_w
    else if bear_forming
        raw_sl_w = ob_high + i_sl_buf * atr_val
        sl_w = (i_min_sl > 0 and (raw_sl_w - watch_entry_px) < i_min_sl) ? watch_entry_px + i_min_sl : raw_sl_w
        risk_w = sl_w - watch_entry_px
        watch_sl_px  := sl_w
        watch_tp1_px := watch_entry_px - 1.0 * risk_w
        watch_tp2_px := watch_entry_px - 2.0 * risk_w

    // -- Projected entry/SL/TP2 for the SETUP state (price already in
    //    proximity → near_bull/near_bear true → watch_* na). Uses THE ENGINE'S
    //    OWN entry math so the GET READY label matches what would book at bar
    //    close: entry = close; raw_sl = OB edge ± i_sl_buf*atr; Min-SL CLAMP
    //    widens to i_min_sl when raw distance < i_min_sl — EXACT mirror of the
    //    entry block (~lines 1300-1345). The Min-SL FILTER (reject) is
    //    intentionally NOT applied: the checklist Min-SL row already flags a
    //    reject, and the projection should still display. Purely visual — these
    //    locals/fields touch NOTHING in signal/sim accounting. --
    float setup_entry_px = na
    int   setup_dir      = 0
    float setup_sl_px    = na
    float setup_tp1_px   = na
    float setup_tp2_px   = na
    if bull_setup
        setup_entry_px := close
        setup_dir      := 1
        raw_sl_s = ob_low - i_sl_buf * atr_val
        raw_dst_s = close - raw_sl_s
        final_sl_s = (i_min_sl > 0 and raw_dst_s < i_min_sl) ? close - i_min_sl : raw_sl_s
        risk_s = close - final_sl_s
        setup_sl_px  := final_sl_s
        setup_tp1_px := close + 1.0 * risk_s
        setup_tp2_px := close + 2.0 * risk_s
    else if bear_setup
        setup_entry_px := close
        setup_dir      := -1
        raw_sl_s = ob_high + i_sl_buf * atr_val
        raw_dst_s = raw_sl_s - close
        final_sl_s = (i_min_sl > 0 and raw_dst_s < i_min_sl) ? close + i_min_sl : raw_sl_s
        risk_s = final_sl_s - close
        setup_sl_px  := final_sl_s
        setup_tp1_px := close - 1.0 * risk_s
        setup_tp2_px := close - 2.0 * risk_s

    // -- Sim state: array of active trades + aggregate counters --
    var array<Trade> active_trades = array.new<Trade>(0)
    var int   sim_close_bar   = na

    var int   sim_wins      = 0
    var int   sim_losses    = 0
    var float sim_total_r   = 0.0
    var float sim_total_usd = 0.0
    var int   sim_count     = 0

    // -- Edge / cost accumulators. Mutated in the SAME close branches as the
    //    existing R classification so gross and net always describe the same
    //    trades and can never drift. Net/derived figures are computed chart-
    //    side from these; the gross sim_total_r / sim_total_usd / win-loss
    //    counts above are never altered. --
    var float gross_win_r     = 0.0   // sum of realized +R on winning closes
    var float gross_loss_r    = 0.0   // sum of |R| (positive) on losing closes
    var int   cur_loss_streak = 0
    var int   max_loss_streak = 0
    var int   cur_win_streak  = 0
    var int   max_win_streak  = 0
    var float sum_spread_r    = 0.0   // Σ (i_spread / risk_pts) per closed trade
    var float sum_mfe_r       = 0.0   // Σ best favorable excursion (R) per trade
    var float sum_mae_r       = 0.0   // Σ worst adverse excursion (R, ≤0) per trade

    // -- Outcome-anatomy counters (display-only). Each CLOSED trade is binned
    //    into exactly one of 4 mutually-exclusive buckets at close time, using
    //    the SAME win/loss attribution as sim_wins/sim_losses plus the trade's
    //    per-trade MFE (already in R). Σ(4 buckets) == sim_wins + sim_losses
    //    always. sum_hold_ms accrues wall-clock hold (close time − open_time)
    //    per closed trade. Mutated only inside the close branches → never
    //    touches entries/exits/sizing/alerts. --
    var int   n_win_tp2       = 0     // booked a WIN (TP-final or trailed-SL win)
    var int   n_loss_near     = 0     // loss, MFE_R >= i_near_tp2 (hairline miss)
    var int   n_loss_aftertp1 = 0     // loss, 1.0 <= MFE_R < i_near_tp2
    var int   n_loss_straight = 0     // loss, MFE_R < 1.0
    // Sub-slice of n_win_tp2: TP2 wins that retraced to BE after TP1 then
    // recovered to hit TP2. Display-only; never affects engine behavior.
    var int   n_win_tp1_be_tp2 = 0
    var int   sum_hold_ms     = 0

    // -- Session / weekday R-breakdown buckets. Realized R + trade count
    //    attributed to the session and weekday each trade OPENED in. Mutated
    //    in the SAME close branches as sim_total_r so they can never drift
    //    from the gross total. sess: 0=Asia 1=London 2=NYAM 3=NYLU 4=NYPM;
    //    -1 = opened off-session (only possible when sessions disabled) →
    //    that trade's R lands in NO session bucket but DOES land in a dow
    //    bucket, so Σ(dow) == gross total R always, and Σ(sess) == gross
    //    total R whenever every trade opened inside a killzone. --
    var array<float> r_by_sess = array.new<float>(5, 0.0)
    var array<int>   n_by_sess = array.new<int>(5, 0)
    var array<float> r_by_dow  = array.new<float>(7, 0.0)
    var array<int>   n_by_dow  = array.new<int>(7, 0)

    // -- SESSIONS-band counters (display-only). Mutated ONLY inside the close
    //    branches, alongside the existing win/loss booking, so the WIN
    //    attribution (trailed-SL eff R>=0 = WIN) is identical everywhere.
    //    A single close helper (book_session_stats below) writes all of these
    //    from the closing Trade so the math lives once. --
    var array<int> ent_by_bucket      = array.new<int>(3, 0)  // Asia/London/NY
    var array<int> ent_wins_by_bucket = array.new<int>(3, 0)
    var array<int> path_n             = array.new<int>(8, 0)
    var array<int> path_w             = array.new<int>(8, 0)
    var int hold_ms_wins      = 0
    var int hold_ms_losses    = 0
    var int n_hold_wins       = 0
    var int n_hold_losses     = 0
    var int n_same_sess_close = 0
    var int n_overnight       = 0
    var array<int> dow_w = array.new<int>(5, 0)  // Mon..Fri
    var array<int> dow_l = array.new<int>(5, 0)

    // -- SESSION BIAS (display-only). Per-session [Asia,London,NY] running
    //    bias-state tallies over confirmed in-range bars (time windows only).
    //    Plus a rolling-last-10-PHT-weekday queue: one slot per weekday holding
    //    that day's {bull,bear,range} bar count per session. On each new PHT
    //    weekday a fresh 0-slot is pushed (unshift to head) and the oldest
    //    popped once size > 10; the bar accrues into the HEAD slot. All array
    //    ops are na-safe (arrays pre-sized; head exists only after the first
    //    push, guarded below). --
    var array<int> sb_bull  = array.new<int>(3, 0)
    var array<int> sb_bear  = array.new<int>(3, 0)
    var array<int> sb_range = array.new<int>(3, 0)
    // Queues: 9 parallel int arrays (3 sessions × 3 states), index 0 = newest
    // day. q_daykey parallels them (the PHT y*10000+m*100+d key per slot) so a
    // weekday rollover is detected without history refs.
    var array<int> q_daykey = array.new<int>(0)
    var array<int> qa_bull  = array.new<int>(0)
    var array<int> qa_bear  = array.new<int>(0)
    var array<int> qa_range = array.new<int>(0)
    var array<int> ql_bull  = array.new<int>(0)
    var array<int> ql_bear  = array.new<int>(0)
    var array<int> ql_range = array.new<int>(0)
    var array<int> qn_bull  = array.new<int>(0)
    var array<int> qn_bear  = array.new<int>(0)
    var array<int> qn_range = array.new<int>(0)

    // -- ENTRY BIAS SPLIT (display-only). Per-session [Asia,London,NY] closed-
    //    trade entry classification + WINs. Booked in the close block. --
    var array<int> ebs_match     = array.new<int>(3, 0)
    var array<int> ebs_match_w   = array.new<int>(3, 0)
    var array<int> ebs_range     = array.new<int>(3, 0)
    var array<int> ebs_range_w   = array.new<int>(3, 0)
    var array<int> ebs_counter   = array.new<int>(3, 0)
    var array<int> ebs_counter_w = array.new<int>(3, 0)

    // Realized-equity drawdown (raw points). Tracks the running cumulative
    // sim_total_usd curve: dd_peak_pts is the high-water mark, max_dd_pts
    // the largest peak-to-trough decline seen. Updated once per bar right
    // after the active-trades close loop (below), so sim_total_usd is final
    // for the bar at update time. Display rescales by the lot multiplier.
    var float dd_peak_pts   = 0.0
    var float max_dd_pts    = 0.0

    var int   day_anchor       = na
    var int   month_anchor     = na
    var float day_r_today      = 0.0
    var float day_usd_today    = 0.0
    var int   day_wins_today   = 0
    var int   day_losses_today = 0
    var int   day_opens_today  = 0

    // Sim date-range coverage: first/last bar time the sim actually
    // evaluated (set only on in-range bars below).
    var int   sim_first_time   = na
    var int   sim_last_time     = na

    // Distinct Manila (PHT) WEEKDAYS that have had ≥1 in-range bar. Used as
    // the denominator for Avg Trades/Day (display-only). td_day_key is a
    // monotonic per-day key (y*10000+m*100+d, Asia/Manila) so a rollover is
    // detected without history refs; td_anchor stores the last counted key.
    // Only Mon–Fri are counted (the sim's killzones are weekday sessions;
    // weekend bars, if any, don't define a trading day). Counted on the FIRST
    // in-range bar of each new weekday — same open-day attribution the day
    // counter uses, so trades and the denominator share one PHT clock.
    var int   num_trading_days = 0
    var int   td_anchor        = na

    day_today   = dayofmonth(time, "Asia/Manila")
    month_today = month(time, "Asia/Manila")

    if na(day_anchor) or day_today != day_anchor or month_today != month_anchor
        day_anchor       := day_today
        month_anchor     := month_today
        day_r_today      := 0.0
        day_usd_today    := 0.0
        day_wins_today   := 0
        day_losses_today := 0
        day_opens_today  := 0

    // Cooldown: only blocks when zero trades are open (multi-position mode
    // shouldn't wait between trades, only after the bench fully empties).
    cooldown_ok = array.size(active_trades) > 0 or
      na(sim_close_bar) or (bar_index - sim_close_bar) >= i_cooldown

    // -- Date range filter (PHT live-rolling current week / month) --
    curmonth_y     = year(timenow,  "Asia/Manila")
    curmonth_m     = month(timenow, "Asia/Manila")
    curmonth_start = timestamp("Asia/Manila", curmonth_y, curmonth_m, 1, 0, 0)
    nextmonth_y    = curmonth_m == 12 ? curmonth_y + 1 : curmonth_y
    nextmonth_m    = curmonth_m == 12 ? 1 : curmonth_m + 1
    curmonth_end   = timestamp("Asia/Manila", nextmonth_y, nextmonth_m, 1, 0, 0)

    curday_y      = year(timenow,       "Asia/Manila")
    curday_m      = month(timenow,      "Asia/Manila")
    curday_d      = dayofmonth(timenow, "Asia/Manila")
    curday_dow    = dayofweek(timenow,  "Asia/Manila")
    today_start   = timestamp("Asia/Manila", curday_y, curday_m, curday_d, 0, 0)
    days_to_mon   = curday_dow == 1 ? 6 : curday_dow - 2
    curweek_start = today_start   - days_to_mon * 86400000
    curweek_end   = curweek_start + 7           * 86400000

    // Rolling "last N days" windows, anchored at current real-time.
    last7_start  = timenow - 7  * 86400000
    last14_start = timenow - 14 * 86400000
    last30_start = timenow - 30 * 86400000
    last60_start = timenow - 60 * 86400000

    inside_curweek  = time >= curweek_start  and time <  curweek_end
    inside_curmonth = time >= curmonth_start and time <  curmonth_end
    inside_last7    = time >= last7_start
    inside_last14   = time >= last14_start
    inside_last30   = time >= last30_start
    inside_last60   = time >= last60_start
    inside_custom   = time >= i_date_from    and time <= i_date_to

    filter_active = i_use_curweek or i_use_curmonth or
      i_use_last7 or i_use_last14 or i_use_last30 or i_use_last60 or
      i_use_dates
    // Priority: shorter window wins when multiple are ticked.
    inside_range = i_use_curweek  ? inside_curweek  :
      i_use_curmonth ? inside_curmonth :
      i_use_last7    ? inside_last7    :
      i_use_last14   ? inside_last14   :
      i_use_last30   ? inside_last30   :
      i_use_last60   ? inside_last60   :
      inside_custom

    // Day-of-week info used by the per-session DoW gate below
    // (Asia/Manila). Global DoW filter was removed in favor of
    // per-session toggles under "Killzones / Session Filter".
    bar_dow = dayofweek(time, "Asia/Manila")

    in_date_range = not filter_active or inside_range

    // Track the window the sim actually evaluated: first → last in-range bar.
    if in_date_range
        if na(sim_first_time)
            sim_first_time := time
        sim_last_time := time
        // Count a new distinct Manila weekday the first time we see an in-range
        // bar on it. year() in Asia/Manila keeps the key unique across months.
        td_key = year(time, "Asia/Manila") * 10000 + month_today * 100 + day_today
        is_weekday = bar_dow != dayofweek.saturday and bar_dow != dayofweek.sunday
        if is_weekday and (na(td_anchor) or td_key != td_anchor)
            td_anchor        := td_key
            num_trading_days += 1

    // -- Session filter (5 killzones, all in the user-selected timezone). --
    in_kz_asia   = not na(time(timeframe.period, i_asia_sess,   i_kz_tz))
    in_kz_london = not na(time(timeframe.period, i_london_sess, i_kz_tz))
    in_kz_nyam   = not na(time(timeframe.period, i_nyam_sess,   i_kz_tz))
    in_kz_nylu   = not na(time(timeframe.period, i_nylu_sess,   i_kz_tz))
    in_kz_nypm   = not na(time(timeframe.period, i_nypm_sess,   i_kz_tz))

    // -- SESSION BIAS accrual (display-only). On every CONFIRMED in-range bar,
    //    classify the engine's H1 bias state (the SAME h1_bull/h1_bear the gate
    //    uses) and tally it into each session whose TIME window contains this
    //    bar (DoW gating ignored). NY = nyam|nylu|nypm merged. Also maintains a
    //    rolling 10-PHT-weekday queue. Runs only at confirmed-bar close so the
    //    counts match the engine's once-per-bar resolution and don't repaint. --
    if barstate.isconfirmed and in_date_range
        // Bias state: 0=bull, 1=bear, 2=range. Reuses h1_bull/h1_bear.
        int bias_state = h1_bull ? 0 : h1_bear ? 1 : 2
        // Roll the queue on a new PHT WEEKDAY (Mon..Fri only — weekend bars,
        // if any, accrue into running totals but do NOT open a new day slot).
        bool sb_is_weekday = bar_dow != dayofweek.saturday and bar_dow != dayofweek.sunday
        int  sb_daykey = year(time, "Asia/Manila") * 10000 + month_today * 100 + day_today
        bool sb_head_exists = array.size(q_daykey) > 0
        bool sb_new_day = sb_is_weekday and (not sb_head_exists or array.get(q_daykey, 0) != sb_daykey)
        if sb_new_day
            array.unshift(q_daykey, sb_daykey)
            array.unshift(qa_bull, 0)
            array.unshift(qa_bear, 0)
            array.unshift(qa_range, 0)
            array.unshift(ql_bull, 0)
            array.unshift(ql_bear, 0)
            array.unshift(ql_range, 0)
            array.unshift(qn_bull, 0)
            array.unshift(qn_bear, 0)
            array.unshift(qn_range, 0)
            if array.size(q_daykey) > 10
                array.pop(q_daykey)
                array.pop(qa_bull)
                array.pop(qa_bear)
                array.pop(qa_range)
                array.pop(ql_bull)
                array.pop(ql_bear)
                array.pop(ql_range)
                array.pop(qn_bull)
                array.pop(qn_bear)
                array.pop(qn_range)
        // Only accrue into the queue head once at least one day slot exists.
        bool sb_can_q = array.size(q_daykey) > 0
        // Asia
        if in_kz_asia
            array.set(sb_bull,  0, array.get(sb_bull,  0) + (bias_state == 0 ? 1 : 0))
            array.set(sb_bear,  0, array.get(sb_bear,  0) + (bias_state == 1 ? 1 : 0))
            array.set(sb_range, 0, array.get(sb_range, 0) + (bias_state == 2 ? 1 : 0))
            if sb_can_q
                if bias_state == 0
                    array.set(qa_bull, 0, array.get(qa_bull, 0) + 1)
                else if bias_state == 1
                    array.set(qa_bear, 0, array.get(qa_bear, 0) + 1)
                else
                    array.set(qa_range, 0, array.get(qa_range, 0) + 1)
        // London
        if in_kz_london
            array.set(sb_bull,  1, array.get(sb_bull,  1) + (bias_state == 0 ? 1 : 0))
            array.set(sb_bear,  1, array.get(sb_bear,  1) + (bias_state == 1 ? 1 : 0))
            array.set(sb_range, 1, array.get(sb_range, 1) + (bias_state == 2 ? 1 : 0))
            if sb_can_q
                if bias_state == 0
                    array.set(ql_bull, 0, array.get(ql_bull, 0) + 1)
                else if bias_state == 1
                    array.set(ql_bear, 0, array.get(ql_bear, 0) + 1)
                else
                    array.set(ql_range, 0, array.get(ql_range, 0) + 1)
        // NY (AM | Lunch | PM merged) — a single bar can sit in only one NY
        // sub-window at a time, but OR-merge is safe regardless.
        if in_kz_nyam or in_kz_nylu or in_kz_nypm
            array.set(sb_bull,  2, array.get(sb_bull,  2) + (bias_state == 0 ? 1 : 0))
            array.set(sb_bear,  2, array.get(sb_bear,  2) + (bias_state == 1 ? 1 : 0))
            array.set(sb_range, 2, array.get(sb_range, 2) + (bias_state == 2 ? 1 : 0))
            if sb_can_q
                if bias_state == 0
                    array.set(qn_bull, 0, array.get(qn_bull, 0) + 1)
                else if bias_state == 1
                    array.set(qn_bear, 0, array.get(qn_bear, 0) + 1)
                else
                    array.set(qn_range, 0, array.get(qn_range, 0) + 1)

    // Per-session day-of-week filter — each killzone independently
    // restricts which weekdays it can OPEN trades on. All 7 ticked =
    // no restriction (default). Uses bar_dow computed above in
    // Asia/Manila. ANDs into in_session per-session, so blocking a day
    // for London doesn't affect Asia/NYAM/etc.
    asia_dow_ok = (bar_dow == dayofweek.monday    and i_asia_dow_mon) or
      (bar_dow == dayofweek.tuesday   and i_asia_dow_tue) or
      (bar_dow == dayofweek.wednesday and i_asia_dow_wed) or
      (bar_dow == dayofweek.thursday  and i_asia_dow_thu) or
      (bar_dow == dayofweek.friday    and i_asia_dow_fri) or
      (bar_dow == dayofweek.saturday  and i_asia_dow_sat) or
      (bar_dow == dayofweek.sunday    and i_asia_dow_sun)
    london_dow_ok = (bar_dow == dayofweek.monday    and i_london_dow_mon) or
      (bar_dow == dayofweek.tuesday   and i_london_dow_tue) or
      (bar_dow == dayofweek.wednesday and i_london_dow_wed) or
      (bar_dow == dayofweek.thursday  and i_london_dow_thu) or
      (bar_dow == dayofweek.friday    and i_london_dow_fri) or
      (bar_dow == dayofweek.saturday  and i_london_dow_sat) or
      (bar_dow == dayofweek.sunday    and i_london_dow_sun)
    nyam_dow_ok = (bar_dow == dayofweek.monday    and i_nyam_dow_mon) or
      (bar_dow == dayofweek.tuesday   and i_nyam_dow_tue) or
      (bar_dow == dayofweek.wednesday and i_nyam_dow_wed) or
      (bar_dow == dayofweek.thursday  and i_nyam_dow_thu) or
      (bar_dow == dayofweek.friday    and i_nyam_dow_fri) or
      (bar_dow == dayofweek.saturday  and i_nyam_dow_sat) or
      (bar_dow == dayofweek.sunday    and i_nyam_dow_sun)
    nylu_dow_ok = (bar_dow == dayofweek.monday    and i_nylu_dow_mon) or
      (bar_dow == dayofweek.tuesday   and i_nylu_dow_tue) or
      (bar_dow == dayofweek.wednesday and i_nylu_dow_wed) or
      (bar_dow == dayofweek.thursday  and i_nylu_dow_thu) or
      (bar_dow == dayofweek.friday    and i_nylu_dow_fri) or
      (bar_dow == dayofweek.saturday  and i_nylu_dow_sat) or
      (bar_dow == dayofweek.sunday    and i_nylu_dow_sun)
    nypm_dow_ok = (bar_dow == dayofweek.monday    and i_nypm_dow_mon) or
      (bar_dow == dayofweek.tuesday   and i_nypm_dow_tue) or
      (bar_dow == dayofweek.wednesday and i_nypm_dow_wed) or
      (bar_dow == dayofweek.thursday  and i_nypm_dow_thu) or
      (bar_dow == dayofweek.friday    and i_nypm_dow_fri) or
      (bar_dow == dayofweek.saturday  and i_nypm_dow_sat) or
      (bar_dow == dayofweek.sunday    and i_nypm_dow_sun)

    in_session = not i_use_sessions or
      (i_use_asia   and in_kz_asia   and asia_dow_ok)   or
      (i_use_london and in_kz_london and london_dow_ok) or
      (i_use_nyam   and in_kz_nyam   and nyam_dow_ok)   or
      (i_use_nylu   and in_kz_nylu   and nylu_dow_ok)   or
      (i_use_nypm   and in_kz_nypm   and nypm_dow_ok)

    // Active session display label (priority: NY AM > London > NY Lunch >
    // NY PM > Asia — chosen so the most "tradeable" session wins overlap)
    session_now = in_kz_nyam   ? i_nyam_txt   :
      in_kz_london ? i_london_txt :
      in_kz_nylu   ? i_nylu_txt   :
      in_kz_nypm   ? i_nypm_txt   :
      in_kz_asia   ? i_asia_txt   : "off"

    // Numeric session index for trade attribution — SAME priority as
    // session_now (NYAM>London>NYLU>NYPM>Asia), encoded 0..4 for the
    // breakdown buckets. -1 = not inside any killzone right now.
    sess_idx_now = in_kz_nyam   ? 2 :
      in_kz_london ? 1 :
      in_kz_nylu   ? 3 :
      in_kz_nypm   ? 4 :
      in_kz_asia   ? 0 : -1

    // SESSIONS-band entry bucket (NY* merged): derived from sess_idx_now, NOT
    // recomputed — 0=Asia, 1=London, 2=NY(AM|Lunch|PM), -1=off. Captured into
    // the Trade at open for the entry-quality + resolution-path stats.
    sess_bucket_now = sess_idx_now == 0 ? 0 :
      sess_idx_now == 1 ? 1 :
      sess_idx_now >= 2 ? 2 : -1
    // PHT calendar-date key of the (potential) open bar, for same-day close
    // detection. day_today/month_today already in Asia/Manila; add the year.
    open_pht_date_now = year(time, "Asia/Manila") * 10000 + month_today * 100 + day_today

    // -- Per-bar event flags (local; not var — reset each bar) --
    evt_open_long      = false
    evt_open_short     = false
    int evt_open_ob_bar = na
    evt_tp1            = false
    evt_tp2            = false
    evt_tp3            = false
    evt_close_long_tp  = false
    evt_close_long_sl  = false
    evt_close_short_tp = false
    evt_close_short_sl = false
    evt_trail_step     = 0

    // -- Entry decision --
    // Admits a new trade if: sim is on, capacity available, cooldown clear,
    // bar is inside date/session windows, bar is confirmed. The Min SL
    // filter rejects setups whose OB-derived SL is too tight BEFORE the
    // clamp widens it (so the filter sees the natural OB size).
    // Risk-control day gates (both true no-ops at default 0):
    //   day_trades_ok — under the per-day open cap.
    //   day_loss_ok   — today's realized R hasn't breached the loss stop.
    day_trades_ok = i_max_day_trades == 0 or day_opens_today < i_max_day_trades
    day_loss_ok   = i_max_day_loss_r == 0 or day_r_today > -i_max_day_loss_r
    // One-position-per-OB + same-direction gate (effective when i_max_pos > 1).
    // A new position may open only on an OB not already held by an open
    // position, and only in the same direction as any open positions
    // (never long + short simultaneously). No-op when i_max_pos = 1.
    bool ob_already_held = false
    int  active_dir      = 0      // +1 = longs open, -1 = shorts open, 0 = none
    if array.size(active_trades) > 0
        Trade t0 = array.get(active_trades, 0)
        active_dir := t0.is_long ? 1 : -1
        for gi = 0 to array.size(active_trades) - 1
            Trade tg = array.get(active_trades, gi)
            if not na(ob_bar) and tg.ob_bar == ob_bar
                ob_already_held := true
    // -- DIAGNOSTIC (read-only): why is a 2nd/3rd position NOT opening? --
    // Only meaningful when a position is already live AND a slot is free.
    // Reuses ob_already_held / active_dir from the gate above. Pure read —
    // never feeds the entry condition. 2-space continuation indent so the
    // ternary chain isn't a multiple of 4 (Pine v6 line-continuation rule).
    string add_reason = ""
    // Add-ready direction: set ONLY when the add evaluation resolves to
    // "READY (will fire)" — i.e. an in-trade slot is free and a same-dir setup
    // is at the OB with all gates green. Direction = the firing setup's side.
    // Display-only; never feeds the entry condition. Bound to the EXACT same
    // ternary chain as add_reason (no parallel re-derivation).
    int add_ready_dir = 0
    // SAME-DIRECTION-ONLY views. An add can ONLY fire on the active position's
    // side (active_dir), so the Add row must narrate the same-dir candidate and
    // ignore opposite-dir setups/forming (they can never become an add). When
    // in-trade, fold the bull_*/bear_* flags down to the active side. Flat
    // (active_dir == 0) the Add block doesn't render, so the values are moot.
    bool sd_setup   = active_dir == 1 ? bull_setup   : active_dir == -1 ? bear_setup   : false
    bool sd_forming = active_dir == 1 ? bull_forming : active_dir == -1 ? bear_forming : false
    string want_dir_txt = active_dir == 1 ? "BUY" : "SELL"
    // ACTUAL blocker for the absent same-dir candidate, reusing the engine's own
    // flags in priority order: (1) no same-dir OB exists, else (2) OB exists but
    // the HTF bias gate blocks the side. Anything else falls through to plain.
    bool   sd_have_ob = active_dir == 1 ? have_ob_bull : active_dir == -1 ? have_ob_bear : false
    bool   sd_htf_ok  = active_dir == 1 ? h1_ok_bull   : active_dir == -1 ? h1_ok_bear   : false
    // Wanted-side OB word: the missing OB is named for the side the add wants
    // (bull when long / bear when short), NOT the break side. Most-recent break
    // direction word + its CHoCH/BOS class stay keyed off the break for "latest …".
    string want_ob_txt = active_dir == 1 ? "bull" : active_dir == -1 ? "bear" : "none"
    string brk_dir_txt = active_bull_bos ? "bull" : active_bear_bos ? "bear" : "none"
    string brk_kind    = last_break_choch ? "CHoCH" : "break"
    // Final parenthetical: blame the true cause.
    string sd_block_txt = not sd_have_ob ? "(" + want_ob_txt + " OB retired — latest " + brk_kind + " " + brk_dir_txt + ")" :
      not sd_htf_ok ? "(HTF bias blocks " + want_dir_txt + ")" : ""
    // NOT-NEAR enrichment: when the SAME-DIR setup is FORMING (OB anchored + HTF
    // ok, just not at the edge yet) we surface its live edge distance in ATR.
    // Reuses the SAME dist_bull/dist_bear/atr_val the gate uses — no re-derivation.
    string nn_dir  = active_dir == 1 ? "bull" : active_dir == -1 ? "bear" : ""
    float  nn_dist = active_dir == 1 and not na(dist_bull) ? dist_bull / atr_val :
      active_dir == -1 and not na(dist_bear) ? dist_bear / atr_val : na
    string nn_txt  = "NOT-NEAR (watching" +
      (nn_dir == "" ? "" : " " + nn_dir) +
      (na(nn_dist) ? "" : " · " + str.tostring(nn_dist, "0.0") + " ATR") + ")"
    if array.size(active_trades) >= 1 and array.size(active_trades) < i_max_pos
        add_reason := not in_date_range ? "DATE-OUT" :
          not in_session ? "OFF-SESS" :
          (not day_trades_ok or not day_loss_ok) ? "DAY-CAP" :
          (not sd_setup and not sd_forming) ? "no " + want_dir_txt + " setup" + (sd_block_txt == "" ? "" : " " + sd_block_txt) :
          not sd_setup ? nn_txt :
          ob_already_held ? "SAME-OB" :
          "READY (will fire)"
        // Bind add-ready dir to the SAME outcome string (single source of truth):
        // only set when add_reason resolved to READY. READY is now reachable
        // only via the SAME-DIR setup (sd_setup), so the firing side is active_dir.
        if add_reason == "READY (will fire)"
            add_ready_dir := active_dir
    // Latch the last REAL skip (a SAME-DIR setup was present but a gate blocked
    // it). Opposite-dir candidates are NOT skips here — they can never add — so
    // the latch only fires on sd_setup. Internal only; no panel row reads it.
    var string last_add_skip    = "—"
    var int    last_add_skip_bi = na
    if array.size(active_trades) >= 1 and array.size(active_trades) < i_max_pos and sd_setup and (not in_session or not in_date_range or not day_trades_ok or not day_loss_ok or ob_already_held)
        last_add_skip    := add_reason
        last_add_skip_bi := bar_index
    if i_sim_on and array.size(active_trades) < i_max_pos and cooldown_ok and in_date_range and in_session and day_trades_ok and day_loss_ok and barstate.isconfirmed
        if bull_setup and not ob_already_held and (active_dir == 0 or active_dir == 1)
            raw_sl  = ob_low - i_sl_buf * atr_val
            raw_dst = close - raw_sl
            // Min SL filter (reject path)
            if i_min_sl_flt <= 0 or raw_dst >= i_min_sl_flt
                final_sl = raw_sl
                // Min SL clamp (widen path)
                if i_min_sl > 0 and raw_dst < i_min_sl
                    final_sl := close - i_min_sl
                risk = close - final_sl
                if risk > 0
                    Trade t = Trade.new()
                    t.is_long    := true
                    t.entry      := close
                    t.sl         := final_sl
                    t.tp1        := close + 1.0 * risk
                    t.tp2        := close + 2.0 * risk
                    t.tp3        := close + 3.0 * risk
                    t.eff_sl     := final_sl
                    t.eff_sl_r   := -1.0
                    t.tp1_done   := false
                    t.tp2_done   := false
                    t.tp3_done   := false
                    t.open_bar     := bar_index
                    t.open_time    := time
                    t.open_day     := day_today
                    t.open_month   := month_today
                    t.bias_at_open := h1_bias_s
                    t.open_sess_idx := sess_idx_now
                    t.open_dow      := bar_dow
                    t.open_sess_bucket := sess_bucket_now
                    t.open_pht_date    := open_pht_date_now
                    t.ob_bar        := ob_bar
                    array.push(active_trades, t)
                    sim_count       += 1
                    day_opens_today += 1
                    evt_open_long   := true
                    evt_open_ob_bar := ob_bar
        else if bear_setup and not ob_already_held and (active_dir == 0 or active_dir == -1)
            raw_sl  = ob_high + i_sl_buf * atr_val
            raw_dst = raw_sl - close
            if i_min_sl_flt <= 0 or raw_dst >= i_min_sl_flt
                final_sl = raw_sl
                if i_min_sl > 0 and raw_dst < i_min_sl
                    final_sl := close + i_min_sl
                risk = final_sl - close
                if risk > 0
                    Trade t = Trade.new()
                    t.is_long    := false
                    t.entry      := close
                    t.sl         := final_sl
                    t.tp1        := close - 1.0 * risk
                    t.tp2        := close - 2.0 * risk
                    t.tp3        := close - 3.0 * risk
                    t.eff_sl     := final_sl
                    t.eff_sl_r   := -1.0
                    t.tp1_done   := false
                    t.tp2_done   := false
                    t.tp3_done   := false
                    t.open_bar     := bar_index
                    t.open_time    := time
                    t.open_day     := day_today
                    t.open_month   := month_today
                    t.bias_at_open := h1_bias_s
                    t.open_sess_idx := sess_idx_now
                    t.open_dow      := bar_dow
                    t.open_sess_bucket := sess_bucket_now
                    t.open_pht_date    := open_pht_date_now
                    t.ob_bar        := ob_bar
                    array.push(active_trades, t)
                    sim_count        += 1
                    day_opens_today  += 1
                    evt_open_short   := true
                    evt_open_ob_bar  := ob_bar

    // -- PRE-ENTRY CHECKLIST evaluation (display-only). Snapshots the engine's
    //    OWN gate results for the CANDIDATE direction (active BOS dir) so the
    //    flat LIVE-TRADE band can show what's missing. NOTHING here feeds the
    //    entry condition — pure read of variables already computed above on
    //    this confirmed bar. cand_dir: +1 bull BOS→BUY, -1 bear BOS→SELL, 0 =
    //    no active BOS (direction-dependent rows render "—" downstream).
    int   cand_dir = active_bull_bos ? 1 : active_bear_bos ? -1 : 0
    // BOS active + age (candidate dir). bos_bar is the bar the active BOS fired.
    bool  chk_bos_active = cand_dir != 0
    int   chk_bos_age    = chk_bos_active and not na(bos_bar) ? bar_index - bos_bar : na
    // OB anchored for the candidate dir + the edge price the engine watches
    // (bull retests ob_high from above; bear retests ob_low from below).
    bool  chk_ob      = cand_dir == 1 ? have_ob_bull : cand_dir == -1 ? have_ob_bear : false
    float chk_ob_edge = cand_dir == 1 and chk_ob ? ob_high : cand_dir == -1 and chk_ob ? ob_low : na
    // Price proximity to OB edge, in ATR (>=0). Reuses dist_bull/dist_bear —
    // the SAME distances near_bull/near_bear threshold against i_entry_atr*ATR.
    float chk_dist_atr = na
    if chk_ob and atr_val > 0
        chk_dist_atr := cand_dir == 1 and not na(dist_bull) ? dist_bull / atr_val :
          cand_dir == -1 and not na(dist_bear) ? dist_bear / atr_val : na
    bool  chk_price_at_ob = cand_dir == 1 ? near_bull : cand_dir == -1 ? near_bear : false
    // HTF agreement for the candidate dir (the SAME h1_ok_bull/bear the gate uses).
    bool  chk_htf_ok = cand_dir == 1 ? h1_ok_bull : cand_dir == -1 ? h1_ok_bear : false
    // Cooldown — mirror cooldown_ok; bars remaining when blocked.
    bool  chk_cooldown  = cooldown_ok
    int   chk_cool_left = (array.size(active_trades) == 0 and not na(sim_close_bar) and not cooldown_ok) ?
      math.max(0, i_cooldown - (bar_index - sim_close_bar)) : 0
    // Min-SL FILTER (reject) check on the NATURAL OB-derived SL distance, for
    // the candidate dir (BEFORE the clamp). Only meaningful with an OB.
    float chk_minsl_dist = na
    if chk_ob
        chk_minsl_dist := cand_dir == 1 ? (close - (ob_low - i_sl_buf * atr_val)) :
          (ob_high + i_sl_buf * atr_val) - close
    bool  chk_minsl_ok = not chk_ob ? false :
      (i_min_sl_flt <= 0 or (not na(chk_minsl_dist) and chk_minsl_dist >= i_min_sl_flt))
    // Slot free — capacity available for a new position.
    bool  chk_slot_free = array.size(active_trades) < i_max_pos
    // Fresh OB — candidate OB not already held by ANY open position. Evaluated
    // independently of ob_already_held (which is only set when a trade is open)
    // so it's correct flat (no trade → always fresh) and in-trade alike.
    bool  chk_fresh_ob = true
    if not na(ob_bar) and array.size(active_trades) > 0
        for ci = 0 to array.size(active_trades) - 1
            if array.get(active_trades, ci).ob_bar == ob_bar
                chk_fresh_ob := false
    // g_risk day gates (mirror day_trades_ok / day_loss_ok above).
    bool  chk_day_trades_ok = day_trades_ok
    bool  chk_day_loss_ok   = day_loss_ok

    // -- TP / SL chain config (shared across all active trades) --
    // Final-TP classification: which TP closes the trade?
    tp3_is_final = i_use_tp3 and not i_move_tp2
    tp2_is_final = not i_use_tp3 and i_use_tp2
    tp1_is_final = not i_use_tp3 and not i_use_tp2

    // Full position rides to the highest enabled TP — no scale-out, no
    // partial fills. Win R = the final TP's raw R value.
    win_r_tp1 = 1.0
    win_r_tp2 = 2.0
    win_r_tp3 = 3.0

    // -- Process active trades: TP fills + SL exits. Newest-first so we
    //    can remove closed trades safely while iterating. --
    if array.size(active_trades) > 0
        for idx = array.size(active_trades) - 1 to 0
            Trade t = array.get(active_trades, idx)
            if bar_index <= t.open_bar
                continue
            opened_today = t.open_day == day_today and t.open_month == month_today
            closed_now   = false
            // SESSIONS band: per-trade WIN flag for this close (set in each
            // close branch with the SAME attribution as sim_wins/sim_losses;
            // trailed-SL with eff R>=0 is a WIN). Booked once below before
            // array.remove via the inline session-stats block.
            bool was_win = false
            // -- MFE / MAE update (in R), BEFORE this bar's TP/SL resolution.
            //    Normalized by the trade's ORIGINAL risk (entry→initial SL).
            //    mfe_r = best favorable excursion seen; mae_r = worst adverse
            //    excursion seen (ends ≤ 0 = deepest drawdown the trade saw). --
            r_unit = math.abs(t.entry - t.sl)
            if r_unit > 0
                favorable = t.is_long ? (high - t.entry) / r_unit : (t.entry - low)  / r_unit
                adverse   = t.is_long ? (low  - t.entry) / r_unit : (t.entry - high) / r_unit
                t.mfe_r := math.max(t.mfe_r, favorable)
                t.mae_r := math.min(t.mae_r, adverse)
            // -- Bias-flip exit (Risk Controls). When the 1H bias has turned
            //    OPPOSITE this trade, optionally react before normal TP/SL
            //    resolution. Runs after MFE/MAE, before TP1, and (critically)
            //    before the SL check below so the "Close at market" path is
            //    resolved by the existing SL block THIS iteration.
            //      • Move to BE  — pull eff_sl to entry only if it tightens
            //        (long: entry below current stop; short: entry above).
            //        No close here; the existing SL block closes it normally.
            //      • Close at market — set eff_sl := close and recompute
            //        eff_sl_r from the live price. Because the SL check fires
            //        when low<=eff_sl (long) / high>=eff_sl (short) and the
            //        bar's low<=close / high>=close are always true, the trade
            //        closes through the existing SL path THIS bar — which does
            //        all R/$/win-loss/spread/MFE-MAE/day accounting and the
            //        removal. No separate close code → no double count.
            //    At default (i_exit_on_flip = false) this entire block is skipped.
            flip = (t.is_long and h1_bear) or (not t.is_long and h1_bull)
            if i_exit_on_flip and flip and not closed_now
                if i_flip_action == "Move to BE"
                    if t.is_long
                        if t.entry > t.eff_sl
                            t.eff_sl   := t.entry
                            t.eff_sl_r := math.max(t.eff_sl_r, 0.0)
                    else
                        if t.entry < t.eff_sl
                            t.eff_sl   := t.entry
                            t.eff_sl_r := math.max(t.eff_sl_r, 0.0)
                else
                    fr_unit = math.abs(t.entry - t.sl)
                    if fr_unit > 0
                        t.eff_sl   := close
                        t.eff_sl_r := (t.is_long ? (close - t.entry) : (t.entry - close)) / fr_unit
            // TP1
            if not t.tp1_done and (t.is_long ? high >= t.tp1 : low <= t.tp1)
                t.tp1_done := true
                evt_tp1    := true
                if tp1_is_final
                    usd_pnl = t.is_long ? (t.tp1 - t.entry) : (t.entry - t.tp1)
                    sim_total_r   += win_r_tp1
                    sim_total_usd += usd_pnl
                    sim_wins      += 1
                    // Session/weekday attribution (same R that hit sim_total_r)
                    bd_dow1 = (t.open_dow + 5) % 7
                    if t.open_sess_idx >= 0
                        array.set(r_by_sess, t.open_sess_idx, array.get(r_by_sess, t.open_sess_idx) + win_r_tp1)
                        array.set(n_by_sess, t.open_sess_idx, array.get(n_by_sess, t.open_sess_idx) + 1)
                    array.set(r_by_dow, bd_dow1, array.get(r_by_dow, bd_dow1) + win_r_tp1)
                    array.set(n_by_dow, bd_dow1, array.get(n_by_dow, bd_dow1) + 1)
                    // Edge/cost hooks (win branch)
                    gross_win_r += win_r_tp1
                    cur_loss_streak := 0
                    cur_win_streak += 1
                    max_win_streak := math.max(max_win_streak, cur_win_streak)
                    risk_pts = math.abs(t.entry - t.sl)
                    if risk_pts > 0
                        sum_spread_r += i_spread / risk_pts
                    sum_mfe_r += t.mfe_r
                    sum_mae_r += t.mae_r
                    // Outcome anatomy: TP-final → WIN bucket; accrue hold time.
                    n_win_tp2  += 1
                    was_win    := true
                    sum_hold_ms += time - t.open_time
                    if opened_today
                        day_r_today    += win_r_tp1
                        day_usd_today  += usd_pnl
                        day_wins_today += 1
                    if t.is_long
                        evt_close_long_tp  := true
                    else
                        evt_close_short_tp := true
                    sim_close_bar := bar_index
                    closed_now    := true
                else if i_move_be
                    t.eff_sl   := t.entry
                    t.eff_sl_r := 0.0
                    evt_trail_step := 1
            // -- BE-dip after TP1 (outcome anatomy, display-only). Once TP1 is
            //    filled and the trade is still open, flag if this bar's H/L
            //    retraced all the way back to entry (BE). Same confirmed-bar
            //    H/L granularity the TP/SL touches use. Latched once; booked
            //    into n_win_tp1_be_tp2 only if the trade later books a TP2 win.
            if t.tp1_done and not closed_now and not t.be_dip_after_tp1 and
               (t.is_long ? low <= t.entry : high >= t.entry)
                t.be_dip_after_tp1 := true
            // TP2
            if not closed_now and i_use_tp2 and not t.tp2_done and (t.is_long ? high >= t.tp2 : low <= t.tp2)
                t.tp2_done := true
                evt_tp2    := true
                if tp2_is_final
                    usd_pnl = t.is_long ? (t.tp2 - t.entry) : (t.entry - t.tp2)
                    sim_total_r   += win_r_tp2
                    sim_total_usd += usd_pnl
                    sim_wins      += 1
                    // Session/weekday attribution (same R that hit sim_total_r)
                    bd_dow2 = (t.open_dow + 5) % 7
                    if t.open_sess_idx >= 0
                        array.set(r_by_sess, t.open_sess_idx, array.get(r_by_sess, t.open_sess_idx) + win_r_tp2)
                        array.set(n_by_sess, t.open_sess_idx, array.get(n_by_sess, t.open_sess_idx) + 1)
                    array.set(r_by_dow, bd_dow2, array.get(r_by_dow, bd_dow2) + win_r_tp2)
                    array.set(n_by_dow, bd_dow2, array.get(n_by_dow, bd_dow2) + 1)
                    // Edge/cost hooks (win branch)
                    gross_win_r += win_r_tp2
                    cur_loss_streak := 0
                    cur_win_streak += 1
                    max_win_streak := math.max(max_win_streak, cur_win_streak)
                    risk_pts = math.abs(t.entry - t.sl)
                    if risk_pts > 0
                        sum_spread_r += i_spread / risk_pts
                    sum_mfe_r += t.mfe_r
                    sum_mae_r += t.mae_r
                    // Outcome anatomy: TP-final → WIN bucket; accrue hold time.
                    n_win_tp2  += 1
                    // TP2 win that dipped to BE after TP1 first (sub-slice).
                    if t.be_dip_after_tp1
                        n_win_tp1_be_tp2 += 1
                    was_win    := true
                    sum_hold_ms += time - t.open_time
                    if opened_today
                        day_r_today    += win_r_tp2
                        day_usd_today  += usd_pnl
                        day_wins_today += 1
                    if t.is_long
                        evt_close_long_tp  := true
                    else
                        evt_close_short_tp := true
                    sim_close_bar := bar_index
                    closed_now    := true
                else if i_move_tp1
                    // Trail to TP1 (locks +1R) — wins precedence over BE
                    t.eff_sl   := t.tp1
                    t.eff_sl_r := 1.0
                    evt_trail_step := 2
                else if i_move_be2
                    // Trail to BE (0R) — only fires when TP1 trail is off
                    t.eff_sl   := t.entry
                    t.eff_sl_r := 0.0
                    evt_trail_step := 1
            // TP3
            if not closed_now and i_use_tp3 and not t.tp3_done and (t.is_long ? high >= t.tp3 : low <= t.tp3)
                t.tp3_done := true
                evt_tp3    := true
                if tp3_is_final
                    usd_pnl = t.is_long ? (t.tp3 - t.entry) : (t.entry - t.tp3)
                    sim_total_r   += win_r_tp3
                    sim_total_usd += usd_pnl
                    sim_wins      += 1
                    // Session/weekday attribution (same R that hit sim_total_r)
                    bd_dow3 = (t.open_dow + 5) % 7
                    if t.open_sess_idx >= 0
                        array.set(r_by_sess, t.open_sess_idx, array.get(r_by_sess, t.open_sess_idx) + win_r_tp3)
                        array.set(n_by_sess, t.open_sess_idx, array.get(n_by_sess, t.open_sess_idx) + 1)
                    array.set(r_by_dow, bd_dow3, array.get(r_by_dow, bd_dow3) + win_r_tp3)
                    array.set(n_by_dow, bd_dow3, array.get(n_by_dow, bd_dow3) + 1)
                    // Edge/cost hooks (win branch)
                    gross_win_r += win_r_tp3
                    cur_loss_streak := 0
                    cur_win_streak += 1
                    max_win_streak := math.max(max_win_streak, cur_win_streak)
                    risk_pts = math.abs(t.entry - t.sl)
                    if risk_pts > 0
                        sum_spread_r += i_spread / risk_pts
                    sum_mfe_r += t.mfe_r
                    sum_mae_r += t.mae_r
                    // Outcome anatomy: TP-final → WIN bucket; accrue hold time.
                    n_win_tp2  += 1
                    was_win    := true
                    sum_hold_ms += time - t.open_time
                    if opened_today
                        day_r_today    += win_r_tp3
                        day_usd_today  += usd_pnl
                        day_wins_today += 1
                    if t.is_long
                        evt_close_long_tp  := true
                    else
                        evt_close_short_tp := true
                    sim_close_bar := bar_index
                    closed_now    := true
                else if i_move_tp2
                    t.eff_sl   := t.tp2
                    t.eff_sl_r := 2.0
                    evt_trail_step := 3
            // SL: full position rides at the current trail level. R
            // realized is simply eff_sl_r (-1 original, 0 BE, +1 TP1,
            // +2 TP2).
            if not closed_now and (t.is_long ? low <= t.eff_sl : high >= t.eff_sl)
                r_realized = t.eff_sl_r
                usd_pnl    = t.is_long ? (t.eff_sl - t.entry) : (t.entry - t.eff_sl)
                sim_total_r   += r_realized
                sim_total_usd += usd_pnl
                // Session/weekday attribution (same R that hit sim_total_r)
                bd_dows = (t.open_dow + 5) % 7
                if t.open_sess_idx >= 0
                    array.set(r_by_sess, t.open_sess_idx, array.get(r_by_sess, t.open_sess_idx) + r_realized)
                    array.set(n_by_sess, t.open_sess_idx, array.get(n_by_sess, t.open_sess_idx) + 1)
                array.set(r_by_dow, bd_dows, array.get(r_by_dow, bd_dows) + r_realized)
                array.set(n_by_dow, bd_dows, array.get(n_by_dow, bd_dows) + 1)
                // SL hit while trailed (eff_sl_r >= 0 means it sat at BE,
                // TP1, or TP2) counts as a WIN — the trade reached at
                // least its first target before the trail caught up.
                // Only an untrailed SL hit (original level, eff_sl_r = -1)
                // counts as a true loss.
                sl_was_trailed = t.eff_sl_r >= 0
                was_win := sl_was_trailed
                if sl_was_trailed
                    sim_wins += 1
                else
                    sim_losses += 1
                // Edge/cost hooks (same win/loss determination as above).
                // A trailed SL that counts as a win adds its +R to the win
                // bucket and resets the streak; an untrailed SL loss adds its
                // |R| magnitude to the loss bucket and extends the streak.
                if sl_was_trailed
                    gross_win_r += r_realized
                    cur_loss_streak := 0
                    cur_win_streak += 1
                    max_win_streak := math.max(max_win_streak, cur_win_streak)
                else
                    gross_loss_r += math.abs(r_realized)
                    cur_loss_streak += 1
                    max_loss_streak := math.max(max_loss_streak, cur_loss_streak)
                    cur_win_streak := 0
                risk_pts = math.abs(t.entry - t.sl)
                if risk_pts > 0
                    sum_spread_r += i_spread / risk_pts
                sum_mfe_r += t.mfe_r
                sum_mae_r += t.mae_r
                // -- Outcome anatomy (SL close). A trailed SL counts as a WIN
                //    (parity with sim_wins above, per spec). An untrailed SL is
                //    a true loss → binned by the trade's per-trade MFE (already
                //    in R): >= i_near_tp2 = hairline near-TP2 miss; [1.0, near)
                //    = reached TP1 then reversed; < 1.0 = straight to SL. Σ(4
                //    buckets) == sim_wins + sim_losses. Accrue hold time once. --
                if sl_was_trailed
                    n_win_tp2 += 1
                else if t.mfe_r >= i_near_tp2
                    n_loss_near += 1
                else if t.mfe_r >= 1.0
                    n_loss_aftertp1 += 1
                else
                    n_loss_straight += 1
                sum_hold_ms += time - t.open_time
                if opened_today
                    day_r_today   += r_realized
                    day_usd_today += usd_pnl
                    if sl_was_trailed
                        day_wins_today += 1
                    else
                        day_losses_today += 1
                if t.is_long
                    evt_close_long_sl  := true
                else
                    evt_close_short_sl := true
                sim_close_bar := bar_index
                closed_now    := true
            // -- SESSIONS band booking (display-only). One block, runs once per
            //    closed trade. close_bucket = the CLOSING bar's PHT time-of-day
            //    classified by session TIME WINDOWS ONLY (DoW enablement
            //    ignored), NY* merged: 0=Asia,1=London,2=NY,-1=OFF. Reuses the
            //    in_kz_* flags computed for THIS bar at the entry gate (time()
            //    membership; no DoW mask), same NYAM>London>NYLU>NYPM>Asia
            //    priority as the engine's session_now, then NY*→NY. --
            if closed_now
                int close_bucket = in_kz_nyam   ? 2 :
                  in_kz_london ? 1 :
                  in_kz_nylu   ? 2 :
                  in_kz_nypm   ? 2 :
                  in_kz_asia   ? 0 : -1
                // PHT calendar date of the close bar, for same-day comparison.
                int close_pht_date = year(time, "Asia/Manila") * 10000 +
                  month(time, "Asia/Manila") * 100 + dayofmonth(time, "Asia/Manila")
                bool same_day = not na(t.open_pht_date) and close_pht_date == t.open_pht_date
                bool overnight = not na(t.open_pht_date) and close_pht_date > t.open_pht_date
                eb = t.open_sess_bucket   // 0=Asia,1=London,2=NY,-1=off
                // Entry-quality counters (skip off-session entries: eb<0).
                if eb >= 0
                    array.set(ent_by_bucket, eb, array.get(ent_by_bucket, eb) + 1)
                    if was_win
                        array.set(ent_wins_by_bucket, eb, array.get(ent_wins_by_bucket, eb) + 1)
                // ENTRY BIAS SPLIT (display-only): classify the bias STATE at
                // entry vs trade direction. RANGE = bias was ranging; MATCHED =
                // long&bull or short&bear; COUNTER = wrong-way (only reachable
                // with the HTF gate off). Booked in the SAME bucket (eb) as the
                // entry-quality stats, with the SAME was_win attribution.
                if eb >= 0
                    bool ebs_is_range   = t.bias_at_open == "ranging"
                    bool ebs_is_matched = (t.is_long and t.bias_at_open == "bullish") or
                      (not t.is_long and t.bias_at_open == "bearish")
                    if ebs_is_range
                        array.set(ebs_range, eb, array.get(ebs_range, eb) + 1)
                        if was_win
                            array.set(ebs_range_w, eb, array.get(ebs_range_w, eb) + 1)
                    else if ebs_is_matched
                        array.set(ebs_match, eb, array.get(ebs_match, eb) + 1)
                        if was_win
                            array.set(ebs_match_w, eb, array.get(ebs_match_w, eb) + 1)
                    else
                        array.set(ebs_counter, eb, array.get(ebs_counter, eb) + 1)
                        if was_win
                            array.set(ebs_counter_w, eb, array.get(ebs_counter_w, eb) + 1)
                // Resolution path. "→ in X" requires same PHT day (Asia/London).
                // NY exception: "→ in NY" = close within 24h of open AND close
                // bucket == NY (the NY Lunch/PM windows fall on the next PHT
                // calendar day after an evening NY AM entry, so a strict same-day
                // rule would misclassify them). 86400000 ms = 24h.
                bool within_24h = (time - t.open_time) <= 86400000
                // Resolution path index (0..7), -1 = off-session entry. Nested
                // if (not a nested ternary) so the parser is never ambiguous.
                int path = -1
                if eb == 0          // Asia entry
                    path := same_day and close_bucket == 0 ? 0 :
                      same_day and close_bucket == 1 ? 1 : 2
                else if eb == 1     // London entry
                    path := same_day and close_bucket == 1 ? 3 :
                      same_day and close_bucket == 2 ? 4 : 5
                else if eb == 2     // NY entry (24h same-trading-day rule)
                    path := within_24h and close_bucket == 2 ? 6 : 7
                if path >= 0
                    array.set(path_n, path, array.get(path_n, path) + 1)
                    if was_win
                        array.set(path_w, path, array.get(path_w, path) + 1)
                // Hold-time split (wins vs losses).
                hold_ms = time - t.open_time
                if was_win
                    hold_ms_wins += hold_ms
                    n_hold_wins  += 1
                else
                    hold_ms_losses += hold_ms
                    n_hold_losses  += 1
                // Same-session close = closed in the SAME killzone bucket AND
                // same PHT day as entry (eb>=0 required; off-session entries
                // have no killzone to match).
                if eb >= 0 and same_day and close_bucket == eb
                    n_same_sess_close += 1
                // Overnight carry = close PHT date strictly after open PHT date.
                if overnight
                    n_overnight += 1
                // Day-of-week (ENTRY day) W/L. open_dow is Pine dayofweek
                // (1=Sun..7=Sat); Mon..Fri → slot 0..4 via (dow+5)%7, which is
                // 0..4 only for Mon..Fri (Sat=5, Sun=6 → skipped).
                int dslot = (t.open_dow + 5) % 7
                if dslot >= 0 and dslot <= 4
                    if was_win
                        array.set(dow_w, dslot, array.get(dow_w, dslot) + 1)
                    else
                        array.set(dow_l, dslot, array.get(dow_l, dslot) + 1)
            if closed_now
                array.remove(active_trades, idx)

    // -- Realized-equity drawdown update (raw points). Runs once per bar
    //    AFTER the close loop, so sim_total_usd already reflects every
    //    realized close on this bar. Peak = high-water mark of the
    //    cumulative curve; cur_dd = positive distance below peak;
    //    max_dd_pts = worst such distance seen. Display side multiplies
    //    by the lot multiplier. --
    dd_peak_pts := math.max(dd_peak_pts, sim_total_usd)
    cur_dd       = dd_peak_pts - sim_total_usd
    max_dd_pts  := math.max(max_dd_pts, cur_dd)

    // -- Determine "displayed" trade = most recently opened still active --
    int active_n = array.size(active_trades)
    Trade disp = active_n > 0 ? array.get(active_trades, active_n - 1) : na
    bool   d_long      = not na(disp) and disp.is_long
    bool   d_short     = not na(disp) and not disp.is_long
    float  d_entry     = not na(disp) ? disp.entry      : na
    float  d_sl        = not na(disp) ? disp.sl         : na
    float  d_tp1       = not na(disp) ? disp.tp1        : na
    float  d_tp2       = not na(disp) ? disp.tp2        : na
    float  d_tp3       = not na(disp) ? disp.tp3        : na
    float  d_eff_sl    = not na(disp) ? disp.eff_sl     : na
    float  d_eff_sl_r  = not na(disp) ? disp.eff_sl_r   : na
    bool   d_tp1_done  = not na(disp) and disp.tp1_done
    bool   d_tp2_done  = not na(disp) and disp.tp2_done
    bool   d_tp3_done  = not na(disp) and disp.tp3_done
    string d_bias_open = not na(disp) ? disp.bias_at_open : ""

    // -- Per-slot live entries for the LIVE TRADE band (display-only).
    //    active_trades is ordered oldest-first (index 0 = open order #1).
    //    Surface up to 3 slots' (entry, open_time) so the chart side can
    //    render one "Entry #N · hold" row per concurrent trade. na in slots
    //    beyond active_n. Engine untouched — read-only fetches. --
    float slot1_entry  = active_n > 0 ? array.get(active_trades, 0).entry     : na
    float slot2_entry  = active_n > 1 ? array.get(active_trades, 1).entry     : na
    float slot3_entry  = active_n > 2 ? array.get(active_trades, 2).entry     : na
    int   slot1_opentm = active_n > 0 ? array.get(active_trades, 0).open_time : na
    int   slot2_opentm = active_n > 1 ? array.get(active_trades, 1).open_time : na
    int   slot3_opentm = active_n > 2 ? array.get(active_trades, 2).open_time : na

    // -- SESSION BIAS: sum each session's 10-day queue into plain [3] arrays
    //    for render. Queue size IS the distinct-weekday count (0..10). --
    array<int> sb10_bull  = array.new<int>(3, 0)
    array<int> sb10_bear  = array.new<int>(3, 0)
    array<int> sb10_range = array.new<int>(3, 0)
    int sb10_days = array.size(q_daykey)
    if sb10_days > 0
        array.set(sb10_bull,  0, int(array.sum(qa_bull)))
        array.set(sb10_bear,  0, int(array.sum(qa_bear)))
        array.set(sb10_range, 0, int(array.sum(qa_range)))
        array.set(sb10_bull,  1, int(array.sum(ql_bull)))
        array.set(sb10_bear,  1, int(array.sum(ql_bear)))
        array.set(sb10_range, 1, int(array.sum(ql_range)))
        array.set(sb10_bull,  2, int(array.sum(qn_bull)))
        array.set(sb10_bear,  2, int(array.sum(qn_bear)))
        array.set(sb10_range, 2, int(array.sum(qn_range)))

    // -- Suppress WATCH visuals the engine could never act on while in-trade.
    //    Two impossible-add cases are nulled (display-only; engine untouched):
    //      (a) SAME-OB SAME-DIR: in-trade on the candidate OB — the add gate
    //          rejects it as SAME-OB (ob_already_held). watch_dir == active_dir.
    //      (b) IN-TRADE OPP-DIR: a position is open and the watch points the
    //          OTHER way (watch_dir != active_dir). The engine can't fire an
    //          opposite-direction add (add gate's OPP-DIR skip:
    //          (bull_setup and active_dir==-1) or (bear_setup and active_dir==1)),
    //          so a WATCH SELL line under a live BUY (or vice-versa) advertises
    //          an impossible trade. Reuses the engine's OWN ob_already_held /
    //          active_dir (no OB re-identification). Net rule while in-trade:
    //          watch visuals survive ONLY for a same-dir candidate on a NEW OB
    //          (ob_already_held false, watch_dir == active_dir). Flat (active_dir
    //          == 0) → both clauses false → unchanged. Nulls all five watch_* so
    //          the dashed line, every WATCH label, AND the GET-READY watch_*
    //          fallback go dark. The add gate's "READY (will fire)" excludes both
    //          SAME-OB and OPP-DIR, so add_ready_dir / the GET-READY add case are
    //          untouched. 2-space continuation. --
    suppress_same_ob  = ob_already_held and watch_dir != 0 and watch_dir == active_dir
    suppress_oppdir   = active_dir != 0 and watch_dir != 0 and watch_dir != active_dir
    if suppress_same_ob or suppress_oppdir
        watch_entry_px := na
        watch_dir      := 0
        watch_sl_px    := na
        watch_tp1_px   := na
        watch_tp2_px   := na
    // -- Build return UDT --
    SigState s = SigState.new()
    s.bull_setup       := bull_setup
    s.bear_setup       := bear_setup
    s.bull_forming     := bull_forming
    s.bear_forming     := bear_forming
    s.watch_entry_px   := watch_entry_px
    s.watch_dir        := watch_dir
    s.watch_sl_px      := watch_sl_px
    s.watch_tp1_px     := watch_tp1_px
    s.watch_tp2_px     := watch_tp2_px
    s.setup_entry_px   := setup_entry_px
    s.setup_dir        := setup_dir
    s.setup_sl_px      := setup_sl_px
    s.setup_tp1_px     := setup_tp1_px
    s.setup_tp2_px     := setup_tp2_px
    s.sim_long         := d_long
    s.sim_short        := d_short
    s.sim_entry        := d_entry
    s.sim_sl           := d_sl
    s.sim_tp1          := d_tp1
    s.sim_tp2          := d_tp2
    s.sim_tp3          := d_tp3
    s.sim_eff_sl       := d_eff_sl
    s.sim_eff_sl_r     := d_eff_sl_r
    s.sim_tp1_done     := d_tp1_done
    s.sim_tp2_done     := d_tp2_done
    s.sim_tp3_done     := d_tp3_done
    s.active_count     := active_n
    s.slot1_entry      := slot1_entry
    s.slot2_entry      := slot2_entry
    s.slot3_entry      := slot3_entry
    s.slot1_opentm     := slot1_opentm
    s.slot2_opentm     := slot2_opentm
    s.slot3_opentm     := slot3_opentm
    s.sim_count        := sim_count
    s.sim_wins         := sim_wins
    s.sim_losses       := sim_losses
    s.sim_total_r      := sim_total_r
    s.sim_total_usd    := sim_total_usd
    s.max_dd_pts       := max_dd_pts
    s.gross_win_r      := gross_win_r
    s.gross_loss_r     := gross_loss_r
    s.max_loss_streak  := max_loss_streak
    s.max_win_streak   := max_win_streak
    s.cur_win_streak   := cur_win_streak
    s.cur_loss_streak  := cur_loss_streak
    s.sum_spread_r     := sum_spread_r
    s.sum_mfe_r        := sum_mfe_r
    s.sum_mae_r        := sum_mae_r
    s.n_win_tp2        := n_win_tp2
    s.n_loss_near      := n_loss_near
    s.n_loss_aftertp1  := n_loss_aftertp1
    s.n_loss_straight  := n_loss_straight
    s.n_win_tp1_be_tp2 := n_win_tp1_be_tp2
    s.sum_hold_ms      := sum_hold_ms
    s.day_r_today      := day_r_today
    s.day_usd_today    := day_usd_today
    s.day_wins_today   := day_wins_today
    s.day_losses_today := day_losses_today
    s.day_opens_today  := day_opens_today
    s.sim_first_time   := sim_first_time
    s.sim_last_time    := sim_last_time
    s.num_trading_days := num_trading_days
    s.h1_bull             := h1_bull
    s.h1_bear             := h1_bear
    s.h1_bias_s           := h1_bias_s
    s.disp_bias_at_open   := d_bias_open
    s.session_now         := session_now
    s.in_date_range    := in_date_range
    s.in_session       := in_session
    s.cooldown_ok      := cooldown_ok
    s.add_reason_s     := add_reason
    s.add_ready_dir    := add_ready_dir
    s.last_add_skip_s  := last_add_skip
    // PRE-ENTRY CHECKLIST packed into one array<float> (index constants CHK_*).
    // Bools → 1.0/0.0; na-able numerics keep na. Semantics unchanged.
    array<float> chk_pack = array.new<float>(18, na)
    array.set(chk_pack, CHK_CAND_DIR,      cand_dir)
    array.set(chk_pack, CHK_KILLZONE,      in_session        ? 1.0 : 0.0)
    array.set(chk_pack, CHK_HTF_OK,        chk_htf_ok        ? 1.0 : 0.0)
    array.set(chk_pack, CHK_BOS_ACTIVE,    chk_bos_active    ? 1.0 : 0.0)
    array.set(chk_pack, CHK_BOS_AGE,       chk_bos_age)
    array.set(chk_pack, CHK_OB,            chk_ob            ? 1.0 : 0.0)
    array.set(chk_pack, CHK_OB_EDGE,       chk_ob_edge)
    array.set(chk_pack, CHK_PRICE_AT_OB,   chk_price_at_ob   ? 1.0 : 0.0)
    array.set(chk_pack, CHK_DIST_ATR,      chk_dist_atr)
    array.set(chk_pack, CHK_COOLDOWN,      chk_cooldown      ? 1.0 : 0.0)
    array.set(chk_pack, CHK_COOL_LEFT,     chk_cool_left)
    array.set(chk_pack, CHK_MINSL_OK,      chk_minsl_ok      ? 1.0 : 0.0)
    array.set(chk_pack, CHK_MINSL_DIST,    chk_minsl_dist)
    array.set(chk_pack, CHK_SLOT_FREE,     chk_slot_free     ? 1.0 : 0.0)
    array.set(chk_pack, CHK_FRESH_OB,      chk_fresh_ob      ? 1.0 : 0.0)
    array.set(chk_pack, CHK_DAY_TRADES_OK, chk_day_trades_ok ? 1.0 : 0.0)
    array.set(chk_pack, CHK_DAY_LOSS_OK,   chk_day_loss_ok   ? 1.0 : 0.0)
    array.set(chk_pack, CHK_DAY_OPENS,     day_opens_today)
    s.chk_pack          := chk_pack
    s.evt_open_long       := evt_open_long
    s.evt_open_short      := evt_open_short
    s.evt_open_ob_bar     := evt_open_ob_bar
    s.evt_tp1             := evt_tp1
    s.evt_tp2             := evt_tp2
    s.evt_tp3             := evt_tp3
    s.evt_close_long_tp   := evt_close_long_tp
    s.evt_close_long_sl   := evt_close_long_sl
    s.evt_close_short_tp  := evt_close_short_tp
    s.evt_close_short_sl  := evt_close_short_sl
    s.evt_trail_step      := evt_trail_step
    s.smc_bos_bull        := smc_bos_bull
    s.smc_bos_bear        := smc_bos_bear
    s.smc_choch           := smc_choch
    s.smc_bos_level       := smc_bos_level
    s.smc_bos_from        := smc_bos_from
    s.smc_ob_new          := smc_ob_new
    s.smc_ob_demand       := smc_ob_demand
    s.smc_ob_high         := smc_ob_high
    s.smc_ob_low          := smc_ob_low
    s.smc_ob_from         := smc_ob_from
    s.smc_ob_atr          := atr_val
    s.r_by_sess           := r_by_sess
    s.n_by_sess           := n_by_sess
    s.r_by_dow            := r_by_dow
    s.n_by_dow            := n_by_dow
    s.ent_by_bucket       := ent_by_bucket
    s.ent_wins_by_bucket  := ent_wins_by_bucket
    s.path_n              := path_n
    s.path_w              := path_w
    s.hold_ms_wins        := hold_ms_wins
    s.hold_ms_losses      := hold_ms_losses
    s.n_hold_wins         := n_hold_wins
    s.n_hold_losses       := n_hold_losses
    s.n_same_sess_close   := n_same_sess_close
    s.n_overnight         := n_overnight
    s.dow_w               := dow_w
    s.dow_l               := dow_l
    s.sb_bull             := sb_bull
    s.sb_bear             := sb_bear
    s.sb_range            := sb_range
    s.sb10_bull           := sb10_bull
    s.sb10_bear           := sb10_bear
    s.sb10_range          := sb10_range
    s.sb10_days           := sb10_days
    s.ebs_match           := ebs_match
    s.ebs_match_w         := ebs_match_w
    s.ebs_range           := ebs_range
    s.ebs_range_w         := ebs_range_w
    s.ebs_counter         := ebs_counter
    s.ebs_counter_w       := ebs_counter_w
    s

// =====================================================================
// COMPUTE SIGNAL STATE on the chart's timeframe directly.
// =====================================================================
SigState st = compute_sig_state()

// =====================================================================
// UNPACK
// =====================================================================
bull_setup       = st.bull_setup
bear_setup       = st.bear_setup
bull_forming     = st.bull_forming
bear_forming     = st.bear_forming
watch_entry_px   = st.watch_entry_px
watch_dir        = st.watch_dir
watch_sl_px      = st.watch_sl_px
watch_tp1_px     = st.watch_tp1_px
watch_tp2_px     = st.watch_tp2_px
setup_entry_px   = st.setup_entry_px
setup_dir        = st.setup_dir
setup_sl_px      = st.setup_sl_px
setup_tp1_px     = st.setup_tp1_px
setup_tp2_px     = st.setup_tp2_px
sim_long         = st.sim_long
sim_short        = st.sim_short
sim_entry        = st.sim_entry
sim_sl           = st.sim_sl
sim_tp1          = st.sim_tp1
sim_tp2          = st.sim_tp2
sim_tp3          = st.sim_tp3
sim_eff_sl       = st.sim_eff_sl
sim_eff_sl_r     = st.sim_eff_sl_r
sim_tp1_done     = st.sim_tp1_done
sim_tp2_done     = st.sim_tp2_done
sim_tp3_done     = st.sim_tp3_done
active_count     = st.active_count
slot1_entry      = st.slot1_entry
slot2_entry      = st.slot2_entry
slot3_entry      = st.slot3_entry
slot1_opentm     = st.slot1_opentm
slot2_opentm     = st.slot2_opentm
slot3_opentm     = st.slot3_opentm
sim_count        = st.sim_count
sim_wins         = st.sim_wins
sim_losses       = st.sim_losses
sim_total_r      = st.sim_total_r
sim_total_usd    = st.sim_total_usd
max_dd_pts       = st.max_dd_pts
gross_win_r      = st.gross_win_r
gross_loss_r     = st.gross_loss_r
max_loss_streak  = st.max_loss_streak
max_win_streak   = st.max_win_streak
cur_win_streak   = st.cur_win_streak
cur_loss_streak  = st.cur_loss_streak
sum_spread_r     = st.sum_spread_r
sum_mfe_r        = st.sum_mfe_r
sum_mae_r        = st.sum_mae_r
n_win_tp2        = st.n_win_tp2
n_loss_near      = st.n_loss_near
n_loss_aftertp1  = st.n_loss_aftertp1
n_loss_straight  = st.n_loss_straight
n_win_tp1_be_tp2 = st.n_win_tp1_be_tp2
sum_hold_ms      = st.sum_hold_ms
day_r_now        = st.day_r_today
day_usd_now      = st.day_usd_today
day_wins_now     = st.day_wins_today
day_losses_now   = st.day_losses_today
day_opens_now    = st.day_opens_today
sim_first_time   = st.sim_first_time
sim_last_time    = st.sim_last_time
num_trading_days = st.num_trading_days
day_count_now    = day_wins_now + day_losses_now
h1_bull          = st.h1_bull
h1_bear          = st.h1_bear
h1_bias_s        = st.h1_bias_s
bias_at_open     = st.disp_bias_at_open
session_now      = st.session_now
in_date_range    = st.in_date_range
in_session       = st.in_session
cooldown_ok      = st.cooldown_ok
add_reason_s     = st.add_reason_s
add_ready_dir    = st.add_ready_dir
last_add_skip_s  = st.last_add_skip_s
// PRE-ENTRY CHECKLIST: unpack the packed array<float> back into the SAME plain
// chart-scope names/types the table renderer consumes. Bools = (x == 1.0);
// na-able numerics keep na. Index constants CHK_* defined after the SigState UDT.
chk_cand_dir     = int(array.get(st.chk_pack, CHK_CAND_DIR))
chk_killzone     = array.get(st.chk_pack, CHK_KILLZONE)      == 1.0
chk_htf_ok       = array.get(st.chk_pack, CHK_HTF_OK)        == 1.0
chk_bos_active   = array.get(st.chk_pack, CHK_BOS_ACTIVE)    == 1.0
chk_bos_age      = int(array.get(st.chk_pack, CHK_BOS_AGE))
chk_ob           = array.get(st.chk_pack, CHK_OB)            == 1.0
chk_ob_edge      = array.get(st.chk_pack, CHK_OB_EDGE)
chk_price_at_ob  = array.get(st.chk_pack, CHK_PRICE_AT_OB)   == 1.0
chk_dist_atr     = array.get(st.chk_pack, CHK_DIST_ATR)
chk_cooldown     = array.get(st.chk_pack, CHK_COOLDOWN)      == 1.0
chk_cool_left    = int(array.get(st.chk_pack, CHK_COOL_LEFT))
chk_minsl_ok     = array.get(st.chk_pack, CHK_MINSL_OK)      == 1.0
chk_minsl_dist   = array.get(st.chk_pack, CHK_MINSL_DIST)
chk_slot_free    = array.get(st.chk_pack, CHK_SLOT_FREE)     == 1.0
chk_fresh_ob     = array.get(st.chk_pack, CHK_FRESH_OB)      == 1.0
chk_day_trades_ok = array.get(st.chk_pack, CHK_DAY_TRADES_OK) == 1.0
chk_day_loss_ok  = array.get(st.chk_pack, CHK_DAY_LOSS_OK)   == 1.0
chk_day_opens    = int(array.get(st.chk_pack, CHK_DAY_OPENS))

// Event flags drive all chart-side transitions. With multi-position, bar
// transitions on sim_long/sim_short would miss back-to-back same-direction
// opens, so we rely on these flags from the sig-TF function instead.
just_opened_long   = st.evt_open_long
just_opened_short  = st.evt_open_short
just_opened_ob_bar = st.evt_open_ob_bar
just_hit_tp1       = st.evt_tp1
just_hit_tp2       = st.evt_tp2
just_hit_tp3       = st.evt_tp3
closed_by_tp_long  = st.evt_close_long_tp
closed_by_sl_long  = st.evt_close_long_sl
closed_by_tp_short = st.evt_close_short_tp
closed_by_sl_short = st.evt_close_short_sl
just_closed_long   = closed_by_tp_long  or closed_by_sl_long
just_closed_short  = closed_by_tp_short or closed_by_sl_short

// =====================================================================
// SETUP-state derivation — single source of truth for the "GET READY"
// label and the SETUP alert. This reproduces the EXACT precedence of the
// status-table State switch (see ~"SETUP · BUY"/"SETUP · SELL" cases):
// the State only reads SETUP when active_count == 0 AND every gate is
// green (date / session / cooldown / day-loss / day-max) AND the engine's
// bull_setup / bear_setup flag is set. No parallel re-derivation — these
// booleans ARE the State row's SETUP cases, hoisted out so the visual and
// the alert bind to precisely the same condition. Computed every bar
// (confirmed-bar safe); the transition flag below fires once on entry.
// =====================================================================
gates_green      = active_count == 0 and in_date_range and in_session and cooldown_ok and
  not (i_max_day_loss_r > 0 and day_r_now <= -i_max_day_loss_r) and
  not (i_max_day_trades > 0 and day_opens_now >= i_max_day_trades)
state_setup_buy  = gates_green and bull_setup
state_setup_sell = gates_green and bear_setup
state_is_setup   = state_setup_buy or state_setup_sell

// ADD-READY surface — the in-trade analogue of the flat SETUP state. Bound to
// add_ready_dir, which the engine sets ONLY when the panel's "Add #N" row reads
// "READY (will fire)" (slot free, same-dir setup at OB, gates green). The GET
// READY label and the SETUP alert extend onto these so an imminent ADD lights
// up the same way a flat entry does. Display-only; engine untouched.
add_ready_buy    = add_ready_dir == 1
add_ready_sell   = add_ready_dir == -1
add_is_ready     = add_ready_dir != 0

// =====================================================================
// PRE-OPEN GET READY surface (DISPLAY-ONLY — engine untouched).
// User case: every gate green EXCEPT the killzone, and an enabled session
// opens in a few minutes. The normal SETUP state can't fire (gates_green
// requires in_session), so the label would stay hidden until the bell.
// This synthesises an early SHOW for that exact case:
//   • NOT currently in_session (the lone failing gate),
//   • a candidate flat setup is fully formed — bull_setup/bear_setup are the
//     engine flags and DO NOT embed session (have_ob && near && htf_ok), so
//     they already encode BOS-active + OB-anchored + price-in-proximity + HTF,
//   • every OTHER firing gate green: no live position, date range, cooldown,
//     day-loss, day-max (= gates_green WITHOUT its in_session leg),
//   • the soonest ENABLED+DoW-passing killzone START is ≤ i_preopen_mins away.
// minutes-to-open is computed per enabled session by preopen_mins_for() and
// the soonest taken. Pre-open is a flat-entry concept only (no ADD: an ADD
// needs a live position, but we require active_count==0 here). When the
// session actually opens, in_session flips true and this hands off cleanly to
// the normal state_is_setup SHOW.
// =====================================================================
gates_green_nosess = active_count == 0 and in_date_range and cooldown_ok and
  not (i_max_day_loss_r > 0 and day_r_now <= -i_max_day_loss_r) and
  not (i_max_day_trades > 0 and day_opens_now >= i_max_day_trades)
// Soonest enabled-killzone open within the look-ahead (na = none). Only worth
// computing on the last bar (it's a live aid keyed off timenow). Each session's
// own DoW filter gates the day the open lands on — inert (all-DoW-off) sessions
// never qualify. Master session toggle off (i_use_sessions false) ⇒ no
// killzone gate at all ⇒ no pre-open concept, so suppress.
float minutes_to_open = na
string preopen_sess   = ""
if barstate.islast and i_preopen_mins > 0 and i_use_sessions
    m_asia   = preopen_mins_for(i_use_asia,   i_asia_sess,   i_kz_tz, i_preopen_mins,
       i_asia_dow_mon, i_asia_dow_tue, i_asia_dow_wed, i_asia_dow_thu, i_asia_dow_fri, i_asia_dow_sat, i_asia_dow_sun)
    m_london = preopen_mins_for(i_use_london, i_london_sess, i_kz_tz, i_preopen_mins,
       i_london_dow_mon, i_london_dow_tue, i_london_dow_wed, i_london_dow_thu, i_london_dow_fri, i_london_dow_sat, i_london_dow_sun)
    m_nyam   = preopen_mins_for(i_use_nyam,   i_nyam_sess,   i_kz_tz, i_preopen_mins,
       i_nyam_dow_mon, i_nyam_dow_tue, i_nyam_dow_wed, i_nyam_dow_thu, i_nyam_dow_fri, i_nyam_dow_sat, i_nyam_dow_sun)
    m_nylu   = preopen_mins_for(i_use_nylu,   i_nylu_sess,   i_kz_tz, i_preopen_mins,
       i_nylu_dow_mon, i_nylu_dow_tue, i_nylu_dow_wed, i_nylu_dow_thu, i_nylu_dow_fri, i_nylu_dow_sat, i_nylu_dow_sun)
    m_nypm   = preopen_mins_for(i_use_nypm,   i_nypm_sess,   i_kz_tz, i_preopen_mins,
       i_nypm_dow_mon, i_nypm_dow_tue, i_nypm_dow_wed, i_nypm_dow_thu, i_nypm_dow_fri, i_nypm_dow_sat, i_nypm_dow_sun)
    // Reduce to the soonest, carrying that session's display name alongside.
    if not na(m_asia)
        minutes_to_open := m_asia
        preopen_sess    := i_asia_txt
    if not na(m_london) and (na(minutes_to_open) or m_london < minutes_to_open)
        minutes_to_open := m_london
        preopen_sess    := i_london_txt
    if not na(m_nyam) and (na(minutes_to_open) or m_nyam < minutes_to_open)
        minutes_to_open := m_nyam
        preopen_sess    := i_nyam_txt
    if not na(m_nylu) and (na(minutes_to_open) or m_nylu < minutes_to_open)
        minutes_to_open := m_nylu
        preopen_sess    := i_nylu_txt
    if not na(m_nypm) and (na(minutes_to_open) or m_nypm < minutes_to_open)
        minutes_to_open := m_nypm
        preopen_sess    := i_nypm_txt
// The pre-open SHOW: out-of-session, a full flat candidate setup, all other
// firing gates green, and an enabled killzone opening within the window.
preopen_show = not in_session and gates_green_nosess and (bull_setup or bear_setup) and not na(minutes_to_open)
preopen_buy  = preopen_show and bull_setup
// Whole-minute countdown for the headline (ceil so "0m" only shows at the bell).
preopen_mins_disp = na(minutes_to_open) ? 0 : int(math.ceil(minutes_to_open))

// =====================================================================
// GET READY display hysteresis (DISPLAY-ONLY — engine untouched).
// The firing engine still uses the sacred 0.4-ATR proximity rule; nothing
// below is read by compute_sig_state(). Problem solved here: as price
// oscillates around the 0.4-ATR entry boundary, state_is_setup / add_is_ready
// flicker WATCH↔SETUP every bar, the label blinks, and the imminent alert
// re-fires on each re-entry. This adds a Schmitt-trigger so the label SHOWS at
// 0.4 ATR but only HIDES past i_ready_release ATR.
//
// States (chart-side, plain var — no engine reads):
//   SHOW  : ready_show — the real engine condition (price within 0.4 ATR).
//   HOLD  : was visible, ready_show now false, BUT distance ≤ i_ready_release
//           AND the setup is otherwise alive (every gate except proximity still
//           green: candidate-dir BOS active, OB anchored, HTF ok, killzone open,
//           in date range, gates_green). Rendered dimmed with "(near)".
//   HIDE  : distance > i_ready_release, OR the setup hard-dies (BOS gone, OB
//           aged/replaced so chk_ob false, killzone closed, slot taken so
//           active_count breaks gates_green / add_is_ready, trade fired), OR no
//           candidate direction. Clears the label + RR boxes.
//
// The distance reused is chk_dist_atr (candidate-direction OB-edge distance in
// ATR, already computed in the engine's pre-entry checklist — see compute_sig
// state). Not re-derived here.
// =====================================================================
// "Setup otherwise alive" — the same gate set the engine would need to fire,
// MINUS proximity. When this holds and ready_show is false, the ONLY missing
// leg is price being inside 0.4 ATR.
ready_setup_alive = chk_cand_dir != 0 and chk_bos_active and chk_ob and chk_htf_ok and
  chk_killzone and in_date_range and gates_green
// Within the release band? chk_dist_atr is na when no OB anchored → treat as
// out-of-band (forces HIDE). i_ready_release is clamped ≥ 0.4 = the show edge.
ready_in_release = not na(chk_dist_atr) and chk_dist_atr <= i_ready_release
// SHOW = the live in-session SETUP/ADD condition, OR the pre-open look-ahead
// (out-of-session flat candidate, gates green, killzone opening soon). Pre-open
// carries no HOLD of its own (ready_setup_alive requires chk_killzone, false
// pre-open) — it simply hands off to state_is_setup once the bell rings.
ready_show       = state_is_setup or add_is_ready or preopen_show
var bool ready_was_visible = false
// HOLD only when we were already visible last bar, the engine condition just
// dropped, we're still inside the release band, and the setup is otherwise
// alive (proximity is the lone failed gate).
ready_hold       = ready_was_visible and not ready_show and ready_in_release and ready_setup_alive
ready_visible    = ready_show or ready_hold
// Alert arming: SHOW is entered from a non-visible state (full HIDE) only —
// NOT from HOLD. So one imminent-approach alert per genuine approach, re-armed
// only after the label fully disappears.
ready_show_entered = ready_show and not ready_was_visible

// =====================================================================
// ALERTS (alert() — multiplexed through ONE TradingView alert slot)
// Create a single alert on this indicator with condition
// "Any alert() function call". Each event below fires only when its
// sub-toggle and event flag are true. alert.freq_once_per_bar_close
// matches the confirmed-bar sim — no intrabar spam, no repaint. These
// run every confirmed bar (NOT gated by barstate.islast).
// =====================================================================
var float prev_watch = na
var int   prev_dir   = 0

if i_alerts_on
    // -- Entry: a sim trade actually opened this confirmed bar --
    if i_alert_entry and (just_opened_long or just_opened_short)
        a_dir = just_opened_long ? "BUY" : "SELL"
        a_msg = "BG 15m SETUP " + a_dir + " " + syminfo.ticker + " " + timeframe.period +
          " @ " + str.tostring(sim_entry, format.mintick) +
          " | SL " + str.tostring(sim_sl, format.mintick) +
          " | TP1 " + str.tostring(sim_tp1, format.mintick) +
          " TP2 " + str.tostring(sim_tp2, format.mintick)
        alert(a_msg, alert.freq_once_per_bar_close)
    // -- Watch: fire only when a NEW watch level/direction appears, so the
    //    heads-up doesn't repeat every forming bar. --
    if i_alert_watch and not na(watch_entry_px) and watch_dir != 0 and (na(prev_watch) or watch_dir != prev_dir)
        w_dir = watch_dir == 1 ? "BUY" : "SELL"
        w_msg = "BG 15m WATCH " + w_dir + " " + syminfo.ticker + " " + timeframe.period +
          " — waiting @ " + str.tostring(watch_entry_px, format.mintick)
        alert(w_msg, alert.freq_once_per_bar_close)
    // -- Setup / Add imminent: fire ONCE on transition into the SHOW state of
    //    the GET READY label (price reached 0.4-ATR proximity, gates green).
    //    ready_show_entered is the hysteresis rising edge — it fires only when
    //    SHOW is entered from a full HIDE, NOT when the label was merely HOLDing
    //    (dimmed/near). So price chopping across the 0.4-ATR boundary no longer
    //    re-arms the alert; one alert per genuine approach. SETUP and ADD share
    //    the i_alert_setup slot (mutually exclusive: SETUP needs active_count==0,
    //    ADD needs a live position). Message variant picks the right wording. --
    //    The PRE-OPEN look-ahead also rides this slot: when SHOW is entered out
    //    of session (killzone imminent), the message says "<Session> opens in
    //    Xm" instead. Same rising-edge gate ⇒ same one-per-approach re-arm.
    if i_alert_setup and ready_show_entered
        s_preopen = not state_is_setup and not add_is_ready and preopen_show
        s_is_add  = not state_is_setup and add_is_ready
        s_dir     = (s_preopen ? preopen_buy : s_is_add ? add_ready_buy : state_setup_buy) ? "BUY" : "SELL"
        s_ent     = not na(setup_entry_px) ? setup_entry_px : watch_entry_px
        s_msg     = s_preopen ?
          ("BG SMC: GET READY " + s_dir + " — all gates green, " + preopen_sess +
           " opens in " + str.tostring(preopen_mins_disp) + "m " +
           syminfo.ticker + " " + timeframe.period +
           (na(s_ent) ? "" : " | entry ~" + str.tostring(s_ent, format.mintick))) :
          s_is_add ?
          ("BG SMC: ADD " + s_dir + " imminent — price at OB, slot free " +
           syminfo.ticker + " " + timeframe.period +
           (na(s_ent) ? "" : " | entry ~" + str.tostring(s_ent, format.mintick))) :
          ("BG SMC: SETUP " + s_dir + " — price at OB, signal imminent " +
           syminfo.ticker + " " + timeframe.period +
           (na(s_ent) ? "" : " | entry " + str.tostring(s_ent, format.mintick)))
        alert(s_msg, alert.freq_once_per_bar_close)
    // -- Exit: any open trade hit a take-profit or stop this bar --
    if i_alert_exit and (closed_by_tp_long or closed_by_sl_long or closed_by_tp_short or closed_by_sl_short)
        x_dir   = (closed_by_tp_long or closed_by_sl_long) ? "LONG" : "SHORT"
        x_kind  = (closed_by_tp_long or closed_by_tp_short) ? "TP" : "SL"
        x_which = just_hit_tp3 ? " (TP3)" : just_hit_tp2 ? " (TP2)" : just_hit_tp1 ? " (TP1)" : ""
        x_msg   = "BG 15m EXIT " + x_dir + " " + x_kind + x_which + " " +
          syminfo.ticker + " " + timeframe.period
        alert(x_msg, alert.freq_once_per_bar_close)

// Track watch level/dir for next-bar new-watch detection (every bar).
prev_watch := watch_entry_px
prev_dir   := watch_dir
// Track GET READY label visibility (SHOW or HOLD) for next-bar hysteresis: the
// HOLD branch needs "was visible last bar", and ready_show_entered needs "was
// NOT visible last bar" to gate the imminent alert to one fire per approach.
// Updated EVERY bar (not just barstate.islast) so the latch is correct on the
// last bar even though the label itself only renders there.
ready_was_visible := ready_visible

// SMC visual fields (BG-driven; consumed by the SMC drawing section below).
smc_bos_bull  = st.smc_bos_bull
smc_bos_bear  = st.smc_bos_bear
smc_choch     = st.smc_choch
smc_bos_level = st.smc_bos_level
smc_bos_from  = st.smc_bos_from
smc_ob_new    = st.smc_ob_new
smc_ob_demand = st.smc_ob_demand
smc_ob_high   = st.smc_ob_high
smc_ob_low    = st.smc_ob_low
smc_ob_from   = st.smc_ob_from
smc_ob_atr    = st.smc_ob_atr

// Session / weekday R-breakdown buckets (consumed by the breakdown panel).
r_by_sess = st.r_by_sess
n_by_sess = st.n_by_sess
r_by_dow  = st.r_by_dow
n_by_dow  = st.n_by_dow

// SESSIONS-band counters (consumed by the status-table SESSIONS band).
ent_by_bucket      = st.ent_by_bucket
ent_wins_by_bucket = st.ent_wins_by_bucket
sess_path_n        = st.path_n
sess_path_w        = st.path_w
hold_ms_wins       = st.hold_ms_wins
hold_ms_losses     = st.hold_ms_losses
n_hold_wins        = st.n_hold_wins
n_hold_losses      = st.n_hold_losses
n_same_sess_close  = st.n_same_sess_close
n_overnight        = st.n_overnight
sess_dow_w         = st.dow_w
sess_dow_l         = st.dow_l

// SESSION BIAS + ENTRY BIAS SPLIT (display-only; consumed by the LEFT pair).
sb_bull            = st.sb_bull
sb_bear            = st.sb_bear
sb_range           = st.sb_range
sb10_bull          = st.sb10_bull
sb10_bear          = st.sb10_bear
sb10_range         = st.sb10_range
sb10_days          = st.sb10_days
ebs_match          = st.ebs_match
ebs_match_w        = st.ebs_match_w
ebs_range          = st.ebs_range
ebs_range_w        = st.ebs_range_w
ebs_counter        = st.ebs_counter
ebs_counter_w      = st.ebs_counter_w

// =====================================================================
// CHART-SIDE DERIVATIONS — final-TP display
// =====================================================================
tp3_is_final = i_use_tp3 and not i_move_tp2
tp2_is_final = not i_use_tp3 and i_use_tp2
tp1_is_final = not i_use_tp3 and not i_use_tp2

final_tp_price = tp3_is_final ? sim_tp3 :
  tp2_is_final ? sim_tp2 :
  tp1_is_final ? sim_tp1 : sim_tp3
final_tp_lbl   = tp3_is_final ? "TP3" :
  tp2_is_final ? "TP2" :
  tp1_is_final ? "TP1" : "TP3 · ride"

// =====================================================================
// SIGNAL DRAWINGS — Buy/Sell labels, SL/TP lines, fill markers
// =====================================================================
if just_opened_long
    label.new(bar_index, low, "Buy @ " + str.tostring(sim_entry, format.mintick),
              yloc      = yloc.belowbar,
              textcolor = i_col_text,
              color     = i_col_buy,
              style     = label.style_label_up,
              size      = size.small)

if just_opened_short
    label.new(bar_index, high, "Sell @ " + str.tostring(sim_entry, format.mintick),
              yloc      = yloc.abovebar,
              textcolor = i_col_text,
              color     = i_col_sell,
              style     = label.style_label_down,
              size      = size.small)

// Per-trade drawings. Singleton vars hold the LATEST opened active
// trade's lines/chips. The latest trade's chips track the chart's right
// edge for live read-off; when a new trade opens, the previous trade's
// chips get SNAPPED BACK to their entry-bar position (so they don't pile
// up at the right edge as a confusing mid-chart cluster) and the new
// trade takes over right-edge tracking. Horizontal lines are similarly
// frozen at the previous trade's last-extended bar.
//
// Each trade ends up with chips visible near its own entry candle,
// spaced apart on the x-axis by trade-entry bar — no overlap, no
// orphaned chips floating mid-chart.
var int   prev_entry_bar = na
var line  ln_v_tp = na
var line  ln_v_sl = na
var line  ln_h_sl  = na
var line  ln_h_tp1 = na
var line  ln_h_tp2 = na
var line  ln_h_tp3 = na
var label lbl_sl  = na
var label lbl_tp1 = na
var label lbl_tp2 = na
var label lbl_tp3 = na

// Persistent live-trade RR zone boxes. Unlike the per-entry chips above,
// these reused boxes mirror the pre-entry GET READY / WATCH RR boxes but
// span the OPEN trade: left edge pinned at the entry bar, geometry STATIC
// (original entry / original SL / final-TP — does NOT follow the trailing
// SL), right edge = entry bar + avg WINNING-trade hold in bars. Created on
// open, right edge refreshed each live bar, deleted on close. Dedicated
// handles so their lifecycle never collides with watch_rr_*/setup_rr_*.
var box live_rr_tp_box   = na   // GREEN reward: entry → final TP
var box live_rr_sl_box   = na   // RED risk:    entry → original SL
var int live_rr_entry_bar = na  // entry bar = box left edge
var float live_rr_entry_px = na // captured entry price (static box edge)
var float live_rr_sl_px    = na // captured ORIGINAL SL (static box edge)
var float live_rr_tp_px    = na // captured final-TP price (static box edge)

if just_opened_long or just_opened_short
    // Snap the previous trade's chips back to its entry-bar offset so
    // they sit near that trade's entry candle as a clean historical
    // marker — instead of getting stranded mid-chart at wherever the
    // right-edge tracking last left them.
    if not na(prev_entry_bar)
        if not na(lbl_sl)
            label.set_x(lbl_sl,  prev_entry_bar + i_lbl_off)
        if not na(lbl_tp1)
            label.set_x(lbl_tp1, prev_entry_bar + i_lbl_off)
        if not na(lbl_tp2)
            label.set_x(lbl_tp2, prev_entry_bar + i_lbl_off)
        if not na(lbl_tp3)
            label.set_x(lbl_tp3, prev_entry_bar + i_lbl_off)
    prev_entry_bar := bar_index

    // Vertical dashed entry lines (entry → TP, entry → SL). Per-entry
    // historical markers — not deleted on subsequent entries.
    ln_v_tp := line.new(bar_index, sim_entry, bar_index, final_tp_price,
                         color = i_col_buy,  style = line.style_dashed, width = 1)
    ln_v_sl := line.new(bar_index, sim_entry, bar_index, sim_sl,
                         color = i_col_sell, style = line.style_dashed, width = 1)

    // Horizontal SL/TP lines — extend from entry bar; x2 updates each
    // bar while trade is active (block below), freezes at close.
    ln_h_sl  := line.new(bar_index, sim_eff_sl, bar_index + 1, sim_eff_sl,
                          color = i_col_sell, width = 2)
    ln_h_tp1 := line.new(bar_index, sim_tp1, bar_index + 1, sim_tp1,
                          color = i_col_buy,  width = 1)
    ln_h_tp2 := i_use_tp2 ? line.new(bar_index, sim_tp2, bar_index + 1, sim_tp2,
                          color = i_col_buy,  width = 1) : na
    ln_h_tp3 := i_use_tp3 ? line.new(bar_index, sim_tp3, bar_index + 1, sim_tp3,
                          color = i_col_buy,  width = 1) : na

    // Right-edge chips for live read-off.
    lbl_sl  := label.new(bar_index + i_lbl_off, sim_sl,
                          "SL " + str.tostring(sim_sl, format.mintick),
                          style = label.style_label_left, color = color.new(i_col_sell, 50),
                          textcolor = i_col_text, size = size.small)
    lbl_tp1 := label.new(bar_index + i_lbl_off, sim_tp1,
                          "TP1 " + str.tostring(sim_tp1, format.mintick),
                          style = label.style_label_left, color = color.new(i_col_buy, 50),
                          textcolor = i_col_text, size = size.small)
    lbl_tp2 := i_use_tp2 ? label.new(bar_index + i_lbl_off, sim_tp2,
                          "TP2 " + str.tostring(sim_tp2, format.mintick),
                          style = label.style_label_left, color = color.new(i_col_buy, 50),
                          textcolor = i_col_text, size = size.small) : na
    lbl_tp3 := i_use_tp3 ? label.new(bar_index + i_lbl_off, sim_tp3,
                          "TP3 " + str.tostring(sim_tp3, format.mintick),
                          style = label.style_label_left, color = color.new(i_col_buy, 50),
                          textcolor = i_col_text, size = size.small) : na

    // Persistent live-trade RR zone — pin left edge + capture STATIC
    // geometry (original entry / original SL / final-TP) at open. Width =
    // avg WINNING-trade hold converted to bars (fallback 8 bars / >=1 bar
    // clamp below). Replaces any prior live boxes (single displayed trade).
    if not na(live_rr_tp_box)
        box.delete(live_rr_tp_box)
        live_rr_tp_box := na
    if not na(live_rr_sl_box)
        box.delete(live_rr_sl_box)
        live_rr_sl_box := na
    live_rr_entry_bar := bar_index
    live_rr_entry_px  := sim_entry
    live_rr_sl_px     := sim_sl          // ORIGINAL SL (not sim_eff_sl)
    live_rr_tp_px     := final_tp_price
    // ms-per-bar from chart TF (guard div-by-zero); avg win hold → bars.
    live_rr_ms_bar  = timeframe.in_seconds() * 1000
    live_rr_avg_ms  = n_hold_wins > 0 ? hold_ms_wins / n_hold_wins : 0
    live_rr_w_raw   = (n_hold_wins > 0 and live_rr_ms_bar > 0) ?
       math.round(live_rr_avg_ms / live_rr_ms_bar) : 8
    live_rr_width   = math.max(1, live_rr_w_raw < 1 ? 8 : live_rr_w_raw)
    live_rr_right0  = live_rr_entry_bar + live_rr_width
    // P&L-aware tint at birth: a fresh entry is treated as positive (price
    // not yet adverse), so the reward box is born bright and the risk box
    // dim — same scheme the per-bar update below maintains. Avoids any flat
    // 75 leftover fighting the dynamic tint on the very first bar.
    live_rr_tp_c    = color.new(color.green, 60)
    live_rr_sl_c    = color.new(color.red,   88)
    if not na(live_rr_entry_px) and not na(live_rr_tp_px)
        live_rr_tp_box := box.new(live_rr_entry_bar, live_rr_tp_px, live_rr_right0, live_rr_entry_px,
                                  xloc      = xloc.bar_index,
                                  border_width = 0,
                                  bgcolor   = live_rr_tp_c)
    if not na(live_rr_entry_px) and not na(live_rr_sl_px)
        live_rr_sl_box := box.new(live_rr_entry_bar, live_rr_entry_px, live_rr_right0, live_rr_sl_px,
                                  xloc      = xloc.bar_index,
                                  border_width = 0,
                                  bgcolor   = live_rr_sl_c)

// Trail step (TP1→BE, TP2→TP1, TP3→TP2): freeze the current SL segment
// at this bar and start a new SL line at the trailed eff_sl level. This
// preserves the historical SL position (line.new is a single rigid
// segment — updating y on the existing line would retroactively move
// the whole historical segment).
if st.evt_trail_step > 0 and (sim_long or sim_short) and not na(ln_h_sl)
    line.set_x2(ln_h_sl, bar_index)
    trail_clr = st.evt_trail_step == 1 ? i_col_be : i_col_buy
    ln_h_sl := line.new(bar_index, sim_eff_sl, bar_index, sim_eff_sl,
                         color = trail_clr, width = 2)

// Active trade: extend horizontal lines + chips. Lines freeze when
// sim_long/sim_short flip false on close (this block stops running).
if (sim_long or sim_short) and not na(ln_h_sl)
    line.set_x2(ln_h_sl,  bar_index)
    line.set_x2(ln_h_tp1, bar_index)
    if not na(ln_h_tp2)
        line.set_x2(ln_h_tp2, bar_index)
    if not na(ln_h_tp3)
        line.set_x2(ln_h_tp3, bar_index)

if (sim_long or sim_short) and not na(lbl_sl)
    label.set_x(lbl_sl,  bar_index + i_lbl_off)
    label.set_x(lbl_tp1, bar_index + i_lbl_off)
    if not na(lbl_tp2)
        label.set_x(lbl_tp2, bar_index + i_lbl_off)
    if not na(lbl_tp3)
        label.set_x(lbl_tp3, bar_index + i_lbl_off)

// Live-trade RR zone: refresh the right edge each bar from the current
// avg-win-hold (top/bottom + left stay STATIC at the captured open values).
if (sim_long or sim_short) and (not na(live_rr_tp_box) or not na(live_rr_sl_box))
    a_ms_bar = timeframe.in_seconds() * 1000
    a_avg_ms = n_hold_wins > 0 ? hold_ms_wins / n_hold_wins : 0
    a_w_raw  = (n_hold_wins > 0 and a_ms_bar > 0) ?
       math.round(a_avg_ms / a_ms_bar) : 8
    a_width  = math.max(1, a_w_raw < 1 ? 8 : a_w_raw)
    a_right  = live_rr_entry_bar + a_width
    // P&L-aware tint: positive = price beyond entry in trade direction.
    // Winning side renders brighter (transp 60), losing side dimmer (88).
    live_pnl_pos = sim_long ? close > live_rr_entry_px : close < live_rr_entry_px
    a_tp_c   = live_pnl_pos ? color.new(color.green, 60) : color.new(color.green, 88)
    a_sl_c   = live_pnl_pos ? color.new(color.red,   88) : color.new(color.red,   60)
    if not na(live_rr_tp_box)
        box.set_lefttop(live_rr_tp_box, live_rr_entry_bar, live_rr_tp_px)
        box.set_rightbottom(live_rr_tp_box, a_right, live_rr_entry_px)
        box.set_bgcolor(live_rr_tp_box, a_tp_c)
    if not na(live_rr_sl_box)
        box.set_lefttop(live_rr_sl_box, live_rr_entry_bar, live_rr_entry_px)
        box.set_rightbottom(live_rr_sl_box, a_right, live_rr_sl_px)
        box.set_bgcolor(live_rr_sl_box, a_sl_c)

if (just_closed_long or just_closed_short) and not na(lbl_sl)
    label.set_x(lbl_sl,  bar_index)
    label.set_x(lbl_tp1, bar_index)
    if not na(lbl_tp2)
        label.set_x(lbl_tp2, bar_index)
    if not na(lbl_tp3)
        label.set_x(lbl_tp3, bar_index)

// Live-trade RR zone is a live-only aid — delete both boxes on close so
// they leave no historical residue (unlike the per-entry chips/lines).
if just_closed_long or just_closed_short
    if not na(live_rr_tp_box)
        box.delete(live_rr_tp_box)
        live_rr_tp_box := na
    if not na(live_rr_sl_box)
        box.delete(live_rr_sl_box)
        live_rr_sl_box := na

// SL chip retext on trail step (BE / TP1 / TP2)
if st.evt_trail_step == 1 and not na(lbl_sl)
    label.set_y(lbl_sl, sim_eff_sl)
    label.set_color(lbl_sl, color.new(i_col_be, 50))
    label.set_text(lbl_sl, "SL · BE " + str.tostring(sim_eff_sl, format.mintick))
if st.evt_trail_step == 2 and not na(lbl_sl)
    label.set_y(lbl_sl, sim_eff_sl)
    label.set_color(lbl_sl, color.new(i_col_buy, 50))
    label.set_text(lbl_sl, "SL · TP1 " + str.tostring(sim_eff_sl, format.mintick))
if st.evt_trail_step == 3 and not na(lbl_sl)
    label.set_y(lbl_sl, sim_eff_sl)
    label.set_color(lbl_sl, color.new(i_col_buy, 50))
    label.set_text(lbl_sl, "SL · TP2 " + str.tostring(sim_eff_sl, format.mintick))

plotshape(just_hit_tp1 and (sim_long or just_closed_long),  "TP1 Long",  shape.xcross, location.abovebar,
          color = i_col_buy,  text = "TP1", textcolor = i_col_text, size = size.tiny)
plotshape(just_hit_tp1 and (sim_short or just_closed_short), "TP1 Short", shape.xcross, location.belowbar,
          color = i_col_buy,  text = "TP1", textcolor = i_col_text, size = size.tiny)

plotshape(closed_by_tp_long,  "TP Long final",  shape.xcross, location.abovebar,
          color = i_col_buy,  text = "TP", textcolor = i_col_text, size = size.tiny)
plotshape(closed_by_tp_short, "TP Short final", shape.xcross, location.belowbar,
          color = i_col_buy,  text = "TP", textcolor = i_col_text, size = size.tiny)
plotshape(closed_by_sl_long,  "SL Long",   shape.circle, location.belowbar,
          color = i_col_sell, text = "SL",  textcolor = i_col_text, size = size.tiny)
plotshape(closed_by_sl_short, "SL Short",  shape.circle, location.abovebar,
          color = i_col_sell, text = "SL",  textcolor = i_col_text, size = size.tiny)

// Horizontal SL/TP lines are now drawn via line.new (block above), so no
// plot()-based series here. line.new doesn't connect between trades, so
// the multi-position stair-step is gone, and historical trades' levels
// stay visible as frozen line segments from entry to close.

// =====================================================================
// POTENTIAL ENTRY (WATCH) LINE + LABEL
// While the State is WATCH·BUY / WATCH·SELL, draw a single persistent
// dashed horizontal line + price chip at the level the engine is waiting
// for (OB edge ± Entry-proximity×ATR). Reuses ONE var line + ONE var
// label — created once, then repositioned on barstate.islast (no per-bar
// object spawn). Cleared (y set to na, off-chart) the moment the state
// leaves WATCH (becomes SETUP / IN-TRADE / READY) or the toggle is off,
// so no stale level lingers. Same right-extension + i_lbl_off chip idiom
// as the SL/TP drawings above.
// =====================================================================
var line  watch_line     = na
var label watch_lbl      = na
var line  watch_sl_line  = na
var label watch_sl_lbl   = na
var line  watch_tp1_line = na
var label watch_tp1_lbl  = na
var line  watch_tp2_line = na
var label watch_tp2_lbl  = na
// Position-tool RR boxes for the WATCH state — mirror the GET READY block's
// setup_rr_*_box pair but anchor on the watch_* projected levels instead of
// setup_*. A WATCH setup is already a valid signal (just awaiting the pullback
// to the OB), so it renders the same GREEN reward (entry→TP2) and RED risk
// (entry→SL) boxes at the normal (non-dim) 75 transparency. Dedicated handles
// (NOT setup_rr_*_box) — the two states are mutually exclusive but separate
// handles avoid any double-ownership / lifecycle bug.
var box watch_rr_tp_box = na
var box watch_rr_sl_box = na

if barstate.islast
    show_watch = i_show_watch and not na(watch_entry_px)
    if show_watch
        watch_clr  = color.blue
        watch_txt  = (watch_dir == 1 ? "WATCH BUY @ " : "WATCH SELL @ ") +
          str.tostring(watch_entry_px, format.mintick)
        if na(watch_line)
            watch_line := line.new(bar_index, watch_entry_px, bar_index + 10, watch_entry_px,
                                   color = watch_clr, style = line.style_dashed, width = 1,
                                   extend = extend.none)
        else
            line.set_xy1(watch_line, bar_index,      watch_entry_px)
            line.set_xy2(watch_line, bar_index + 10, watch_entry_px)
            line.set_extend(watch_line, extend.none)
            line.set_color(watch_line, watch_clr)
        if na(watch_lbl)
            watch_lbl := label.new(bar_index + 10, watch_entry_px, watch_txt,
                                   style = label.style_label_left,
                                   color = color.new(watch_clr, 50),
                                   textcolor = i_col_text, size = size.small)
        else
            label.set_xy(watch_lbl, bar_index + 10, watch_entry_px)
            label.set_text(watch_lbl, watch_txt)
            label.set_color(watch_lbl, color.new(watch_clr, 50))

        // -- Projected SL (red) --
        if not na(watch_sl_px)
            watch_sl_txt = "WATCH SL @ " + str.tostring(watch_sl_px, format.mintick)
            if na(watch_sl_line)
                watch_sl_line := line.new(bar_index, watch_sl_px, bar_index + 10, watch_sl_px,
                                          color = i_col_sell, style = line.style_dashed, width = 1,
                                          extend = extend.none)
            else
                line.set_xy1(watch_sl_line, bar_index,      watch_sl_px)
                line.set_xy2(watch_sl_line, bar_index + 10, watch_sl_px)
                line.set_extend(watch_sl_line, extend.none)
                line.set_color(watch_sl_line, i_col_sell)
            if na(watch_sl_lbl)
                watch_sl_lbl := label.new(bar_index + 10, watch_sl_px, watch_sl_txt,
                                          style = label.style_label_left,
                                          color = color.new(i_col_sell, 50),
                                          textcolor = i_col_text, size = size.small)
            else
                label.set_xy(watch_sl_lbl, bar_index + 10, watch_sl_px)
                label.set_text(watch_sl_lbl, watch_sl_txt)
                label.set_color(watch_sl_lbl, color.new(i_col_sell, 50))
        else
            if not na(watch_sl_line)
                line.set_xy1(watch_sl_line, bar_index, na)
                line.set_xy2(watch_sl_line, bar_index, na)
            if not na(watch_sl_lbl)
                label.set_xy(watch_sl_lbl, bar_index, na)
                label.set_text(watch_sl_lbl, "")

        // -- Projected TP1 (green) --
        if not na(watch_tp1_px)
            watch_tp1_txt = "WATCH TP1 @ " + str.tostring(watch_tp1_px, format.mintick)
            if na(watch_tp1_line)
                watch_tp1_line := line.new(bar_index, watch_tp1_px, bar_index + 10, watch_tp1_px,
                                           color = i_col_buy, style = line.style_dashed, width = 1,
                                           extend = extend.none)
            else
                line.set_xy1(watch_tp1_line, bar_index,      watch_tp1_px)
                line.set_xy2(watch_tp1_line, bar_index + 10, watch_tp1_px)
                line.set_extend(watch_tp1_line, extend.none)
                line.set_color(watch_tp1_line, i_col_buy)
            if na(watch_tp1_lbl)
                watch_tp1_lbl := label.new(bar_index + 10, watch_tp1_px, watch_tp1_txt,
                                           style = label.style_label_left,
                                           color = color.new(i_col_buy, 50),
                                           textcolor = i_col_text, size = size.small)
            else
                label.set_xy(watch_tp1_lbl, bar_index + 10, watch_tp1_px)
                label.set_text(watch_tp1_lbl, watch_tp1_txt)
                label.set_color(watch_tp1_lbl, color.new(i_col_buy, 50))
        else
            if not na(watch_tp1_line)
                line.set_xy1(watch_tp1_line, bar_index, na)
                line.set_xy2(watch_tp1_line, bar_index, na)
            if not na(watch_tp1_lbl)
                label.set_xy(watch_tp1_lbl, bar_index, na)
                label.set_text(watch_tp1_lbl, "")

        // -- Projected TP2 (green) --
        if not na(watch_tp2_px)
            watch_tp2_txt = "WATCH TP2 @ " + str.tostring(watch_tp2_px, format.mintick)
            if na(watch_tp2_line)
                watch_tp2_line := line.new(bar_index, watch_tp2_px, bar_index + 10, watch_tp2_px,
                                           color = i_col_buy, style = line.style_dashed, width = 1,
                                           extend = extend.none)
            else
                line.set_xy1(watch_tp2_line, bar_index,      watch_tp2_px)
                line.set_xy2(watch_tp2_line, bar_index + 10, watch_tp2_px)
                line.set_extend(watch_tp2_line, extend.none)
                line.set_color(watch_tp2_line, i_col_buy)
            if na(watch_tp2_lbl)
                watch_tp2_lbl := label.new(bar_index + 10, watch_tp2_px, watch_tp2_txt,
                                           style = label.style_label_left,
                                           color = color.new(i_col_buy, 50),
                                           textcolor = i_col_text, size = size.small)
            else
                label.set_xy(watch_tp2_lbl, bar_index + 10, watch_tp2_px)
                label.set_text(watch_tp2_lbl, watch_tp2_txt)
                label.set_color(watch_tp2_lbl, color.new(i_col_buy, 50))
        else
            if not na(watch_tp2_line)
                line.set_xy1(watch_tp2_line, bar_index, na)
                line.set_xy2(watch_tp2_line, bar_index, na)
            if not na(watch_tp2_lbl)
                label.set_xy(watch_tp2_lbl, bar_index, na)
                label.set_text(watch_tp2_lbl, "")

        // -- RR position-tool boxes (WATCH). Same idiom as the GET READY block's
        //    setup_rr_*_box, anchored on the watch_* projected levels. Span the
        //    current bar → +10 bars. GREEN reward (entry→TP2), RED risk (entry→SL).
        //    Drawn only when BOTH the entry level and the respective target are
        //    non-na; otherwise that box is cleared so no stale geometry lingers.
        //    Fixed 75 transparency (live pending setup — no HOLD/PRE-OPEN dim). --
        watch_rr_left  = bar_index
        watch_rr_right = bar_index + 10
        watch_rr_tp_c  = color.new(color.green, 75)
        watch_rr_sl_c  = color.new(color.red,   75)
        // Reward box: entry → TP2.
        if not na(watch_entry_px) and not na(watch_tp2_px)
            if na(watch_rr_tp_box)
                watch_rr_tp_box := box.new(watch_rr_left, watch_tp2_px, watch_rr_right, watch_entry_px,
                                           xloc      = xloc.bar_index,
                                           border_width = 0,
                                           bgcolor   = watch_rr_tp_c)
            else
                box.set_lefttop(watch_rr_tp_box, watch_rr_left, watch_tp2_px)
                box.set_rightbottom(watch_rr_tp_box, watch_rr_right, watch_entry_px)
                box.set_bgcolor(watch_rr_tp_box, watch_rr_tp_c)
        else if not na(watch_rr_tp_box)
            box.delete(watch_rr_tp_box)
            watch_rr_tp_box := na
        // Risk box: entry → SL.
        if not na(watch_entry_px) and not na(watch_sl_px)
            if na(watch_rr_sl_box)
                watch_rr_sl_box := box.new(watch_rr_left, watch_entry_px, watch_rr_right, watch_sl_px,
                                           xloc      = xloc.bar_index,
                                           border_width = 0,
                                           bgcolor   = watch_rr_sl_c)
            else
                box.set_lefttop(watch_rr_sl_box, watch_rr_left, watch_entry_px)
                box.set_rightbottom(watch_rr_sl_box, watch_rr_right, watch_sl_px)
                box.set_bgcolor(watch_rr_sl_box, watch_rr_sl_c)
        else if not na(watch_rr_sl_box)
            box.delete(watch_rr_sl_box)
            watch_rr_sl_box := na
    else
        // Not in WATCH (or toggle off): clear so no stale level lingers.
        if not na(watch_line)
            line.set_xy1(watch_line, bar_index, na)
            line.set_xy2(watch_line, bar_index, na)
        if not na(watch_lbl)
            label.set_xy(watch_lbl, bar_index, na)
            label.set_text(watch_lbl, "")
        if not na(watch_sl_line)
            line.set_xy1(watch_sl_line, bar_index, na)
            line.set_xy2(watch_sl_line, bar_index, na)
        if not na(watch_sl_lbl)
            label.set_xy(watch_sl_lbl, bar_index, na)
            label.set_text(watch_sl_lbl, "")
        if not na(watch_tp1_line)
            line.set_xy1(watch_tp1_line, bar_index, na)
            line.set_xy2(watch_tp1_line, bar_index, na)
        if not na(watch_tp1_lbl)
            label.set_xy(watch_tp1_lbl, bar_index, na)
            label.set_text(watch_tp1_lbl, "")
        if not na(watch_tp2_line)
            line.set_xy1(watch_tp2_line, bar_index, na)
            line.set_xy2(watch_tp2_line, bar_index, na)
        if not na(watch_tp2_lbl)
            label.set_xy(watch_tp2_lbl, bar_index, na)
            label.set_text(watch_tp2_lbl, "")
        // Delete the WATCH RR boxes so no stale geometry lingers off-WATCH.
        if not na(watch_rr_tp_box)
            box.delete(watch_rr_tp_box)
            watch_rr_tp_box := na
        if not na(watch_rr_sl_box)
            box.delete(watch_rr_sl_box)
            watch_rr_sl_box := na

// =====================================================================
// GET READY note (SETUP state) — ONE prominent live label at the right
// edge of the chart marking an IMMINENT signal. Binds to state_is_setup
// (the exact SETUP·BUY/SELL State-row condition, derived above), so it
// appears/updates precisely while the panel reads SETUP and is deleted
// the instant the state leaves SETUP (fired, faded, or a gate dropped).
// Single reusable var handle → only ever one such label on the chart, no
// orphan stacking. Rendered under barstate.islast only (a "right now"
// aid that tracks live price — NOT a historical SETUP marker). Projected
// entry / SL / TP2 reuse the watch_* levels; na parts degrade gracefully.
// =====================================================================
var label setup_note_lbl = na
// Position-tool RR boxes that accompany the GET READY label: a GREEN reward
// box (entry→TP2) and a RED risk box (entry→SL), spanning the current bar to
// ~8 bars right. Same lifecycle as the label — created/updated in the SETUP/
// ADD branch, deleted in the else. Display-only; each na-guarded so a missing
// projection simply skips that box.
var box setup_rr_tp_box = na
var box setup_rr_sl_box = na
if barstate.islast
    if i_show_setup_note and ready_visible
        // SHOW vs HOLD: ready_show = the live engine condition (price inside
        // 0.4 ATR). When false but ready_visible is true we are in HOLD — price
        // drifted out but within the release band and the setup is otherwise
        // alive. HOLD dims the bg and appends "(near)" to the headline.
        sn_hold   = not ready_show
        // PRE-OPEN sub-state: SHOW is live (ready_show true) but neither the
        // in-session SETUP nor ADD condition holds — it's the killzone-imminent
        // look-ahead. Direction comes from preopen_buy (state_setup_buy is false
        // out of session, so it can't be reused). Rendered dimmed like HOLD to
        // read as provisional, with a "(<Session> opens in Xm)" headline suffix.
        sn_preopen = ready_show and not state_is_setup and not add_is_ready
        // Two trigger sources share this label: the flat SETUP state and the
        // in-trade ADD-ready state. SETUP wins precedence if both somehow hold
        // (they are mutually exclusive in practice — SETUP needs active_count==0).
        // In HOLD both flags are false, so fall back to the still-alive candidate
        // direction (chk_cand_dir): +1 BUY, -1 SELL. ADD vs flat is preserved
        // from active_count (a live position ⇒ this would be an ADD).
        sn_is_add = sn_preopen ? false :
          sn_hold ? active_count > 0 : (not state_is_setup and add_is_ready)
        sn_buy    = sn_preopen ? preopen_buy :
          sn_hold ? (chk_cand_dir == 1) :
          (sn_is_add ? add_ready_buy : state_setup_buy)
        sn_core   = sn_is_add ?
          (sn_buy ? "⚡ GET READY — ADD BUY" : "⚡ GET READY — ADD SELL") :
          (sn_buy ? "⚡ GET READY — BUY" : "⚡ GET READY — SELL")
        // Pre-open suffix takes precedence over "(near)"; the two never coexist
        // (pre-open is out-of-session, HOLD requires chk_killzone in-session).
        sn_head   = sn_preopen ? sn_core + " (" + preopen_sess + " opens in " + str.tostring(preopen_mins_disp) + "m)" :
          sn_hold ? sn_core + " (near)" : sn_core
        // Projected entry/SL/TP2: prefer setup_* (the engine's own entry math,
        // populated whenever price is in proximity = exactly the SETUP state).
        // Fall back to watch_* so the line still renders if setup_* were ever
        // na. Both are projection-only; "~" conveys the live approximation.
        sn_entry_px = not na(setup_entry_px) ? setup_entry_px : watch_entry_px
        sn_sl_px    = not na(setup_sl_px)    ? setup_sl_px    : watch_sl_px
        sn_tp2_px   = not na(setup_tp2_px)   ? setup_tp2_px   : watch_tp2_px
        // Line 2: assemble only the projected pieces that are non-na.
        sn_parts = ""
        if not na(sn_entry_px)
            sn_parts := "entry ~" + str.tostring(sn_entry_px, format.mintick)
        if not na(sn_sl_px)
            sn_parts := sn_parts + (sn_parts == "" ? "" : " · ") +
              "SL " + str.tostring(sn_sl_px, format.mintick)
        if not na(sn_tp2_px)
            sn_parts := sn_parts + (sn_parts == "" ? "" : " · ") +
              "TP2 " + str.tostring(sn_tp2_px, format.mintick)
        sn_txt   = sn_parts == "" ? sn_head : sn_head + "\n" + sn_parts
        // Anchor at the right edge beside current price; arrow points at it.
        sn_x     = bar_index + 2
        sn_y     = na(sn_entry_px) ? close : sn_entry_px
        // HOLD and PRE-OPEN both dim the label bg (more transparent) so the
        // provisional state reads distinct from a live-now SETUP. color.new with
        // a fixed 55-transp on the accent; the live SHOW keeps the input color.
        sn_dim   = sn_hold or sn_preopen
        sn_bg    = sn_dim ? color.new(sn_buy ? i_col_buy : i_col_sell, 55) :
          (sn_buy ? i_col_buy : i_col_sell)
        sn_txtc  = sn_dim ? color.new(color.white, 25) : color.white
        sn_style = sn_buy ? label.style_label_lower_left : label.style_label_upper_left
        if na(setup_note_lbl)
            setup_note_lbl := label.new(sn_x, sn_y, sn_txt, xloc = xloc.bar_index,
                                        style = sn_style, color = sn_bg,
                                        textcolor = sn_txtc, size = size.large)
        else
            label.set_xy(setup_note_lbl, sn_x, sn_y)
            label.set_text(setup_note_lbl, sn_txt)
            label.set_color(setup_note_lbl, sn_bg)
            label.set_textcolor(setup_note_lbl, sn_txtc)
            label.set_style(setup_note_lbl, sn_style)
        // -- RR position-tool boxes. Span current bar → +8 bars. GREEN reward
        //    (entry→TP2), RED risk (entry→SL). Drawn only when BOTH the entry
        //    projection and the respective target are non-na; otherwise that
        //    box is cleared so no stale geometry lingers. --
        rr_left  = bar_index
        rr_right = bar_index + 8
        // HOLD/PRE-OPEN dim the RR fills to match the provisional label (88 vs 75).
        rr_tp_c  = color.new(color.green, sn_dim ? 88 : 75)
        rr_sl_c  = color.new(color.red,   sn_dim ? 88 : 75)
        // Reward box: entry → TP2.
        if not na(sn_entry_px) and not na(sn_tp2_px)
            if na(setup_rr_tp_box)
                setup_rr_tp_box := box.new(rr_left, sn_tp2_px, rr_right, sn_entry_px,
                                           xloc      = xloc.bar_index,
                                           border_width = 0,
                                           bgcolor   = rr_tp_c)
            else
                box.set_lefttop(setup_rr_tp_box, rr_left, sn_tp2_px)
                box.set_rightbottom(setup_rr_tp_box, rr_right, sn_entry_px)
                box.set_bgcolor(setup_rr_tp_box, rr_tp_c)
        else if not na(setup_rr_tp_box)
            box.delete(setup_rr_tp_box)
            setup_rr_tp_box := na
        // Risk box: entry → SL.
        if not na(sn_entry_px) and not na(sn_sl_px)
            if na(setup_rr_sl_box)
                setup_rr_sl_box := box.new(rr_left, sn_entry_px, rr_right, sn_sl_px,
                                           xloc      = xloc.bar_index,
                                           border_width = 0,
                                           bgcolor   = rr_sl_c)
            else
                box.set_lefttop(setup_rr_sl_box, rr_left, sn_entry_px)
                box.set_rightbottom(setup_rr_sl_box, rr_right, sn_sl_px)
                box.set_bgcolor(setup_rr_sl_box, rr_sl_c)
        else if not na(setup_rr_sl_box)
            box.delete(setup_rr_sl_box)
            setup_rr_sl_box := na
    else
        // HIDE: hysteresis released (distance > release, setup hard-died, or
        // toggle off). Delete label + RR boxes so no stale geometry lingers.
        if not na(setup_note_lbl)
            label.delete(setup_note_lbl)
            setup_note_lbl := na
        if not na(setup_rr_tp_box)
            box.delete(setup_rr_tp_box)
            setup_rr_tp_box := na
        if not na(setup_rr_sl_box)
            box.delete(setup_rr_sl_box)
            setup_rr_sl_box := na

// =====================================================================
// KILLZONE RENDERING — runs each chart bar, updates each enabled
// killzone's box for the current session. The update_kz method handles
// both new-session detection (creates a new box) and active-session
// extension (stretches box right + adjusts top/bottom to high/low).
// =====================================================================
for [_, kz] in killzones
    update_kz(kz)

// =====================================================================
// SMC VISUALS — LuxAlgo-style structure lines + BOS/CHoCH labels and
// order-block boxes, all driven by BG-computed levels surfaced above.
// Drawing style adapted from "Smart Money Concepts [LuxAlgo]" (© LuxAlgo,
// CC BY-NC-SA 4.0). No LuxAlgo detection logic — BG owns every level.
//
// Object budgeting: this indicator shares the 500-line / 500-label /
// 500-box caps across SL/TP lines, signal chips, and killzone boxes. The
// arrays below are pruned FIFO to their input keep-counts so the SMC
// visuals can never push the totals past the caps. The structure pieces
// only draw on confirmed bars (BG BOS events already fire on confirmed
// bars), so there is no realtime churn to repaint.
// =====================================================================
var array<line>  smc_lines  = array.new<line>()
var array<label> smc_labels = array.new<label>()
var array<box>   smc_boxes  = array.new<box>()
// Parallel bias array, index-aligned with smc_boxes: true = demand (bull
// OB), false = supply (bear OB). Pine has no box.get_bgcolor() getter, so
// each box's bias is stored explicitly here instead of being inferred from
// the fill color. INVARIANT: every push/shift/remove on smc_boxes must do
// the same op at the same index on smc_box_is_demand so they never desync.
var array<bool>  smc_box_is_demand = array.new<bool>()
// Parallel origin-bar array, index-aligned with smc_boxes: the bar_index at
// which each box's OB formed. Used by the "active-BOS only" filter to prune
// boxes once their originating BOS ages out (origin older than i_bos_age
// bars). INVARIANT: pushed/shifted/removed in lockstep with smc_boxes and
// smc_box_is_demand at all times.
var array<int>   smc_box_origin = array.new<int>()

// --- (A) Structure line + BOS/CHoCH label on each BG BOS event ---
if i_smc_on and i_smc_struct and (smc_bos_bull or smc_bos_bear) and not na(smc_bos_level) and not na(smc_bos_from)
    is_bull   = smc_bos_bull
    struc_clr = is_bull ? i_smc_col_bull : i_smc_col_bear
    tag       = smc_choch ? "CHoCH" : "BOS"
    // Solid horizontal line at the broken swing, from the swing's bar to
    // the break bar (LuxAlgo structure-line style).
    ln = line.new(smc_bos_from, smc_bos_level, bar_index, smc_bos_level,
                  color = struc_clr, style = line.style_solid, width = 1)
    // Label at the horizontal midpoint; bull anchored above (label_down),
    // bear below (label_up) — mirrors LuxAlgo.
    mid = math.round(0.5 * (smc_bos_from + bar_index))
    lb = label.new(mid, smc_bos_level, tag,
                   xloc      = xloc.bar_index,
                   color     = color(na),
                   textcolor = struc_clr,
                   style     = is_bull ? label.style_label_down : label.style_label_up,
                   size      = size.small)
    array.push(smc_lines,  ln)
    array.push(smc_labels, lb)
    // Prune oldest beyond the keep-counts (FIFO) to stay under the caps.
    while array.size(smc_lines) > i_smc_keep_ln
        line.delete(array.shift(smc_lines))
    while array.size(smc_labels) > i_smc_keep_lbl
        label.delete(array.shift(smc_labels))

// --- (B) Order-block box from BG's OB, mitigation-aware ---
// New OB → push a right-extending tinted box. Each bar, check open boxes
// for mitigation (price trading back through the zone) and delete them,
// mirroring LuxAlgo's deleteOrderBlocks. Stored top/bottom are encoded in
// the box itself; demand vs supply is stored in smc_box_is_demand at the
// same index (Pine has no box bgcolor getter).
if i_smc_on and i_smc_obbox and smc_ob_new and not na(smc_ob_from) and not na(smc_ob_high) and not na(smc_ob_low)
    // -- Noise filters (gate DRAWING only; never touch signal/sim math) --
    // (1) Direction filter: keep only demand / supply / both per input.
    dir_ok = i_smc_ob_dir == "Both" or
      (i_smc_ob_dir == "Demand only" and smc_ob_demand) or
      (i_smc_ob_dir == "Supply only" and not smc_ob_demand)
    // (2) HTF-bias-aligned: demand only when H1 bull, supply only when H1 bear.
    bias_ok = not i_smc_ob_bias_only or
      (smc_ob_demand and h1_bull) or (not smc_ob_demand and h1_bear)
    // (3) Min size (× ATR at formation): skip boxes shorter than the floor.
    ob_height = smc_ob_high - smc_ob_low
    size_ok = i_smc_ob_min_atr <= 0 or na(smc_ob_atr) or
      ob_height >= i_smc_ob_min_atr * smc_ob_atr
    if dir_ok and bias_ok and size_ok
        ob_clr = color.new(smc_ob_demand ? i_smc_col_bull : i_smc_col_bear, i_smc_ob_trans)
        // (4) Right-extension cap: 0 = stretch right (current behavior); >0 =
        //     fixed right edge N bars from origin so old boxes don't span the
        //     chart. Mitigation can still delete the box early.
        use_extend = i_smc_ob_extend_bars <= 0
        right_x    = use_extend ? bar_index : smc_ob_from + i_smc_ob_extend_bars
        bx = box.new(smc_ob_from, smc_ob_high, right_x, smc_ob_low,
                     border_color = ob_clr,
                     bgcolor      = ob_clr,
                     extend       = use_extend ? extend.right : extend.none)
        array.push(smc_boxes, bx)
        array.push(smc_box_is_demand, smc_ob_demand)   // lockstep with smc_boxes
        array.push(smc_box_origin, smc_ob_from)        // lockstep: origin bar
        while array.size(smc_boxes) > i_smc_keep_box
            box.delete(array.shift(smc_boxes))
            array.shift(smc_box_is_demand)             // prune all three FIFO
            array.shift(smc_box_origin)                // together, same index

// Mitigation sweep: delete a box once price closes back through its zone.
// Demand (bull) OB is mitigated when close < its low; supply (bear) OB
// when close > its high. Demand vs supply is read from the parallel
// smc_box_is_demand array at the same index. Iterate newest-first for safe
// in-place removal.
if i_smc_on and i_smc_obbox and array.size(smc_boxes) > 0
    for bi = array.size(smc_boxes) - 1 to 0
        b      = array.get(smc_boxes, bi)
        is_dem = array.get(smc_box_is_demand, bi)
        origin = array.get(smc_box_origin, bi)
        top    = box.get_top(b)
        bot    = box.get_bottom(b)
        mitigated = is_dem ? close < bot : close > top
        // Active-BOS-only filter: also drop the box once its originating BOS
        // has aged out (origin older than the BOS-age window).
        aged_out = i_smc_ob_active_only and (bar_index - origin) > i_bos_age
        if mitigated or aged_out
            box.delete(b)
            array.remove(smc_boxes, bi)
            array.remove(smc_box_is_demand, bi)    // keep all three index-
            array.remove(smc_box_origin, bi)       // aligned on every removal

// --- (C) USED-OB recolor: an OB that produced a trade turns BLUE for life ---
// When the engine opens a sim trade, it surfaces that trade's OB origin bar
// (evt_open_ob_bar). Here we find the matching surviving box by its origin bar
// (smc_box_origin, lockstep with smc_boxes) and recolor it blue — fill + border
// switch from teal/red to color.blue at the SAME transparency the box already
// carried. One-shot on the open event; the box then stays blue for the rest of
// its life (mitigation / FIFO eviction unchanged). Marks "used" OBs at a glance
// and is the visual for the SAME-OB rule (the engine won't re-enter from a box
// once it has traded). Display-only — no detection logic, no per-bar respawn.
// Both directions: a bull OB used by a BUY and a bear OB used by a SELL both
// turn blue. Primary match is by origin bar; if no box carries that origin (it
// was already FIFO-evicted or never drawn under the noise filters) nothing is
// recolored, which is correct.
if i_smc_on and i_smc_obbox and (just_opened_long or just_opened_short) and not na(just_opened_ob_bar) and array.size(smc_boxes) > 0
    for bi = 0 to array.size(smc_boxes) - 1
        if array.get(smc_box_origin, bi) == just_opened_ob_bar
            b = array.get(smc_boxes, bi)
            // Reuse the box's existing fill transparency so only the hue changes.
            box.set_bgcolor(b,     color.new(color.blue, i_smc_ob_trans))
            box.set_border_color(b, color.new(color.blue, i_smc_ob_trans))
            break

// =====================================================================
// STATUS TABLE
// =====================================================================
pos_lookup(string s) =>
    switch s
        "top_left"     => position.top_left
        "top_right"    => position.top_right
        "middle_left"  => position.middle_left
        "middle_right" => position.middle_right
        "bottom_left"  => position.bottom_left
        => position.bottom_right

// =====================================================================
// TWO SIDE-BY-SIDE label|value PAIRS (5 columns):
//   cols 0-1 = LEFT pair  (the "now" stuff): SETUP, LIVE TRADE,
//              TODAY, STREAKS.
//   col  2   = thin transparent SPACER between the pairs.
//   cols 3-4 = RIGHT pair (the "sim results"): PERFORMANCE, SESSIONS(+DoW).
// Each pair carries its OWN amber band headers (header spans only that
// pair's 2 cells, never all 5 columns).
//
// Row budget per pair — worst case (all toggles ON):
//   LEFT  : SETUP hdr+4 (absolute 0..4), then the ENTIRE remaining left pair
//           runs on counter rL (starts at 5) so the variable-height LIVE TRADE
//           block (flat checklist vs in-trade rows) never collides with TODAY /
//           STREAKS / the bias sub-bands below it.
//           LIVE TRADE — FLAT (active_count==0): hdr + Bias + 10 fixed checklist
//             rows + up to 2 g_risk rows (day-cap / day-loss)        = 1+1+12 = 14
//           LIVE TRADE — IN-TRADE: hdr + Bias + Bias(now) + Dir + Entry#1..3
//             (up to 3, one per active slot) + SL/TP1/final (3) +
//             (multi-pos) Add/Last skip (2)            = 1+1+1+1+3+3+2 = 12
//           TODAY  hdr+3 = 4 · STREAKS hdr+3 = 4
//           + (i_show_sess) SESSION BIAS hdr+3 = 4 +
//             ENTRY BIAS SPLIT hdr + up to 3 rows/session = 1+9      = 10
//           → flat worst case (14 > in-trade 12): 5 + 14 + 4 + 4 + 4 + 10 = 41.
//           → in-trade worst case: 5 + 12 + 4 + 4 + 4 + 10 = 39. Flat still
//             dominates the LEFT pair at 41 rows (ends row 40).
//   RIGHT : PERFORMANCE hdr+15 (0..15; +1 = Win TP1→BE→TP2 sub-slice) +
//           SESSIONS hdr+entries(3)+paths(8)+holds(2)+same(1)+overnight(1)
//           (16..31) + DoW(5) (32..36)                            = 37 rows
//   table height = max(41, 37) = 41 → dims 44 for headroom (LIVE TRADE band
//   grew by up to 2 rows when Entry split into per-slot Entry#1..3). The LEFT
//   pair below SETUP advances by the LEFT running counter rL; SESSIONS/DoW on
//   the RIGHT by rR. Independent counters ⇒ no toggle combo (flat/in-trade ×
//   i_max_pos × g_risk rows × i_show_sess × i_show_dow) collides.
//   table.clear wipes the full 5×44 span each render.
var table tbl = table.new(pos_lookup(i_tbl_pos), 5, 44,
                          bgcolor      = color.new(color.black, 20),
                          border_color = color.new(color.gray, 50),
                          border_width = 1,
                          frame_color  = color.new(color.gray, 50),
                          frame_width  = 1)

// LEFT pair lives in cols 0-1, RIGHT pair in cols 3-4. The f_cell pair-arg
// is the LOCAL column (0 = label, 1 = value); callers pass a base offset.
// _base = 0 → left pair, _base = 3 → right pair.
f_cell(int _row, int _col, string _txt, color _clr, int _base = 0) =>
    table.cell(tbl, _base + _col, _row, _txt, text_color=_clr, text_size=size.small, text_halign=text.align_left)

// Section-header row: amber group name across the pair's label cell with a
// subtle tinted background; the pair's value cell mirrors the tint to keep
// the band continuous. The header spans ONLY this pair (2 cells), not all 5
// columns. _base selects the pair (0 = left, 3 = right). Display-only.
f_hdr(int _row, string _txt, int _base = 0) =>
    hdr_bg = color.new(#ffd54f, 88)
    table.cell(tbl, _base + 0, _row, _txt, text_color=color.new(#ffd54f, 0), text_size=size.small, text_halign=text.align_left, bgcolor=hdr_bg)
    table.cell(tbl, _base + 1, _row, "",   bgcolor=hdr_bg)

// Pre-entry checklist row (LEFT pair). _state: 1 = pass (green ✓), -1 = fail
// (red ✗), 0 = not evaluable (gray —). _detail is appended after the glyph.
// Display-only — surfaces compute_sig_state's gate snapshot.
f_chk(int _row, string _label, int _state, string _detail) =>
    glyph = _state == 1 ? "✓ " : _state == -1 ? "✗ " : "— "
    clr   = _state == 1 ? color.lime : _state == -1 ? color.new(#ef5350, 0) : color.gray
    table.cell(tbl, 0, _row, _label, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, _row, glyph + _detail, text_color=clr, text_size=size.small, text_halign=text.align_left)

// Duration formatter: int ms → "Xd Yh" (>=24h) else "Xh Ym". CRITICAL —
// Pine `/` on two ints returns FLOAT (no int-division operator), so every
// division step is math.floor'd back to a true int before str.tostring,
// otherwise raw floats leak (decimals + thousands separator). `%` on
// (int,int) IS int. Single source of truth for the Avg Hold rows.
f_dur(int _ms) =>
    int total_min  = int(math.floor(_ms / 60000.0))   // whole minutes
    int hold_h_tot = int(math.floor(total_min / 60.0))// whole hours
    int hold_m_rem = total_min % 60                    // int % int → int
    int hold_days  = int(math.floor(hold_h_tot / 24.0))
    int hold_h_rem = hold_h_tot % 24                   // int % int → int
    hold_h_tot >= 24 ? str.tostring(hold_days) + "d " + str.tostring(hold_h_rem) + "h" :
      str.tostring(hold_h_tot) + "h " + str.tostring(hold_m_rem) + "m"

// Lot multiplier: rescales the raw-points $ accumulators (sim_total_usd,
// day_usd_now, max_dd_pts) into account dollars at DISPLAY time only.
// Default 0.01 lot × 100 = 1.0 → reproduces the original raw-points figures.
usd_mult = i_lot * i_contract

// Closed-trade count + net (spread-adjusted) figures, derived only — the
// gross sim_total_r / sim_total_usd are never altered. With i_spread = 0,
// sum_spread_r = 0 and the spread $ deduction is 0, so every Net figure
// equals its Gross counterpart exactly.
closed_count    = sim_wins + sim_losses
net_total_r     = sim_total_r - sum_spread_r
net_total_usd_pts = sim_total_usd - (closed_count * i_spread)
net_total_usd   = net_total_usd_pts * usd_mult

if i_show_tbl and barstate.islast
    table.clear(tbl, 0, 0, 4, 41)

    state_str = switch
        active_count > 0          => "IN-TRADE × " + str.tostring(active_count)
        not in_date_range         => "DATE-OUT"
        not in_session            => "OFF-SESS"
        not cooldown_ok           => "COOLDOWN"
        i_max_day_loss_r > 0 and day_r_now <= -i_max_day_loss_r => "DAY-STOP"
        i_max_day_trades > 0 and day_opens_now >= i_max_day_trades => "DAY-MAX"
        bull_setup                => "SETUP · BUY"
        bear_setup                => "SETUP · SELL"
        bull_forming              => "WATCH · BUY"
        bear_forming              => "WATCH · SELL"
        =>                           "READY"
    state_clr = switch
        active_count > 0             => color.new(#ffd54f, 0)
        not in_date_range            => color.gray
        not in_session               => color.gray
        i_max_day_loss_r > 0 and day_r_now <= -i_max_day_loss_r => color.gray
        i_max_day_trades > 0 and day_opens_now >= i_max_day_trades => color.gray
        bull_setup or bear_setup     => color.lime
        bull_forming or bear_forming => color.new(#ffd54f, 0)
        not cooldown_ok              => color.gray
        =>                              color.silver

    // -- OFF-SESS countdown to next session open (display-only, last bar) --
    // When idle off-session and sessions are filtered, scan the ENABLED
    // killzones for the earliest future start that also passes that session's
    // weekday filter, and append a d/h/m countdown. Runs only here (under
    // barstate.islast), so the ≤40-iteration scan is once-per-render, never
    // per-bar. Session START times are read in i_kz_tz; the candidate's
    // weekday is evaluated in Asia/Manila to mirror the engine's bar_dow.
    if not in_session and i_use_sessions and
      (i_use_asia or i_use_london or i_use_nyam or i_use_nypm or i_use_nylu)
        nowMs = timenow
        baseY = year(timenow,       i_kz_tz)
        baseM = month(timenow,      i_kz_tz)
        baseD = dayofmonth(timenow, i_kz_tz)
        float bestMs = na
        // Per enabled session: [startHH, startMM, allowed-weekday array (Sun..Sat)].
        for si = 0 to 4
            bool   en   = false
            string sess = ""
            array<bool> dowArr = na
            if si == 0 and i_use_asia
                en     := true
                sess   := i_asia_sess
                dowArr := array.from(i_asia_dow_sun, i_asia_dow_mon, i_asia_dow_tue, i_asia_dow_wed, i_asia_dow_thu, i_asia_dow_fri, i_asia_dow_sat)
            else if si == 1 and i_use_london
                en     := true
                sess   := i_london_sess
                dowArr := array.from(i_london_dow_sun, i_london_dow_mon, i_london_dow_tue, i_london_dow_wed, i_london_dow_thu, i_london_dow_fri, i_london_dow_sat)
            else if si == 2 and i_use_nyam
                en     := true
                sess   := i_nyam_sess
                dowArr := array.from(i_nyam_dow_sun, i_nyam_dow_mon, i_nyam_dow_tue, i_nyam_dow_wed, i_nyam_dow_thu, i_nyam_dow_fri, i_nyam_dow_sat)
            else if si == 3 and i_use_nylu
                en     := true
                sess   := i_nylu_sess
                dowArr := array.from(i_nylu_dow_sun, i_nylu_dow_mon, i_nylu_dow_tue, i_nylu_dow_wed, i_nylu_dow_thu, i_nylu_dow_fri, i_nylu_dow_sat)
            else if si == 4 and i_use_nypm
                en     := true
                sess   := i_nypm_sess
                dowArr := array.from(i_nypm_dow_sun, i_nypm_dow_mon, i_nypm_dow_tue, i_nypm_dow_wed, i_nypm_dow_thu, i_nypm_dow_fri, i_nypm_dow_sat)
            if en
                hh = math.round(str.tonumber(str.substring(sess, 0, 2)))
                mm = math.round(str.tonumber(str.substring(sess, 2, 4)))
                for d = 0 to 7
                    cand = timestamp(i_kz_tz, baseY, baseM, baseD, hh, mm) + d * 86400000
                    if cand > nowMs
                        cdow = dayofweek(cand, "Asia/Manila")
                        if array.get(dowArr, cdow - 1) and (na(bestMs) or cand < bestMs)
                            bestMs := cand
        if not na(bestMs)
            rem   = bestMs - nowMs
            days  = math.floor(rem / 86400000)
            hours = math.floor((rem % 86400000) / 3600000)
            mins  = math.floor((rem % 3600000) / 60000)
            countdown = str.tostring(days) + "d " +
              (hours < 10 ? "0" : "") + str.tostring(hours) + "h " +
              (mins  < 10 ? "0" : "") + str.tostring(mins)  + "m"
            state_str := "OFF-SESS " + countdown

    // =================================================================
    // Panel layout — TWO side-by-side pairs:
    //   LEFT pair  (cols 0-1): SETUP/IDENTITY · LIVE TRADE · TODAY · STREAKS
    //   RIGHT pair (cols 3-4): PERFORMANCE · SESSIONS(+DoW)
    //   col 2 = transparent spacer (never written).
    // Left fixed rows use absolute indices (SETUP 0 … TODAY 18); STREAKS on
    // the left uses running counter rL. Right uses absolute indices for
    // PERFORMANCE (0..15); SESSIONS/DoW use running counter rR. Conditional
    // groups (live-trade rows, multi-pos diagnostics) leave their rows blank
    // when idle (table.clear wipes stale text each render). Headers are
    // tinted bands spanning only their own pair.
    // =================================================================

    // -- SETUP / IDENTITY (LEFT pair) ---------------------------------
    f_hdr(0, "SETUP")

    f_cell(1, 0, "State",     color.white)
    f_cell(1, 1, state_str,   state_clr)

    // -- FAILSAFE: effective entry-proximity can't fire. minval=0.1 clamps the
    //    input on apply, but a legacy saved-state or hand-edited value <= 0
    //    would silently make near_bull/near_bear impossible (price can never be
    //    within 0 ATR of the OB) — wiping every sim trade. Loud red override on
    //    the State row's two cells; renders ONLY when tripped, so zero cost
    //    in the normal case. Spans the SETUP band's top data row. --
    if i_entry_atr <= 0
        table.cell(tbl, 0, 1, "⚠", text_color=color.white, text_size=size.small, text_halign=text.align_center, bgcolor=color.new(color.red, 0))
        table.cell(tbl, 1, 1, "ENTRY PROXIMITY 0 — NO TRADES CAN FIRE", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(color.red, 0))

    symbol_line = syminfo.ticker + " " + timeframe.period + " · " + session_now
    f_cell(2, 0, "Symbol",    color.white)
    f_cell(2, 1, symbol_line, color.white)

    f_cell(3, 0, "Slots",     color.white)
    f_cell(3, 1, str.tostring(active_count) + " / " + str.tostring(i_max_pos),
                  active_count >= i_max_pos ? color.orange : color.silver)

    // Sim Range — first → last in-range bar the sim actually evaluated.
    sim_range_str = na(sim_first_time) or na(sim_last_time) ? "—" :
      str.format_time(sim_first_time, "yyyy-MM-dd", "Asia/Manila") + " → " +
      str.format_time(sim_last_time,  "yyyy-MM-dd", "Asia/Manila")
    f_cell(4, 0, "Sim Range", color.white)
    f_cell(4, 1, sim_range_str, color.silver)

    // -- LIVE TRADE ---------------------------------------------------
    // The whole LEFT pair below SETUP advances on the running counter rL so
    // the variable-height LIVE TRADE block (flat checklist vs in-trade rows)
    // never collides with TODAY / STREAKS / the bias sub-bands below it.
    int rL = 5
    f_hdr(rL, "LIVE TRADE")
    rL += 1

    // Bias rows: when in trade, show the bias captured AT TRADE ENTRY
    // (the value the gate actually evaluated to allow the trade) AND the
    // CURRENT live bias (so a mid-trade flip is visible). When flat, the
    // entry row shows the current bias and the "now" row is omitted.
    bias_to_show = active_count > 0 ? bias_at_open : h1_bias_s
    bias_color = bias_to_show == "bullish" ? color.lime :
      bias_to_show == "bearish" ? color.red : color.silver
    f_cell(rL, 0, active_count > 0 ? "Bias @ entry" : "Bias", color.white)
    f_cell(rL, 1, bias_to_show, bias_color)
    rL += 1

    if active_count > 0
        // -- IN-TRADE view (unchanged content) -------------------------
        bias_now_color = h1_bias_s == "bullish" ? color.lime :
          h1_bias_s == "bearish" ? color.red : color.silver
        f_cell(rL, 0, "Bias (now)", color.white)
        f_cell(rL, 1, h1_bias_s, bias_now_color)
        rL += 1

        sl_tag = sim_eff_sl_r >= 2.0 ? " (TP2)" :
          sim_eff_sl_r >= 1.0 ? " (TP1)" :
          sim_eff_sl_r >= 0.0 ? " (BE)"  : ""
        f_cell(rL, 0, "Dir (latest)", color.white)
        f_cell(rL, 1, sim_long ? "BUY" : "SELL", sim_long ? color.lime : color.red)
        rL += 1
        // One "Entry #N" row per active slot (#1 = oldest open order). Value =
        // "<entry> · <live hold>", hold = now (last-bar time) − open_time via
        // f_dur. Up to 3 rows; each guarded so na slots / na times don't render.
        // Emitted on the running rL so 1-3 rows fit without collisions.
        for si = 0 to 2
            float se = si == 0 ? slot1_entry : si == 1 ? slot2_entry : slot3_entry
            int   so = si == 0 ? slot1_opentm : si == 1 ? slot2_opentm : slot3_opentm
            if not na(se)
                hold_txt = (not na(so) and not na(time) and time >= so) ?
                  " · " + f_dur(time - so) : ""
                f_cell(rL, 0, "Entry #" + str.tostring(si + 1), color.white)
                f_cell(rL, 1, str.tostring(se, format.mintick) + hold_txt, color.white)
                rL += 1
        f_cell(rL, 0, "SL" + sl_tag, color.white)
        f_cell(rL, 1, str.tostring(sim_eff_sl, format.mintick),
                       sim_eff_sl_r >= 0 ? i_col_be : color.red)
        rL += 1
        f_cell(rL, 0, "TP1" + (sim_tp1_done ? " ✓" : ""), color.white)
        f_cell(rL, 1, str.tostring(sim_tp1, format.mintick), sim_tp1_done ? color.gray : color.lime)
        rL += 1
        f_cell(rL, 0, final_tp_lbl + " (final)", color.white)
        f_cell(rL, 1, str.tostring(final_tp_price, format.mintick), color.lime)
        rL += 1

        // Diagnostic row — only in multi-position mode (don't clutter 1-pos).
        // "Add #N" = live reason the NEXT (Nth) entry is/isn't firing this bar.
        if i_max_pos > 1
            add_live_clr = add_reason_s == "READY (will fire)" ? color.lime :
              add_reason_s == "" ? color.gray : color.orange
            f_cell(rL, 0, "Add #" + str.tostring(active_count + 1), color.white)
            f_cell(rL, 1, add_reason_s == "" ? "—" : add_reason_s, add_live_clr)
            rL += 1
    else
        // -- FLAT view: PRE-ENTRY CHECKLIST. Each row surfaces the engine's
        //    own gate evaluation on the last CONFIRMED bar for the CANDIDATE
        //    direction (active BOS dir). ✓ pass / ✗ fail / — not evaluable.
        //    No conditions are recomputed here — all read from SigState. ----
        // Setup / candidate direction.
        cand_txt = chk_cand_dir == 1 ? "BUY (bull BOS)" :
          chk_cand_dir == -1 ? "SELL (bear BOS)" : "no BOS"
        f_chk(rL, "Setup", chk_cand_dir == 0 ? 0 : 1, cand_txt)
        rL += 1

        // Killzone — session window + DoW result the engine gates on.
        f_chk(rL, "Killzone", chk_killzone ? 1 : -1,
          chk_killzone ? session_now : "closed")
        rL += 1

        // HTF bias — candidate-direction agreement.
        htf_detail = chk_cand_dir == 0 ? "—" :
          chk_htf_ok ? h1_bias_s + " ok" : "conflicts (" + h1_bias_s + ")"
        f_chk(rL, "HTF bias", chk_cand_dir == 0 ? 0 : (chk_htf_ok ? 1 : -1), htf_detail)
        rL += 1

        // BOS active — candidate dir + age in bars.
        bos_detail = chk_cand_dir == 0 ? "—" :
          (chk_cand_dir == 1 ? "bull" : "bear") +
          (na(chk_bos_age) ? "" : " · " + str.tostring(chk_bos_age) + " bars")
        f_chk(rL, "BOS active", chk_bos_active ? 1 : 0, bos_detail)
        rL += 1

        // OB anchored — for the candidate dir, with the watched edge price.
        ob_detail = chk_cand_dir == 0 ? "—" :
          chk_ob ? (na(chk_ob_edge) ? "yes" : str.tostring(chk_ob_edge, format.mintick)) :
          "none"
        f_chk(rL, "OB anchored", chk_cand_dir == 0 ? 0 : (chk_ob ? 1 : -1), ob_detail)
        rL += 1

        // Price @ OB — distance from the OB edge in ATR (1 decimal).
        dist_txt = na(chk_dist_atr) ? "" : str.tostring(chk_dist_atr, "0.0") + " ATR"
        atob_detail = not chk_ob ? "—" :
          chk_price_at_ob ? (dist_txt == "" ? "at edge" : dist_txt) :
          (dist_txt == "" ? "away" : dist_txt + " away")
        f_chk(rL, "Price @ OB", not chk_ob ? 0 : (chk_price_at_ob ? 1 : -1), atob_detail)
        rL += 1

        // Cooldown — clear, or bars remaining.
        cool_detail = chk_cooldown ? "clear" :
          str.tostring(chk_cool_left) + (chk_cool_left == 1 ? " bar left" : " bars left")
        f_chk(rL, "Cooldown", chk_cooldown ? 1 : -1, cool_detail)
        rL += 1

        // Min-SL — natural OB SL distance ($) vs i_min_sl_flt filter.
        minsl_dist_txt = "$" + str.tostring(chk_minsl_dist, "0.0")
        minsl_detail = not chk_ob ? "—" :
          chk_minsl_ok ? minsl_dist_txt :
          minsl_dist_txt + " < $" + str.tostring(i_min_sl_flt, "0.#")
        f_chk(rL, "Min-SL", not chk_ob ? 0 : (chk_minsl_ok ? 1 : -1), minsl_detail)
        rL += 1

        // Slot — capacity for a new position.
        slot_detail = str.tostring(active_count) + "/" + str.tostring(i_max_pos)
        f_chk(rL, "Slot", chk_slot_free ? 1 : -1, slot_detail)
        rL += 1

        // Fresh OB — candidate OB not already traded. Only meaningful with an OB.
        f_chk(rL, "Fresh OB", not chk_ob ? 0 : (chk_fresh_ob ? 1 : -1),
          not chk_ob ? "—" : chk_fresh_ob ? "new" : "same OB traded")
        rL += 1

        // g_risk gates — render ONLY when the corresponding input is enabled.
        if i_max_day_trades > 0
            f_chk(rL, "Day cap", chk_day_trades_ok ? 1 : -1,
              str.tostring(chk_day_opens) + "/" + str.tostring(i_max_day_trades))
            rL += 1
        if i_max_day_loss_r > 0
            f_chk(rL, "Day loss", chk_day_loss_ok ? 1 : -1,
              str.tostring(day_r_now, "0.0") + "/-" + str.tostring(i_max_day_loss_r, "0.#") + "R")
            rL += 1

    // -- TODAY --------------------------------------------------------
    f_hdr(rL, "TODAY")
    rL += 1

    // Day — merged trades + WR into one row. day_wr reuses the SAME formula
    // and "0.0" format as the old "Day WR" row; the "—"/0.0% guard at zero
    // trades is preserved inside the merged string.
    day_wr = day_count_now > 0 ? day_wins_now * 100.0 / day_count_now : 0.0
    day_wr_str = day_count_now > 0 ? str.tostring(day_wr, "0.0") + "%" : "—"
    f_cell(rL, 0, "Day", color.white)
    f_cell(rL, 1, str.tostring(day_count_now) + " (" + str.tostring(day_wins_now) +
                  "W/" + str.tostring(day_losses_now) + "L · " + day_wr_str + ")",
                  day_count_now > 0 ? color.white : color.gray)
    rL += 1

    f_cell(rL, 0, "Day R (PHT)", color.white)
    f_cell(rL, 1, str.tostring(day_r_now, "+0.00") + "R",
                  day_r_now >= 0 ? color.lime : color.red)
    rL += 1

    day_usd_disp = day_usd_now * usd_mult
    f_cell(rL, 0, "Day $ (PHT)", color.white)
    f_cell(rL, 1, (day_usd_disp >= 0 ? "+" : "") + str.tostring(day_usd_disp, "#.##"),
                  day_usd_disp >= 0 ? i_col_buy : i_col_sell)
    rL += 1

    // -- PERFORMANCE (sim totals) — RIGHT pair (cols 3-4), rows 0..15 -----
    f_hdr(0, "PERFORMANCE", 3)

    // Trades — merged count + win-rate into one row (mirrors the "Day" row
    // style). wr reuses the SAME formula/format/zero-guard as the old row.
    wr = sim_wins + sim_losses > 0 ? sim_wins * 100.0 / (sim_wins + sim_losses) : 0.0
    wr_str = str.tostring(wr, "0.0") + "%"
    f_cell(1, 0, "Trades", color.white, 3)
    f_cell(1, 1, str.tostring(sim_count) + " (" + str.tostring(sim_wins) +
                  "W/" + str.tostring(sim_losses) + "L · " + wr_str + ")", color.white, 3)

    // Avg Trades/Day = total sim trades ÷ distinct PHT weekdays with ≥1
    // in-range bar (num_trading_days, attributed on each trade's OPEN day —
    // same clock as the Day counter). Avg Trades/Week = daily × 5.
    avg_td_day  = num_trading_days > 0 ? sim_count / num_trading_days : 0.0
    avg_td_week = avg_td_day * 5.0
    f_cell(2, 0, "Avg Trades/Day", color.white, 3)
    f_cell(2, 1, num_trading_days > 0 ? str.tostring(avg_td_day, "0.0") : "—",
                  num_trading_days > 0 ? color.silver : color.gray, 3)
    f_cell(3, 0, "Avg Trades/Week", color.white, 3)
    f_cell(3, 1, num_trading_days > 0 ? str.tostring(avg_td_week, "0.0") : "—",
                  num_trading_days > 0 ? color.silver : color.gray, 3)

    // Total R — single R total, the NET (spread-adjusted) figure. With
    // i_spread = 0, net == gross. Sign/format/color mirror the old cell.
    f_cell(4, 0, "Total R", color.white, 3)
    f_cell(4, 1, str.tostring(net_total_r, "+0.00") + "R",
                  net_total_r >= 0 ? color.lime : color.red, 3)

    // Total $ — NET (spread-adjusted) × lot multiplier. With i_spread = 0,
    // net == gross. Format/color mirror the old Net $ / Total $ cell.
    f_cell(5, 0, "Total $", color.white, 3)
    f_cell(5, 1, (net_total_usd >= 0 ? "+" : "") + str.tostring(net_total_usd, "#.##"),
                  net_total_usd >= 0 ? i_col_buy : i_col_sell, 3)

    // Lots — the basis for every $ figure above/below. Shows the lot size and
    // the $/point it implies (usd_mult = i_lot × i_contract), so a viewer can
    // see Total $ / Day $ / Max DD $ all scale linearly with this. Display-only.
    f_cell(6, 0, "Lots", color.white, 3)
    f_cell(6, 1, str.tostring(i_lot) + "  (" + str.tostring(usd_mult, "0.00") + " $/pt)", color.silver, 3)

    expectancy_r  = closed_count > 0 ? net_total_r / closed_count : 0.0
    profit_factor = gross_loss_r > 0 ? gross_win_r / gross_loss_r : na

    f_cell(7, 0, "Expectancy R", color.white, 3)
    f_cell(7, 1, str.tostring(expectancy_r, "+0.00") + "R",
                  expectancy_r > 0 ? color.lime : color.red, 3)

    pf_str = na(profit_factor) ? (gross_win_r > 0 ? "∞" : "—") : str.tostring(profit_factor, "0.00")
    pf_clr = na(profit_factor) ? (gross_win_r > 0 ? color.lime : color.silver) :
      profit_factor > 1 ? color.lime : color.red
    f_cell(8, 0, "Profit Factor", color.white, 3)
    f_cell(8, 1, pf_str, pf_clr, 3)

    // Max DD $ — worst realized peak-to-trough decline of the cumulative
    // equity curve, in account dollars (raw points × lot multiplier).
    // Shown as a negative magnitude (a loss). Default lot reproduces raw pts.
    max_dd_disp = max_dd_pts * usd_mult
    f_cell(9, 0, "Max DD $", color.white, 3)
    f_cell(9, 1, "-" + str.tostring(max_dd_disp, "#.##"), i_col_sell, 3)

    // -- Outcome anatomy: how closed trades resolve, as RATES (% of closed
    //    trades), waterfall best→worst. n_win_tp2 + n_loss_near +
    //    n_loss_aftertp1 + n_loss_straight == closed_count by construction, so
    //    the four percentages sum to 100%. "—" gray until ≥1 close. A trailed-
    //    SL win is counted in the WIN bucket (parity with the Trades W/L row).
    pct_den   = closed_count > 0 ? closed_count : 1   // avoid /0; gated by guard
    has_close = closed_count > 0
    win_pct      = n_win_tp2         * 100.0 / pct_den
    near_pct     = n_loss_near       * 100.0 / pct_den
    aftertp1_pct = n_loss_aftertp1   * 100.0 / pct_den
    straight_pct = n_loss_straight   * 100.0 / pct_den

    f_cell(10, 0, "Win — hit TP2", color.white, 3)
    f_cell(10, 1, has_close ? str.tostring(win_pct, "0.0") + "% · " +
                    str.tostring(n_win_tp2) + "/" + str.tostring(closed_count) : "—",
                  has_close ? color.lime : color.gray, 3)
    // CONDITIONAL survival rate: of the trades that hit TP1 then dipped back
    // to BE, how many still finished at TP2. Numerator = n_win_tp1_be_tp2
    // (TP1→BE→TP2 wins). Denominator = those wins + every loss whose MFE
    // reached TP1 (>=1R): both MFE>=1R loss buckets (after-TP1 + near-TP2).
    // A near-TP2 loss also crossed BE on the way to SL (SL sits beyond BE), so
    // each such loss dipped through BE by definition — qualifies for the base.
    // Display-only; reuses existing counters. Teal; "—" gray when base == 0.
    be_tp2_base = n_win_tp1_be_tp2 + n_loss_aftertp1 + n_loss_near
    be_tp2_odds = be_tp2_base > 0 ? n_win_tp1_be_tp2 * 100.0 / be_tp2_base : 0.0
    f_cell(11, 0, "TP1→BE → TP2 odds", color.white, 3)
    f_cell(11, 1, be_tp2_base > 0 ?
                    str.tostring(be_tp2_odds, "0") + "% · " +
                    str.tostring(n_win_tp1_be_tp2) + "/" + str.tostring(be_tp2_base) : "—",
                  be_tp2_base > 0 ? i_col_be : color.gray, 3)
    f_cell(12, 0, "Loss — near TP2", color.white, 3)
    f_cell(12, 1, has_close ? str.tostring(near_pct, "0.0") + "% · " +
                    str.tostring(n_loss_near) + "/" + str.tostring(closed_count) : "—",
                  has_close ? color.orange : color.gray, 3)
    f_cell(13, 0, "Loss — after TP1", color.white, 3)
    f_cell(13, 1, has_close ? str.tostring(aftertp1_pct, "0.0") + "% · " +
                    str.tostring(n_loss_aftertp1) + "/" + str.tostring(closed_count) : "—",
                  has_close ? color.red : color.gray, 3)
    f_cell(14, 0, "Loss — straight to SL", color.white, 3)
    f_cell(14, 1, has_close ? str.tostring(straight_pct, "0.0") + "% · " +
                    str.tostring(n_loss_straight) + "/" + str.tostring(closed_count) : "—",
                  has_close ? color.red : color.gray, 3)

    // Avg hold = Σ(close − open) ÷ closed trades. f_dur handles int-division
    // flooring + the d/h vs h/m format. avg_hold_ms floored once here too.
    int avg_hold_ms = has_close ? int(math.floor(sum_hold_ms / closed_count)) : 0
    hold_str = not has_close ? "—" : f_dur(avg_hold_ms)
    f_cell(15, 0, "Avg Hold / Trade", color.white, 3)
    f_cell(15, 1, hold_str, has_close ? color.silver : color.gray, 3)

    // =================================================================
    // RIGHT-pair RUNNING ROW INDEX. PERFORMANCE ends at fixed row 15
    // (cols 3-4) — one row longer now the Win row carries the TP1→BE→TP2
    // sub-slice. The SESSIONS band (i_show_sess) and its DoW sub-rows
    // (i_show_dow) are CONDITIONAL, so a fixed mapping would collide. From
    // row 16 on we use counter `rR` that advances exactly once per emitted
    // RIGHT-pair row, independent of the LEFT pair's `rL`. table.clear
    // (above) wipes the full span each render, so hidden rows never
    // show stale text.
    // =================================================================
    int rR = 16

    // -- SESSIONS (display-only; entire band hidden when i_show_sess off) ---
    if i_show_sess
        f_hdr(rR, "SESSIONS", 3)
        rR += 1

        // Entry quality — share of all closed trades · WR among them, per
        // bucket. "—" (gray) for a bucket with 0 closed entries. den_close
        // is the closed-trade denominator (>=1 guard). buckets 0/1/2 =
        // Asia/London/NY.
        int den_close = closed_count > 0 ? closed_count : 1
        f_eq_label = array.from("Asia entries", "London entries", "NY entries")
        for bi = 0 to 2
            int e_n = array.get(ent_by_bucket, bi)
            int e_w = array.get(ent_wins_by_bucket, bi)
            string e_txt = e_n == 0 ? "—" :
              str.tostring(e_n * 100.0 / den_close, "0") + "% · " +
              str.tostring(e_w * 100.0 / e_n, "0") + "% W"
            f_cell(rR, 0, array.get(f_eq_label, bi), color.white, 3)
            f_cell(rR, 1, e_txt, e_n == 0 ? color.gray : color.silver, 3)
            rR += 1

        // Resolution paths — share of ALL closed trades · W% within the path.
        // 8 paths; their n sums to closed_count by construction. "—" for an
        // empty path. Labels index-aligned with path_n/path_w 0..7.
        f_path_label = array.from(
          "Asia → in Asia", "Asia → in London", "Asia → later/off",
          "London → in London", "London → in NY", "London → later/off",
          "NY → in NY", "NY → later/off")
        for pi = 0 to 7
            int p_n = array.get(sess_path_n, pi)
            int p_w = array.get(sess_path_w, pi)
            string p_txt = p_n == 0 ? "—" :
              str.tostring(p_n * 100.0 / den_close, "0") + "% · " +
              str.tostring(p_w * 100.0 / p_n, "0") + "% W"
            f_cell(rR, 0, array.get(f_path_label, pi), color.white, 3)
            f_cell(rR, 1, p_txt, p_n == 0 ? color.gray : color.silver, 3)
            rR += 1

        // Timing — avg hold split by win/loss (f_dur), same-session-close
        // rate, overnight-carry rate. Hold rows floor the mean once via f_dur.
        bool has_w = n_hold_wins > 0
        bool has_l = n_hold_losses > 0
        f_cell(rR, 0, "Avg Hold — wins", color.white, 3)
        f_cell(rR, 1, has_w ? f_dur(int(math.floor(hold_ms_wins / n_hold_wins))) : "—",
                      has_w ? color.silver : color.gray, 3)
        rR += 1
        f_cell(rR, 0, "Avg Hold — losses", color.white, 3)
        f_cell(rR, 1, has_l ? f_dur(int(math.floor(hold_ms_losses / n_hold_losses))) : "—",
                      has_l ? color.silver : color.gray, 3)
        rR += 1

        string same_txt = closed_count == 0 ? "—" :
          str.tostring(n_same_sess_close * 100.0 / den_close, "0") + "%"
        f_cell(rR, 0, "Same-session close", color.white, 3)
        f_cell(rR, 1, same_txt, closed_count == 0 ? color.gray : color.silver, 3)
        rR += 1
        string on_txt = closed_count == 0 ? "—" :
          str.tostring(n_overnight * 100.0 / den_close, "0") + "%"
        f_cell(rR, 0, "Overnight carry", color.white, 3)
        f_cell(rR, 1, on_txt, closed_count == 0 ? color.gray : color.silver, 3)
        rR += 1

        // Day-of-week WR (ENTRY day, PHT) — 5 Mon..Fri rows, opt-in. Hidden
        // (no rows consumed) when i_show_dow off. "12W/9L · 57%" per day.
        if i_show_dow
            f_dow_label = array.from("Mon", "Tue", "Wed", "Thu", "Fri")
            for di = 0 to 4
                int d_w = array.get(sess_dow_w, di)
                int d_l = array.get(sess_dow_l, di)
                int d_t = d_w + d_l
                string d_txt = d_t == 0 ? "—" :
                  str.tostring(d_w) + "W/" + str.tostring(d_l) + "L · " +
                  str.tostring(d_w * 100.0 / d_t, "0") + "%"
                f_cell(rR, 0, array.get(f_dow_label, di), color.white, 3)
                f_cell(rR, 1, d_txt, d_t == 0 ? color.gray : color.silver, 3)
                rR += 1

    // -- STREAKS — LEFT pair (cols 0-1). Continues the SAME LEFT running
    //    counter rL the LIVE TRADE + TODAY blocks advanced (rL is already
    //    positioned at the next free left row). Independent of the RIGHT
    //    pair's rR. In the flat checklist worst case the left ends ~row 40
    //    — still inside the 42-row table; in-trade it ends much higher up. -
    f_hdr(rL, "STREAKS", 0)
    rL += 1

    f_cell(rL, 0, "Max Consec W", color.white, 0)
    f_cell(rL, 1, str.tostring(max_win_streak), color.silver, 0)
    rL += 1
    f_cell(rL, 0, "Max Consec L", color.white, 0)
    f_cell(rL, 1, str.tostring(max_loss_streak), color.silver, 0)
    rL += 1
    // Current streak — NBA-style "W5" / "L3" of the active run. At most one of
    // cur_win/cur_loss is non-zero (the other is reset on each close), so the
    // non-zero one IS the live streak; "—" when no trades have resolved.
    streak_txt = cur_win_streak > 0 ? "W" + str.tostring(cur_win_streak) :
      cur_loss_streak > 0 ? "L" + str.tostring(cur_loss_streak) : "—"
    streak_clr = cur_win_streak > 0 ? i_col_buy :
      cur_loss_streak > 0 ? i_col_sell : color.gray
    f_cell(rL, 0, "Streak", color.white, 0)
    f_cell(rL, 1, streak_txt, streak_clr, 0)
    rL += 1

    // -- SESSION BIAS + ENTRY BIAS SPLIT — LEFT pair, below STREAKS, advanced
    //    by the SAME left running counter rL. Whole block behind i_show_sess
    //    (parity with the RIGHT SESSIONS band). Moved to the LEFT so the right
    //    pair doesn't grow past ~36 rows. ----------------------------------
    if i_show_sess
        // ===== SESSION BIAS (3 rows): bias climate per session. =====
        f_hdr(rL, "SESSION BIAS", 0)
        rL += 1
        f_sb_label = array.from("Asia", "London", "NY")
        for bi = 0 to 2
            int sbu = array.get(sb_bull,  bi)
            int sbd = array.get(sb_bear,  bi)
            int sbr = array.get(sb_range, bi)
            int sb_tot = sbu + sbd + sbr
            string sb_txt = ""
            color  sb_clr = color.gray
            if sb_tot == 0
                sb_txt := "—"
            else
                // Two-way directional read. flat-majority (>=55% of all bars)
                // reads as chop; otherwise it's a bull-vs-bear race and the pct
                // is the winner's share of DIRECTIONAL bars only (flat excluded).
                // side codes: 0=bull, 1=bear, 2=flat.
                float fr_flat_share = sbr * 1.0 / sb_tot
                int fr_dir = sbu + sbd
                int fr_side_c = na
                int fr_pct = na
                if fr_flat_share >= 0.55 or fr_dir == 0
                    fr_side_c := 2
                    fr_pct := int(math.round(fr_flat_share * 100.0))
                else
                    fr_side_c := sbu >= sbd ? 0 : 1
                    int fr_win = fr_side_c == 0 ? sbu : sbd
                    fr_pct := int(math.round(fr_win * 100.0 / fr_dir))
                string fr_side = fr_side_c == 0 ? "bull" : fr_side_c == 1 ? "bear" : "flat"
                sb_clr := fr_side_c == 0 ? color.lime : fr_side_c == 1 ? color.red : color.gray
                // Magnitude label from the rendered share.
                string fr_lab = fr_pct >= 90 ? "Overwhelming" :
                  fr_pct >= 70 ? "Mostly" :
                  fr_pct >= 55 ? "Leaning" : "Mixed"
                string fr_word = fr_side_c == 0 ? "bullish" : fr_side_c == 1 ? "bearish" : "flat"
                // 10d part: only when ≥1 weekday queued. Same two-way rule,
                // its own flat check.
                int s10u = array.get(sb10_bull,  bi)
                int s10d = array.get(sb10_bear,  bi)
                int s10r = array.get(sb10_range, bi)
                int s10_tot = s10u + s10d + s10r
                if sb10_days == 0 or s10_tot == 0
                    // No 10d data yet — full-range only.
                    sb_txt := fr_lab + " " + fr_word +
                      " · " + str.tostring(fr_pct) + "% (10d: —)"
                else
                    float t10_flat_share = s10r * 1.0 / s10_tot
                    int t10_dir = s10u + s10d
                    int t10_side_c = na
                    int t10_pct = na
                    if t10_flat_share >= 0.55 or t10_dir == 0
                        t10_side_c := 2
                        t10_pct := int(math.round(t10_flat_share * 100.0))
                    else
                        t10_side_c := s10u >= s10d ? 0 : 1
                        int t10_win = t10_side_c == 0 ? s10u : s10d
                        t10_pct := int(math.round(t10_win * 100.0 / t10_dir))
                    string t10_side = t10_side_c == 0 ? "bull" : t10_side_c == 1 ? "bear" : "flat"
                    if t10_side_c == fr_side_c
                        // Same side — compact form.
                        sb_txt := fr_lab + " " + fr_word +
                          " · " + str.tostring(fr_pct) + "% (10d: " + str.tostring(t10_pct) + "%)"
                    else
                        // Sides diverge — name each explicitly.
                        sb_txt := fr_lab + " · " + str.tostring(fr_pct) + "% " + fr_side +
                          " (10d: " + str.tostring(t10_pct) + "% " + t10_side + ")"
            f_cell(rL, 0, array.get(f_sb_label, bi), color.white, 0)
            f_cell(rL, 1, sb_txt, sb_clr, 0)
            rL += 1

        // ===== ENTRY BIAS SPLIT (6+ rows): closed entries by bias state. =====
        // Per session: a "w/ bias" row (MATCHED) and an "in range" row, each
        // "<share>% · <WR>% W" of that session's closed entries. A COUNTER row
        // ("counter-tr") is emitted ONLY when its count > 0 (gate-off case).
        f_hdr(rL, "ENTRY BIAS SPLIT", 0)
        rL += 1
        f_ebs_label = array.from("Asia", "London", "NY")
        for bi = 0 to 2
            int em  = array.get(ebs_match,    bi)
            int emw = array.get(ebs_match_w,  bi)
            int er  = array.get(ebs_range,    bi)
            int erw = array.get(ebs_range_w,  bi)
            int ec  = array.get(ebs_counter,  bi)
            int ecw = array.get(ebs_counter_w, bi)
            int ebs_tot = em + er + ec
            string lab = array.get(f_ebs_label, bi)
            // w/ bias (MATCHED)
            string m_txt = ebs_tot == 0 ? "—" :
              str.tostring(int(math.round(em * 100.0 / ebs_tot))) + "% · " +
              (em == 0 ? "0" : str.tostring(int(math.round(emw * 100.0 / em)))) + "% W"
            f_cell(rL, 0, lab + " — w/ bias", color.white, 0)
            f_cell(rL, 1, m_txt, ebs_tot == 0 ? color.gray : color.silver, 0)
            rL += 1
            // in range
            string r_txt = ebs_tot == 0 ? "—" :
              str.tostring(int(math.round(er * 100.0 / ebs_tot))) + "% · " +
              (er == 0 ? "0" : str.tostring(int(math.round(erw * 100.0 / er)))) + "% W"
            f_cell(rL, 0, lab + " — in range", color.white, 0)
            f_cell(rL, 1, r_txt, ebs_tot == 0 ? color.gray : color.silver, 0)
            rL += 1
            // counter-trend — only when present (gate was off at some entry).
            if ec > 0
                string c_txt = str.tostring(int(math.round(ec * 100.0 / ebs_tot))) + "% · " +
                  str.tostring(int(math.round(ecw * 100.0 / ec))) + "% W"
                f_cell(rL, 0, lab + " — counter", color.white, 0)
                f_cell(rL, 1, c_txt, color.orange, 0)
                rL += 1

// =====================================================================
// TUNING SUGGESTIONS PANEL
// Live comparison of your current settings vs the suggested values for
// the chosen Signal TF. Three columns: param name | suggested | your
// current value (orange when they differ, gray ✓ when they match).
// Updates whenever the Signal TF input changes.
// =====================================================================
var table sug_tbl = table.new(pos_lookup(i_sug_pos), 3, 14,
                              bgcolor      = color.new(color.black, 20),
                              border_color = color.new(color.gray, 50),
                              border_width = 1,
                              frame_color  = color.new(color.gray, 50),
                              frame_width  = 1)

f_sug_hdr(int _r, string _name, string _sug_v, string _cur_v) =>
    table.cell(sug_tbl, 0, _r, _name,   text_color=color.new(#ffd54f, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(sug_tbl, 1, _r, _sug_v,  text_color=color.new(#ffd54f, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(sug_tbl, 2, _r, _cur_v,  text_color=color.new(#ffd54f, 0), text_size=size.small, text_halign=text.align_left)

f_sug_row(int _r, string _name, string _sug_v, string _cur_v, bool _match) =>
    table.cell(sug_tbl, 0, _r, _name, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(sug_tbl, 1, _r, _sug_v, text_color=color.lime, text_size=size.small, text_halign=text.align_left)
    table.cell(sug_tbl, 2, _r, _cur_v + (_match ? "  ✓" : ""),
                                       text_color=_match ? color.gray : color.orange,
                                       text_size=size.small, text_halign=text.align_left)

// Float comparison tolerance — Pine floats from input can drift slightly.
float_eq(float _a, float _b) => math.abs(_a - _b) < 0.005

if i_show_sug and barstate.islast
    table.clear(sug_tbl, 0, 0, 2, 13)
    Suggestions sug = get_suggestions(timeframe.period)

    sug_tf_label = "SUGGESTED · " + timeframe.period
    f_sug_hdr(0, sug_tf_label, "sug", "you")

    // -- Structure Detection --
    f_sug_row(1,  "Swing strength",   str.tostring(sug.swing_len),
                                       str.tostring(i_swing_len),  i_swing_len == sug.swing_len)
    f_sug_row(2,  "Max BOS age",      str.tostring(sug.bos_age),
                                       str.tostring(i_bos_age),    i_bos_age == sug.bos_age)
    f_sug_row(3,  "Max OB lookback",  str.tostring(sug.ob_age),
                                       str.tostring(i_ob_age),     i_ob_age == sug.ob_age)
    f_sug_row(4,  "Entry × ATR",      str.tostring(sug.entry_atr, "0.0"),
                                       str.tostring(i_entry_atr, "0.0"), float_eq(i_entry_atr, sug.entry_atr))
    f_sug_row(5,  "ATR period",       str.tostring(sug.atr_per),
                                       str.tostring(i_atr_per),    i_atr_per == sug.atr_per)
    f_sug_row(6,  "SL buf × ATR",     str.tostring(sug.sl_buf, "0.00"),
                                       str.tostring(i_sl_buf, "0.00"), float_eq(i_sl_buf, sug.sl_buf))
    f_sug_row(7,  "Min SL clamp $",   str.tostring(sug.min_sl, "0.0"),
                                       str.tostring(i_min_sl, "0.0"),  float_eq(i_min_sl, sug.min_sl))
    f_sug_row(8,  "Min SL filter $",  str.tostring(sug.min_sl_flt, "0.0"),
                                       str.tostring(i_min_sl_flt, "0.0"), float_eq(i_min_sl_flt, sug.min_sl_flt))
    // -- HTF Bias --
    f_sug_row(9,  "HTF timeframe",    sug.htf_tf,
                                       i_h1_tf,                    i_h1_tf == sug.htf_tf)
    f_sug_row(10, "HTF fast EMA",     str.tostring(sug.h1_fast),
                                       str.tostring(i_h1_fast),    i_h1_fast == sug.h1_fast)
    f_sug_row(11, "HTF slow EMA",     str.tostring(sug.h1_slow),
                                       str.tostring(i_h1_slow),    i_h1_slow == sug.h1_slow)
    // -- Simulated Trades --
    f_sug_row(12, "Cooldown bars",    str.tostring(sug.cooldown),
                                       str.tostring(i_cooldown),   i_cooldown == sug.cooldown)
    f_sug_row(13, "Max positions",    str.tostring(sug.max_pos),
                                       str.tostring(i_max_pos),    i_max_pos == sug.max_pos)

// =====================================================================
// SESSION / WEEKDAY R BREAKDOWN PANEL
// Data-driven attribution of realized R + trade count to the session and
// the weekday each trade OPENED in (buckets accrued in compute_sig_state
// at the SAME close branches as sim_total_r). Σ(weekday R) == gross Total
// R always; Σ(session R) == gross Total R whenever every trade opened
// inside a killzone (off-session opens carry a session idx of -1 and land
// in no session bucket). Opt-in (default OFF). 3 cols: label | R | n.
// =====================================================================
var table bd_tbl = table.new(pos_lookup(i_bd_pos), 3, 16,
                             bgcolor      = color.new(color.black, 20),
                             border_color = color.new(color.gray, 50),
                             border_width = 1,
                             frame_color  = color.new(color.gray, 50),
                             frame_width  = 1)

f_bd_hdr(int _r, string _c0, string _c1, string _c2) =>
    table.cell(bd_tbl, 0, _r, _c0, text_color=color.new(#ffd54f, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(bd_tbl, 1, _r, _c1, text_color=color.new(#ffd54f, 0), text_size=size.small, text_halign=text.align_right)
    table.cell(bd_tbl, 2, _r, _c2, text_color=color.new(#ffd54f, 0), text_size=size.small, text_halign=text.align_right)

f_bd_row(int _r, string _name, float _rval, int _n) =>
    table.cell(bd_tbl, 0, _r, _name, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(bd_tbl, 1, _r, str.tostring(_rval, "+0.00") + "R",
                              text_color = _n == 0 ? color.gray : _rval >= 0 ? color.lime : color.red,
                              text_size=size.small, text_halign=text.align_right)
    table.cell(bd_tbl, 2, _r, str.tostring(_n),
                              text_color = _n == 0 ? color.gray : color.silver,
                              text_size=size.small, text_halign=text.align_right)

if i_show_breakdown and barstate.islast
    table.clear(bd_tbl, 0, 0, 2, 15)

    // -- Session section (index 0..4 = Asia/London/NYAM/NYLU/NYPM) --
    f_bd_hdr(0, "BY SESSION", "R", "n")
    f_bd_row(1, "Asia",     array.get(r_by_sess, 0), array.get(n_by_sess, 0))
    f_bd_row(2, "London",   array.get(r_by_sess, 1), array.get(n_by_sess, 1))
    f_bd_row(3, "NY AM",    array.get(r_by_sess, 2), array.get(n_by_sess, 2))
    f_bd_row(4, "NY Lunch", array.get(r_by_sess, 3), array.get(n_by_sess, 3))
    f_bd_row(5, "NY PM",    array.get(r_by_sess, 4), array.get(n_by_sess, 4))

    // -- Weekday section (slot 0..6 = Mon..Sun; dayofweek 1..7 = Sun..Sat
    //    mapped via slot = (dow + 5) % 7) --
    f_bd_hdr(7, "BY WEEKDAY", "R", "n")
    f_bd_row(8,  "Mon", array.get(r_by_dow, 0), array.get(n_by_dow, 0))
    f_bd_row(9,  "Tue", array.get(r_by_dow, 1), array.get(n_by_dow, 1))
    f_bd_row(10, "Wed", array.get(r_by_dow, 2), array.get(n_by_dow, 2))
    f_bd_row(11, "Thu", array.get(r_by_dow, 3), array.get(n_by_dow, 3))
    f_bd_row(12, "Fri", array.get(r_by_dow, 4), array.get(n_by_dow, 4))
    f_bd_row(13, "Sat", array.get(r_by_dow, 5), array.get(n_by_dow, 5))
    f_bd_row(14, "Sun", array.get(r_by_dow, 6), array.get(n_by_dow, 6))

// =====================================================================
// ALERTS
// =====================================================================
new_bull_forming = bull_forming and not bull_forming[1]
new_bear_forming = bear_forming and not bear_forming[1]
alertcondition(new_bull_forming, "BG BUY watch",  "BG Golden:BUY setup forming (waiting for retrace)")
alertcondition(new_bear_forming, "BG SELL watch", "BG Golden:SELL setup forming (waiting for retrace)")
alertcondition(bull_setup, "BG BUY setup",  "BG Golden:BUY setup detected")
alertcondition(bear_setup, "BG SELL setup", "BG Golden:SELL setup detected")
alertcondition(just_opened_long,  "Sim LONG opened",  "BG Golden:simulated LONG entry")
alertcondition(just_opened_short, "Sim SHORT opened", "BG Golden:simulated SHORT entry")
alertcondition(just_hit_tp1,      "TP1 hit",          "BG Golden:TP1 filled")
alertcondition(just_hit_tp2,      "TP2 hit",          "BG Golden:TP2 filled")
alertcondition(just_hit_tp3,      "TP3 hit",          "BG Golden:TP3 filled")
alertcondition(just_closed_long or just_closed_short, "Trade closed", "BG Golden:trade closed")

// =====================================================================
// DATA WINDOW PLOTS
// =====================================================================
plot(active_count, "Active count", color=color.new(color.white, 100), display=display.data_window)
plot(sim_total_r,  "Total Return", color=color.new(color.white, 100), display=display.data_window)
plot(day_r_now,    "Day R",        color=color.new(color.white, 100), display=display.data_window)
